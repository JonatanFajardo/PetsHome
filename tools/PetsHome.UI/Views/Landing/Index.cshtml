<div class="card-badge badge-inprogress"><i class="fa-solid fa-clock"></i> En proceso</div>
</div>
<div class="card-body">
<div class="d-flex justify-content-between align-items-start mb-1">
<h5 class="mb-0" style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;">Luna</h5>
<span class="animal-species-tag tag-cat">Gata</span>
</div>
<div class="animal-meta">
<span><i class="fa-regular fa-calendar"></i> 1 año</span>
<span><i class="fa-solid fa-ruler-vertical"></i> Pequeña</span>
<span class="meta-check"><i class="fa-solid fa-circle-check"></i> Esterilizada</span>
</div>

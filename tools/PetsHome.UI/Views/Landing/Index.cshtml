</div>
<div class="card-body">
<div class="d-flex justify-content-between align-items-start mb-1">
<h5 class="mb-0" style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;">Simba</h5>
<span class="animal-species-tag tag-cat">Gato</span>
</div>
<div class="animal-meta">
<span><i class="fa-regular fa-calendar"></i> 4 años</span>
<span><i class="fa-solid fa-ruler-vertical"></i> Grande</span>
<span class="meta-check"><i class="fa-solid fa-circle-check"></i> Esterilizado</span>
</div>
<p class="animal-desc">Rey del sofá. Busca a alguien que aprecie la calma.</p>
</div>
<div class="card-cta-wrap">
<button class="btn-card-cta">Conocer a Simba <i class="fa-solid fa-arrow-right ml-1"></i></button>
</div>
</div>
</div>
<!-- Rocky -->
<div class="col-sm-6 col-lg-4 mb-4 reveal reveal-d1 animal-col" data-type="dog large young">
<div class="animal-card">

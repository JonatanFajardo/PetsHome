<div class="animal-card">
<div class="card-img-wrap">
<img alt="Coco" src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=600&amp;h=420&amp;fit=crop&amp;crop=top"/>
<div class="card-badge badge-available"><span class="badge-dot"></span> Disponible</div>
</div>
<div class="card-body">
<div class="d-flex justify-content-between align-items-start mb-1">

<i class="fa-solid fa-paw mr-2"></i> Ver todos los animales
      </button>
</div>
</div>
</section>
<!-- ══════════════════════════════════════════
     PROCESO
══════════════════════════════════════════ -->
<section class="proceso-section py-5" id="proceso" style="padding-top:5rem!important;padding-bottom:5rem!important;">
<div class="container">
<div class="text-center mb-5 reveal">
<span class="section-eyebrow">Proceso</span>
<h2 class="section-title mb-3">Adoptar es más fácil<br/>de lo que piensas</h2>
<p class="section-sub mx-auto" style="max-width:480px;">Cuatro pasos simples para cambiar tu vida y la de un animal.</p>
</div>
<div class="step-wrap">
<!-- Connector line (desktop) -->
<div class="step-connector" id="step-connector">
<div class="step-connector-fill" id="step-fill"></div>
</div>
<div class="row justify-content-center">
<div class="col-6 col-lg-3 mb-4 mb-lg-0 reveal">
<div class="step-card">
<div class="step-icon-wrap" style="background:#EDE9FE;">
<i class="fa-solid fa-magnifying-glass" style="color:var(--ph-primary);"></i>
<div class="step-number">1</div>
</div>
<div class="step-title">Explora</div>
<p class="step-desc">Navega los perfiles y encuentra el animal que conecte contigo.</p>
</div>
</div>
<div class="col-6 col-lg-3 mb-4 mb-lg-0 reveal reveal-d1">
<div class="step-card">
<div class="step-icon-wrap" style="background:#DBEAFE;">
<i class="fa-solid fa-file-lines" style="color:#3B82F6;"></i>
<div class="step-number">2</div>
</div>
<div class="step-title">Solicita</div>
<p class="step-desc">Llena el formulario de solicitud de adopción. Rápido y gratuito.</p>
</div>
</div>
<div class="col-6 col-lg-3 reveal reveal-d2">
<div class="step-card">
<div class="step-icon-wrap" style="background:#F3E8FF;">
<i class="fa-solid fa-handshake" style="color:#A855F7;"></i>
<div class="step-number">3</div>
</div>
<div class="step-title">Entrevista</div>
<p class="step-desc">Conversamos contigo para asegurar la mejor compatibilidad.</p>
</div>
</div>
<div class="col-6 col-lg-3 reveal reveal-d3">
<div class="step-card">
<div class="step-icon-wrap" style="background:#D1FAE5;">
<i class="fa-solid fa-house-heart" style="color:var(--ph-accent);"></i>
<div class="step-number last">4</div>
</div>
<div class="step-title">¡Bienvenido a casa!</div>
<p class="step-desc">Tu nuevo compañero llega a su hogar definitivo. ¡Celebra!</p>
</div>
</div>
</div>
</div>
<div class="text-center mt-4 reveal">
<a class="btn-hero-primary" href="#animales" style="display:inline-flex;">
<i class="fa-solid fa-arrow-right"></i> Comenzar el proceso
      </a>
</div>
</div>
</section>
<!-- ══════════════════════════════════════════
     EVENTOS
══════════════════════════════════════════ -->
<section class="py-5" id="eventos" style="padding-top:5rem!important;padding-bottom:5rem!important;">
<div class="container">
<div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between mb-4 reveal" style="gap:1rem;">
<div>
<span class="section-eyebrow">Próximamente</span>
<h2 class="section-title mb-0">Eventos del refugio</h2>
</div>
<a class="text-primary font-weight-bold" href="#" style="font-size:.875rem;white-space:nowrap;">
        Ver todos <i class="fa-solid fa-arrow-right ml-1"></i>
</a>
</div>
<div class="row flex-nowrap flex-md-wrap events-row">
<!-- Event 1 -->
<div class="col-10 col-md-4 event-col mb-4 reveal">
<div class="event-card">
<div class="position-relative">
<img alt="Evento" src="https://images.unsplash.com/photo-1507146426996-ef05306b995a?w=600&amp;h=280&amp;fit=crop"/>
<div class="event-date-badge"><div class="day">15</div><div class="mon">Jun</div></div>
</div>
<div class="event-body">
<h5 class="event-title">Feria de Adopción Masiva</h5>
<div class="event-location"><i class="fa-solid fa-location-dot"></i> Parque Central, San Pedro Sula</div>
<p class="event-desc">Más de 30 animales en busca de hogar. Vacunación gratuita incluida.</p>
<a class="event-link" href="#">Ver detalles <i class="fa-solid fa-chevron-right" style="font-size:.7rem;"></i></a>
</div>
</div>
</div>
<!-- Event 2 -->
<div class="col-10 col-md-4 event-col mb-4 reveal reveal-d1">
<div class="event-card">
<div class="position-relative">
<img alt="Evento" src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=600&amp;h=280&amp;fit=crop&amp;crop=top"/>
<div class="event-date-badge" style="background:var(--ph-accent);box-shadow:0 4px 12px rgba(16,185,129,.3);"><div class="day">22</div><div class="mon">Jun</div></div>
</div>
<div class="event-body">
<h5 class="event-title">Taller de Tenencia Responsable</h5>
<div class="event-location"><i class="fa-solid fa-location-dot"></i> Refugio PetsHome · Colonia Palmira</div>
<p class="event-desc">Aprende sobre cuidado animal, nutrición y bienestar. Cupos limitados.</p>
<a class="event-link" href="#">Ver detalles <i class="fa-solid fa-chevron-right" style="font-size:.7rem;"></i></a>
</div>
</div>
</div>
<!-- Event 3 -->
<div class="col-10 col-md-4 event-col mb-4 reveal reveal-d2">
<div class="event-card">

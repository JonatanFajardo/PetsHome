@{
    ViewData["Title"] = "PetsHome — Encuentra a tu nuevo mejor amigo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Landing Page";
}

@section Styles {
  <link rel="stylesheet" href="~/css/landing-page.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
}

<!-- ══════════════════════════════════════════
     NAVBAR
══════════════════════════════════════════ -->

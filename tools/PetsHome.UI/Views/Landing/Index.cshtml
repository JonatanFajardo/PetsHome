<!-- ══════════════════════════════════════════
     HERO
══════════════════════════════════════════ -->
<section class="hero-section">
<!-- Floating paws -->
<div class="paw-bg">
<i class="fa-solid fa-paw paw-item" style="left:5%;font-size:1.4rem;animation-duration:14s;animation-delay:0s;"></i>
<i class="fa-solid fa-paw paw-item" style="left:16%;font-size:2.2rem;animation-duration:19s;animation-delay:3s;"></i>
<i class="fa-solid fa-paw paw-item" style="left:31%;font-size:1rem;animation-duration:12s;animation-delay:1.5s;"></i>
<i class="fa-solid fa-paw paw-item" style="left:51%;font-size:1.8rem;animation-duration:21s;animation-delay:5s;"></i>
<i class="fa-solid fa-paw paw-item" style="left:67%;font-size:1.3rem;animation-duration:16s;animation-delay:2.5s;"></i>
<i class="fa-solid fa-paw paw-item" style="left:79%;font-size:.9rem;animation-duration:17s;animation-delay:7s;"></i>
<i class="fa-solid fa-paw paw-item" style="left:89%;font-size:1.8rem;animation-duration:13s;animation-delay:4s;"></i>
</div>
<div class="container py-5 py-lg-0">
<div class="row align-items-center">
<!-- Text col -->
<div class="col-lg-6 mb-5 mb-lg-0">
<div class="hero-eyebrow">
<span class="dot"></span>
          Más de 120 animales te esperan
        </div>
<h1 class="hero-headline mb-4">
          Encuentra a tu<br/><span>nuevo mejor</span><br/>amigo
        </h1>
<p class="hero-sub mb-4">
          Cientos de animales esperan un hogar. Adoptar es un acto de amor que cambia dos vidas para siempre.
        </p>
<div class="d-flex flex-wrap" style="gap:.75rem;">
<a class="btn-hero-primary" href="#animales">
<i class="fa-solid fa-magnifying-glass"></i> Ver animales
          </a>
<a class="btn-hero-ghost" href="#proceso">
            Conoce el proceso <i class="fa-solid fa-arrow-right"></i>
</a>
</div>
<!-- Trust row -->
<div class="d-flex align-items-center mt-4" style="gap:1rem;">
<div class="avatar-stack">
<img alt="a" src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=40&amp;h=40&amp;fit=crop&amp;crop=face"/>
<img alt="a" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=40&amp;h=40&amp;fit=crop&amp;crop=face"/>
<img alt="a" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=40&amp;h=40&amp;fit=crop&amp;crop=face"/>
<div class="av-more">+40</div>
</div>
<p class="mb-0" style="font-size:.875rem;color:var(--ph-gray);">
            Familias que ya adoptaron <strong style="color:var(--ph-accent);">este año</strong>
</p>
</div>
</div>
<!-- Image col -->
<div class="col-lg-6 d-flex justify-content-center justify-content-lg-end">
<div class="hero-img-wrap" style="max-width:480px;width:100%;">
<img alt="Happy dog" src="https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=720&amp;h=720&amp;fit=crop&amp;crop=center"/>
<!-- Bottom pill -->
<div class="hero-pill hero-pill-bottom">
<div class="hero-pill-icon" style="background:var(--ph-primary-lt);">
<i class="fa-solid fa-house" style="color:var(--ph-primary);"></i>
</div>
<div>
<p class="mb-0" style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.875rem;color:var(--ph-dark);">¡Adoptado hoy!</p>
<p class="mb-0" style="font-size:.75rem;color:var(--ph-gray);">Max encontró hogar</p>
</div>
</div>
<!-- Top pill -->
<div class="hero-pill hero-pill-top">
<i class="fa-solid fa-shield-heart mr-2"></i>
<span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.8125rem;">Salvando vidas</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- ══════════════════════════════════════════
     STATS
══════════════════════════════════════════ -->
<section class="stats-section">
<div class="container">
<div class="row align-items-center justify-content-center">
<!-- Stat 1 -->
<div class="col-12 col-sm-3 text-center reveal mb-4 mb-sm-0" data-stat="">
<div class="stat-num" data-target="120">0</div>
<div class="stat-label">
<i class="fa-solid fa-circle-check mr-1" style="color:var(--ph-accent);font-size:.75rem;"></i>
          Animales rescatados
        </div>
</div>
<div class="col-auto d-none d-sm-block stat-divider align-self-stretch" style="min-height:60px;"></div>
<!-- Stat 2 -->
<div class="col-12 col-sm-3 text-center reveal reveal-d1 mb-4 mb-sm-0" data-stat="">
<div class="stat-num" data-target="85">0</div>
<div class="stat-label">
<i class="fa-solid fa-circle-check mr-1" style="color:var(--ph-accent);font-size:.75rem;"></i>
          Adoptados este año
        </div>
</div>
<div class="col-auto d-none d-sm-block stat-divider align-self-stretch" style="min-height:60px;"></div>
<!-- Stat 3 -->
<div class="col-12 col-sm-3 text-center reveal reveal-d2" data-stat="">
<div class="stat-num" data-target="40">0</div>
<div class="stat-label">
<i class="fa-solid fa-circle-check mr-1" style="color:var(--ph-accent);font-size:.75rem;"></i>
          Familias felices
        </div>
</div>
</div>
</div>
</section>
<!-- ══════════════════════════════════════════
     ANIMALES DISPONIBLES
══════════════════════════════════════════ -->
<section class="py-5" id="animales" style="padding-top:5rem!important;padding-bottom:5rem!important;">
<div class="container">
<!-- Header -->
<div class="text-center mb-4 reveal">
<span class="section-eyebrow">Adopción</span>
<h2 class="section-title mb-3">Encuentra tu compañero ideal</h2>
<p class="section-sub mx-auto" style="max-width:500px;">Cada uno tiene su historia. Quizás la tuya empieza hoy.</p>
</div>
<!-- Filter bar -->
<div class="filter-bar reveal reveal-d1">
<button class="filter-chip active" data-filter="all">
<i class="fa-solid fa-border-all"></i> Todos
      </button>
<button class="filter-chip" data-filter="dog">
<i class="fa-solid fa-dog"></i> Perros
      </button>
<button class="filter-chip" data-filter="cat">
<i class="fa-solid fa-cat"></i> Gatos
      </button>
<button class="filter-chip" data-filter="young">
<i class="fa-solid fa-seedling"></i> Jóvenes
      </button>
<button class="filter-chip" data-filter="adult">
<i class="fa-solid fa-star"></i> Adultos
      </button>
<button class="filter-chip" data-filter="small">
<i class="fa-solid fa-compress"></i> Pequeños
      </button>
<button class="filter-chip" data-filter="large">
<i class="fa-solid fa-expand"></i> Grandes
      </button>
</div>
<!-- Cards -->
<div class="row" id="animal-grid">
<!-- Bono -->
<div class="col-sm-6 col-lg-4 mb-4 reveal animal-col" data-type="dog large adult">
<div class="animal-card">
<div class="card-img-wrap">
<img alt="Bono" src="https://images.unsplash.com/photo-1558788353-f76d92427f16?w=600&amp;h=420&amp;fit=crop"/>
<div class="card-badge badge-available"><span class="badge-dot"></span> Disponible</div>
</div>
<div class="card-body">
<div class="d-flex justify-content-between align-items-start mb-1">
<h5 class="mb-0" style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;">Bono</h5>
<span class="animal-species-tag tag-dog">Perro</span>
</div>
<div class="animal-meta">
<span><i class="fa-regular fa-calendar"></i> 3 años</span>
<span><i class="fa-solid fa-ruler-vertical"></i> Grande</span>
<span class="meta-check"><i class="fa-solid fa-circle-check"></i> Esterilizado</span>
</div>
<p class="animal-desc">Juguetón, cariñoso y ama los paseos largos al aire libre.</p>
</div>
<div class="card-cta-wrap">
<button class="btn-card-cta">Conocer a Bono <i class="fa-solid fa-arrow-right ml-1"></i></button>
</div>
</div>
</div>
<!-- Luna -->
<div class="col-sm-6 col-lg-4 mb-4 reveal reveal-d1 animal-col" data-type="cat small young">
<div class="animal-card">
<div class="card-img-wrap">

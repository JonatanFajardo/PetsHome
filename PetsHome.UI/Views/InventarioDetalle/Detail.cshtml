@model InventarioDetalleViewModel
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="card">
        <div class="card-header">
            <h3>Detalle del Inventario Detalle</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">ID:</label>
                        <p class="form-control-static">@Model.invdet_Id</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Inventario:</label>
                        <p class="form-control-static">@Model.inventario</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Existencia:</label>
                        <p class="form-control-static">@Model.invdet_Existencia</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Stock:</label>
                        <p class="form-control-static">@Model.invdet_Stock</p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Entradas:</label>
                        <p class="form-control-static">@Model.invdet_Entradas</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label">Salidas:</label>
                        <p class="form-control-static">@Model.invdet_Salidas</p>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <a asp-action="Create" asp-route-id="@Model.invdet_Id" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </div>
    </div>
</div>


@{
    ViewData["Title"] = "Perfil Médico — VetCare";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "";
}

@section Styles {
  <link rel="stylesheet" href="~/css/perfil-medico-mascota.css" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=DM+Sans:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
}

<div class="app-wrapper">
<!-- ════════════ SIDEBAR ════════════ -->
<aside class="sidebar">
<div class="avatar-wrap">
<div class="avatar-img">
<span class="avatar-emoji">🐕</span>
</div>
<span class="status-badge status-treatment">En Tratamiento</span>
</div>
<div class="pet-name">Luna</div>
<div class="pet-meta">
      Golden Retriever · 4 años<br/>
      Hembra · Esterilizada
    </div>
<div class="shelter-tag">
<i class="bi bi-house-heart-fill"></i>
      Refugio El Rincón
    </div>
<div class="sidebar-divider"></div>
<div class="mini-stats">
<div class="mini-stat" style="animation-delay:.1s">
<div class="mini-stat-icon purple"><i class="bi bi-calendar-check"></i></div>
<div>
<div class="mini-stat-val">24</div>
<div class="mini-stat-lbl">Total Citas</div>
</div>
</div>
<div class="mini-stat" style="animation-delay:.18s">
<div class="mini-stat-icon orange" style="background:#FFF7ED;color:#D97706"><i class="bi bi-capsule"></i></div>
<div>
<div class="mini-stat-val">3</div>
<div class="mini-stat-lbl">Tratamientos activos</div>
</div>
</div>
<div class="mini-stat" style="animation-delay:.26s">
<div class="mini-stat-icon green"><i class="bi bi-shield-check"></i></div>
<div>
<div class="mini-stat-val">7</div>
<div class="mini-stat-lbl">Vacunas al día</div>
</div>
</div>
</div>
<div class="sidebar-divider"></div>
<div style="width:100%">
<div class="section-title">Ficha</div>
<div style="font-size:12px;color:var(--text-muted);line-height:2">
<div><b style="color:var(--text-dark);font-weight:600">Microchip</b> · 985141006893421</div>
<div><b style="color:var(--text-dark);font-weight:600">Peso</b> · 28.5 kg</div>
<div><b style="color:var(--text-dark);font-weight:600">Adoptante</b> · Familia García</div>
<div><b style="color:var(--text-dark);font-weight:600">Último control</b> · 18 abr 2026</div>
</div>
</div>
</aside>
<!-- ════════════ MAIN ════════════ -->
<div class="main-content">
<!-- Header -->
<header class="top-header">
<div class="header-left">
<div class="header-title">Luna — Perfil Médico</div>
<nav class="breadcrumb-nav">
<span>VetCare</span>
<i class="bi bi-chevron-right"></i>
<span>Mascotas</span>
<i class="bi bi-chevron-right"></i>
<span style="color:rgba(255,255,255,.9);font-weight:600">Luna</span>
</nav>
</div>
<button class="btn-nueva" onclick="document.getElementById('modalConsulta').style.display='flex'">
<i class="bi bi-plus-lg"></i> Nueva Consulta
      </button>
</header>
<!-- Tab Bar -->
<nav class="tab-bar">
<button class="tab-btn active" onclick="switchTab('resumen', this)">
<i class="bi bi-grid-1x2"></i> Resumen
      </button>
<button class="tab-btn" onclick="switchTab('citas', this)">
<i class="bi bi-calendar3"></i> Citas
        <span class="tab-count">24</span>
</button>
<button class="tab-btn" onclick="switchTab('historial', this)">
<i class="bi bi-clock-history"></i> Historial
      </button>
<button class="tab-btn" onclick="switchTab('recetas', this)">
<i class="bi bi-file-earmark-medical"></i> Recetas
        <span class="tab-count">5</span>
</button>
<button class="tab-btn" onclick="switchTab('tratamientos', this)">
<i class="bi bi-activity"></i> Tratamientos
        <span class="tab-count">3</span>
</button>
<button class="tab-btn" onclick="switchTab('vacunas', this)">
<i class="bi bi-shield-check"></i> Vacunas
      </button>
</nav>
<!-- Content -->
<div class="content-area">
<!-- ═══ RESUMEN ═══ -->
<div class="tab-panel active" id="tab-resumen">
<div class="section-title">Últimas Citas</div>
<div class="citas-grid">
<div class="cita-card tipo-control">
<div class="cita-fecha"><i class="bi bi-calendar3"></i> 18 Abr 2026</div>
<div class="tipo-badge badge-control">Control General</div>
<div class="cita-diag">Revisión anual de salud. Parámetros dentro de la normalidad. Se recomienda ajuste en dieta.</div>
<div class="cita-vet"><i class="bi bi-person-badge"></i> Dra. Martínez</div>
</div>
<div class="cita-card tipo-vacuna">
<div class="cita-fecha"><i class="bi bi-calendar3"></i> 05 Abr 2026</div>
<div class="tipo-badge badge-vacuna">Vacunación</div>
<div class="cita-diag">Aplicación refuerzo antirrábico anual. Sin reacciones adversas. Siguiente dosis en 1 año.</div>
<div class="cita-vet"><i class="bi bi-person-badge"></i> Dr. Herrera</div>
</div>
<div class="cita-card tipo-urgencia">
<div class="cita-fecha"><i class="bi bi-calendar3"></i> 22 Mar 2026</div>
<div class="tipo-badge badge-urgencia">Urgencia</div>
<div class="cita-diag">Vómitos persistentes y decaimiento. Gastroenteritis aguda. Se inicia tratamiento con antibióticos.</div>
<div class="cita-vet"><i class="bi bi-person-badge"></i> Dra. Ruiz</div>
</div>
<div class="cita-card tipo-revision">
<div class="cita-fecha"><i class="bi bi-calendar3"></i> 10 Mar 2026</div>
<div class="tipo-badge badge-revision">Revisión</div>

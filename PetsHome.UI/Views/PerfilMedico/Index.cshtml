@model PetsHome.Business.Models.PerfilMedicoViewModel
@{
    ViewData["Title"] = "Perfil Médico";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Perfil medico de mascota";

    var ficha = Model.FichaMascota.FirstOrDefault();
    var nombreMascota = ficha?.masc_Nombre ?? "Mascota";

    string TipoCss(string tipo) {
        var t = (tipo ?? "").ToLower();
        if (t.Contains("vacun"))                                        return "tipo-vacuna";
        if (t.Contains("urgencia") || t.Contains("emergencia"))         return "tipo-urgencia";
        if (t.Contains("revisión") || t.Contains("revision")
         || t.Contains("seguimiento") || t.Contains("control"))        return "tipo-control";
        return "tipo-revision";
    }
    string BadgeCss(string tipo) {
        var t = (tipo ?? "").ToLower();
        if (t.Contains("vacun"))                                        return "badge-vacuna";
        if (t.Contains("urgencia") || t.Contains("emergencia"))         return "badge-urgencia";
        if (t.Contains("revisión") || t.Contains("revision")
         || t.Contains("seguimiento") || t.Contains("control"))        return "badge-control";
        return "badge-revision";
    }
    string TlColor(string tipo) {
        var t = (tipo ?? "").ToLower();
        if (t.Contains("vacun"))                                        return "green";
        if (t.Contains("urgencia"))                                     return "red";
        return "purple";
    }
    string TlIcon(string tipo) {
        var t = (tipo ?? "").ToLower();
        if (t.Contains("vacun"))                                        return "bi-shield-check";
        if (t.Contains("urgencia"))                                     return "bi-exclamation-triangle";
        return "bi-stethoscope";
    }
    string DiasCss(int? dias) {
        if (!dias.HasValue || dias <= 3)  return "dias-low";
        if (dias <= 7)                    return "dias-mid";
        return "dias-ok";
    }
    string EstatusClass(string estado) => (estado ?? "") switch {
        "Activo"     => "tstat-active",
        "Finalizado" => "tstat-done",
        _            => "tstat-pending"
    };
    string VacunaClass(string estado) => (estado ?? "") switch {
        "Vencida"  => "vacuna-venc",
        "Próxima"  => "vacuna-proxima",
        _          => "vacuna-ok"
    };
    string DotClass(string estado) => (estado ?? "") switch {
        "Vencida"  => "dot-venc",
        "Próxima"  => "dot-proxima",
        _          => "dot-ok"
    };

    string statusBadgeCss   = ficha?.EstadoSalud == "En Tratamiento" ? "status-treatment"
                            : ficha?.EstadoSalud == "Crítico"        ? "status-critical"
                                                                      : "status-healthy";
    string statusBadgeLabel = ficha?.EstadoSalud ?? "Saludable";
}

@section Styles {
  <link rel="stylesheet" href="~/css/modern-table-styles.css" />
  <link rel="stylesheet" href="~/css/perfil-medico-mascota.css" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* Ajustes de integración con el layout de la app */
    .app-wrapper { min-height: auto; }
    .pets-container { margin-bottom: 0; }
  </style>
}

<div class="col-12">
  <div class="pets-container">
    <div class="pets-header-full">
      <breadcrumb></breadcrumb>
      <div class="pets-header-content">
        <div class="pets-title-section">
          <h2 class="text-white"><i class="fas fa-stethoscope mr-2 text-white"></i>Perfil Médico — @nombreMascota</h2>
        </div>
        <div class="pets-controls">
          <div class="search-container" style="position:relative;">
            <i class="fas fa-search"></i>
            <input type="text" id="headerMascSearch" placeholder="Cambiar mascota..." autocomplete="off" style="min-width:220px;" />
            <div id="headerMascResults" style="display:none;position:fixed;background:#fff;border:1px solid #e5e7eb;border-radius:10px;z-index:9999;max-height:280px;overflow-y:auto;box-shadow:0 8px 24px rgba(0,0,0,.18);min-width:320px;"></div>
          </div>
          <button class="btn-nueva" onclick="document.getElementById('modalConsulta').style.display='flex'">
            <i class="bi bi-plus-lg"></i> Nueva Consulta
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="col-12" style="padding:0">
<div class="app-wrapper">

  <!-- ════════════ SIDEBAR PET ════════════ -->
  <aside class="sidebar">
    <div class="avatar-wrap">
      <div class="avatar-img">
        <span class="avatar-emoji">🐾</span>
      </div>
      <span class="status-badge @statusBadgeCss">@statusBadgeLabel</span>
    </div>

    <div class="pet-name">@nombreMascota</div>
    <div class="pet-meta">
      @ficha?.Raza · @ficha?.Edad<br />
      @ficha?.Sexo · @(ficha?.EsEsterilizada == true ? "Esterilizado/a" : "No esterilizado/a")
    </div>

    @if (!string.IsNullOrEmpty(ficha?.Refugio))
    {
      <div class="shelter-tag">
        <i class="bi bi-house-heart-fill"></i>
        @ficha.Refugio
      </div>
    }

    <div class="sidebar-divider"></div>

    <div class="mini-stats">
      <div class="mini-stat" style="animation-delay:.1s">
        <div class="mini-stat-icon purple"><i class="bi bi-calendar-check"></i></div>
        <div>
          <div class="mini-stat-val">@(ficha?.TotalCitas ?? 0)</div>
          <div class="mini-stat-lbl">Total Citas</div>
        </div>
      </div>
      <div class="mini-stat" style="animation-delay:.18s">
        <div class="mini-stat-icon" style="background:#FFF7ED;color:#D97706"><i class="bi bi-capsule"></i></div>
        <div>
          <div class="mini-stat-val">@(ficha?.TratamientosActivos ?? 0)</div>
          <div class="mini-stat-lbl">Tratamientos activos</div>
        </div>
      </div>
      <div class="mini-stat" style="animation-delay:.26s">
        <div class="mini-stat-icon green"><i class="bi bi-shield-check"></i></div>
        <div>
          <div class="mini-stat-val">@(ficha?.VacunasAlDia ?? 0)</div>
          <div class="mini-stat-lbl">Vacunas al día</div>
        </div>
      </div>
    </div>

    <div class="sidebar-divider"></div>

    <div style="width:100%">
      <div class="section-title">Ficha</div>
      <div style="font-size:12px;color:var(--text-muted);line-height:2">
        <div><b style="color:var(--text-dark);font-weight:600">Microchip</b> · @(ficha?.Microchip ?? "N/A")</div>
        <div><b style="color:var(--text-dark);font-weight:600">Peso</b> · @(ficha?.Peso?.ToString("0.##") ?? "—") kg</div>
        <div><b style="color:var(--text-dark);font-weight:600">Adoptante</b> · @(ficha?.Adoptante ?? "Sin adoptante")</div>
        <div><b style="color:var(--text-dark);font-weight:600">Último control</b> · @(ficha?.UltimaVisita?.ToString("dd MMM yyyy") ?? "—")</div>
      </div>
    </div>
  </aside>

  <!-- ════════════ MAIN ════════════ -->
  <div class="main-content">

    <!-- Tab Bar -->
    <nav class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('resumen', this)">
        <i class="bi bi-grid-1x2"></i> Resumen
      </button>
      <button class="tab-btn" onclick="switchTab('citas', this)">
        <i class="bi bi-calendar3"></i> Citas
        <span class="tab-count">@Model.TotalTodasCitas</span>
      </button>
      <button class="tab-btn" onclick="switchTab('historial', this)">
        <i class="bi bi-clock-history"></i> Historial
      </button>
      <button class="tab-btn" onclick="switchTab('recetas', this)">
        <i class="bi bi-file-earmark-medical"></i> Recetas
      </button>
      <button class="tab-btn" onclick="switchTab('tratamientos', this)">
        <i class="bi bi-activity"></i> Tratamientos
        <span class="tab-count">@Model.TotalTratamientos</span>
      </button>
      <button class="tab-btn" onclick="switchTab('vacunas', this)">
        <i class="bi bi-shield-check"></i> Vacunas
        <span class="tab-count">@Model.TotalVacunas</span>
      </button>
    </nav>

    <!-- Content -->
    <div class="content-area">

      <!-- ═══ RESUMEN ═══ -->
      <div class="tab-panel active" id="tab-resumen">

        <div class="section-title">Últimas Citas</div>
        <div class="citas-grid">
          @foreach (var c in Model.UltimasCitas)
          {
            <div class="cita-card @TipoCss(c.TipoConsulta)">
              <div class="cita-fecha"><i class="bi bi-calendar3"></i> @c.cita_FechaConsulta.ToString("dd MMM yyyy")</div>
              <div class="tipo-badge @BadgeCss(c.TipoConsulta)">@c.TipoConsulta</div>
              <div class="cita-diag">@c.cita_Diagnostico</div>
              <div class="cita-vet"><i class="bi bi-person-badge"></i> @c.Veterinario</div>
            </div>
          }
          @if (!Model.UltimasCitas.Any())
          {
            <div class="empty-state" style="grid-column:1/-1">
              <i class="bi bi-calendar-x"></i>
              <p>Sin citas registradas</p>
            </div>
          }
        </div>

        <div class="resumen-lower">

          <!-- Medicamentos activos -->
          <div class="meds-card">
            <div class="meds-header">
              <span><i class="bi bi-capsule me-2" style="color:var(--purple-1)"></i>Medicamentos Activos</span>
              <span style="font-size:12px;color:var(--text-muted);font-weight:400">@Model.TotalMedicamentosActivos en curso</span>
            </div>
            <table class="meds-table">
              <thead>
                <tr>
                  <th>Medicamento</th>
                  <th>Progreso</th>
                  <th style="text-align:center">Días rest.</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var m in Model.MedicamentosActivos)
                {
                  <tr>
                    <td>
                      <div class="med-name">@m.Medicamento</div>
                      <div class="med-dose">@m.Dosis</div>
                    </td>
                    <td>
                      <div class="prog-bar"><div class="prog-fill" data-pct="@m.PorcentajeCompletado"></div></div>
                      <div class="prog-pct">@m.PorcentajeCompletado% completado</div>
                    </td>
                    <td class="dias-cell @DiasCss(m.DiasRestantes)">@(m.DiasRestantes?.ToString() ?? "—")</td>
                  </tr>
                }
                @if (!Model.MedicamentosActivos.Any())
                {
                  <tr>
                    <td colspan="3" style="text-align:center;padding:24px;color:var(--text-muted);font-size:13px">
                      Sin medicamentos activos
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>

          <!-- Timeline -->
          <div class="timeline-card">
            <div class="timeline-header"><i class="bi bi-clock-history me-2" style="color:var(--purple-1)"></i>Últimos Eventos</div>
            <div class="timeline-body">
              @foreach (var c in Model.UltimasCitas)
              {
                <div class="tl-item">
                  <div class="tl-icon @TlColor(c.TipoConsulta)"><i class="bi @TlIcon(c.TipoConsulta)"></i></div>
                  <div class="tl-text">
                    <div class="tl-event">@c.TipoConsulta</div>
                    <div class="tl-date">@c.cita_FechaConsulta.ToString("dd MMM yyyy") · @c.Veterinario</div>
                  </div>
                </div>
              }
              @if (!Model.UltimasCitas.Any())
              {
                <p style="font-size:13px;color:var(--text-muted);text-align:center;padding:20px 0">Sin eventos recientes</p>
              }
            </div>
          </div>

        </div>
      </div><!-- /tab-resumen -->

      <!-- ═══ CITAS ═══ -->
      <div class="tab-panel" id="tab-citas">
        <div class="section-title">Todas las Citas</div>
        <div class="citas-list">
          @foreach (var c in Model.TodasCitas)
          {
            <div class="cita-row">
              <div class="cita-row-date">
                <div class="cita-row-day">@c.cita_FechaConsulta.Day</div>
                <div class="cita-row-month">@c.cita_FechaConsulta.ToString("MMM")</div>
              </div>
              <div class="cita-row-body">
                <div class="cita-row-title">@c.cita_Diagnostico</div>
                <div class="cita-row-sub">
                  <span><i class="bi bi-person-badge"></i> @c.Veterinario</span>
                  @if (!string.IsNullOrEmpty(c.Hora) && c.Hora != "00:00:00")
                  {
                    <span><i class="bi bi-clock"></i> @c.Hora</span>
                  }
                </div>
              </div>
              <div><span class="tipo-badge @BadgeCss(c.TipoConsulta)">@c.TipoConsulta</span></div>
            </div>
          }
          @if (!Model.TodasCitas.Any())
          {
            <div class="empty-state">
              <i class="bi bi-calendar-x"></i>
              <div style="font-size:16px;font-weight:600;color:var(--text-dark);margin-bottom:6px">Sin citas registradas</div>
              <p>Aún no hay citas para esta mascota.</p>
            </div>
          }
        </div>
      </div>

      <!-- ═══ HISTORIAL ═══ -->
      <div class="tab-panel" id="tab-historial">
        <div class="empty-state">
          <i class="bi bi-archive"></i>
          <div style="font-size:16px;font-weight:600;color:var(--text-dark);margin-bottom:6px">Historial Clínico Completo</div>
          <p>El historial detallado estará disponible próximamente.<br />Por ahora puedes consultar el Resumen general.</p>
        </div>
      </div>

      <!-- ═══ RECETAS ═══ -->
      <div class="tab-panel" id="tab-recetas">
        <div class="empty-state">
          <i class="bi bi-file-earmark-medical"></i>
          <div style="font-size:16px;font-weight:600;color:var(--text-dark);margin-bottom:6px">Recetas Digitales</div>
          <p>Aquí aparecerán las recetas emitidas por los veterinarios.</p>
        </div>
      </div>

      <!-- ═══ TRATAMIENTOS ═══ -->
      <div class="tab-panel" id="tab-tratamientos">
        <div class="section-title">Tratamientos en Curso</div>
        <div class="trat-list">
          @foreach (var t in Model.Tratamientos)
          {
            var esFinado = (t.EstadoTratamiento ?? "").ToLower() == "finalizado";
            <div class="trat-card" style="@(esFinado ? "opacity:.75" : "")">
              <div class="trat-icon-wrap">💊</div>
              <div class="trat-info">
                <div class="trat-name">@t.NombreTratamiento</div>
                <div class="trat-med"><i class="bi bi-capsule"></i> @t.Medicamento</div>
                <div class="trat-dates">
                  <span><i class="bi bi-calendar-event"></i> Inicio: @t.trat_FechaInicio.ToString("dd MMM yyyy")</span>
                  @if (t.trat_FechaFin.HasValue)
                  {
                    <span><i class="bi bi-calendar-x"></i> Fin: @t.trat_FechaFin.Value.ToString("dd MMM yyyy")</span>
                  }
                </div>
              </div>
              <div class="trat-progress">
                <div class="trat-prog-label">
                  <span class="trat-prog-name">Progreso del tratamiento</span>
                  <span class="trat-prog-pct">@t.PorcentajeCompletado%</span>
                </div>
                <div class="trat-prog-bar">
                  <div class="trat-prog-fill" data-pct="@t.PorcentajeCompletado"
                       @(esFinado ? "style=\"background:linear-gradient(90deg,#6EE7B7,#059669)\"" : "")></div>
                </div>
              </div>
              <div class="trat-status-col">
                <span class="trat-status @EstatusClass(t.EstadoTratamiento)">@t.EstadoTratamiento</span>
              </div>
            </div>
          }
          @if (!Model.Tratamientos.Any())
          {
            <div class="empty-state">
              <i class="bi bi-activity"></i>
              <div style="font-size:16px;font-weight:600;color:var(--text-dark);margin-bottom:6px">Sin tratamientos</div>
              <p>No hay tratamientos registrados para esta mascota.</p>
            </div>
          }
        </div>
      </div>

      <!-- ═══ VACUNAS ═══ -->
      <div class="tab-panel" id="tab-vacunas">
        <div class="section-title">Cartilla de Vacunación</div>
        <div class="vacunas-grid">
          @foreach (var v in Model.Vacunas)
          {
            string estadoLabel;
            if (v.EstadoVacuna == "Al día")
                estadoLabel = "Al día · Próxima: " + (v.FechaProxima?.ToString("MMM yyyy") ?? "—");
            else if (v.EstadoVacuna == "Próxima")
                estadoLabel = "Próxima: " + (v.FechaProxima?.ToString("MMM yyyy") ?? "—") + " (¡pronto!)";
            else
                estadoLabel = "¡Vencida! Requiere refuerzo";

            <div class="vacuna-card">
              <div class="vacuna-icon">💉</div>
              <div class="vacuna-name">@v.VacunaNombre</div>
              <div class="vacuna-date"><i class="bi bi-calendar-check"></i> Aplicada: @(v.FechaAplicada?.ToString("dd MMM yyyy") ?? "—")</div>
              <div class="vacuna-next @VacunaClass(v.EstadoVacuna)">
                <span class="vacuna-dot @DotClass(v.EstadoVacuna)"></span>@estadoLabel
              </div>
            </div>
          }
          @if (!Model.Vacunas.Any())
          {
            <div class="empty-state" style="grid-column:1/-1">
              <i class="bi bi-shield-x"></i>
              <p>Sin vacunas registradas</p>
            </div>
          }
        </div>
      </div>

    </div><!-- /content-area -->
  </div><!-- /main-content -->
</div><!-- /app-wrapper -->
</div><!-- /col-12 -->

<!-- ════════ MODAL NUEVA CONSULTA ════════ -->
<div id="modalConsulta" style="display:none;position:fixed;inset:0;background:rgba(30,27,58,.5);backdrop-filter:blur(6px);z-index:100;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:20px;width:520px;max-width:95%;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.25)">
    <div class="modal-header" style="padding:20px 24px;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div class="modal-title" style="font-size:18px">Nueva Consulta</div>
        <div style="color:rgba(255,255,255,.7);font-size:12px;margin-top:2px">@nombreMascota · @ficha?.Raza</div>
      </div>
      <button onclick="document.getElementById('modalConsulta').style.display='none'"
              style="background:rgba(255,255,255,.2);border:none;border-radius:10px;width:32px;height:32px;color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;">&times;</button>
    </div>
    <div style="padding:24px">
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button onclick="document.getElementById('modalConsulta').style.display='none'"
                style="padding:10px 20px;border:1.5px solid var(--border);border-radius:10px;background:none;font-size:13px;font-family:inherit;cursor:pointer;color:var(--text-muted)">
          Cancelar
        </button>
        <button onclick="window.location.href=window._urls.crearCitaMedica"
                style="padding:10px 24px;border:none;border-radius:10px;background:linear-gradient(135deg,var(--purple-1),var(--purple-2));color:#fff;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;box-shadow:0 4px 16px rgba(108,92,231,.35)">
          Ir a Nueva Consulta
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    window._urls = {
      crearCitaMedica: '@Url.Action("Create", "CitaMedica")?mascId=@(ficha?.masc_Id ?? 0)'
    };
  </script>
  <script src="~/js/pages/perfil-medico-mascota.js"></script>
  <script>
    (function () {
      const input   = document.getElementById('headerMascSearch');
      const results = document.getElementById('headerMascResults');
      const searchUrl = '@Url.Action("Search", "Mascota")';
      const perfilUrl = '@Url.Action("Index", "PerfilMedico")';
      let timer = null;

      function render(items) {
        if (!items || items.length === 0) {
          results.innerHTML = '<div style="padding:14px 16px;color:#9ca3af;font-size:13px;">Sin coincidencias</div>';
        } else {
          results.innerHTML = items.map(m =>
            `<div class="pm-search-item" data-id="${m.id}" style="padding:10px 16px;cursor:pointer;border-bottom:1px solid #f3f4f6;transition:background .15s;">
               <div style="font-weight:600;color:#111827;font-size:13px;">${m.nombre}</div>
               <div style="font-size:11px;color:#6b7280;margin-top:2px;">
                 ${m.raza || ''}${m.refugio ? ' · ' + m.refugio : ''}
               </div>
             </div>`
          ).join('');
        }
        results.style.display = 'block';
      }

      function positionResults() {
        const rect = input.getBoundingClientRect();
        results.style.top   = (rect.bottom + 6) + 'px';
        results.style.left  = rect.left + 'px';
        results.style.width = Math.max(rect.width, 320) + 'px';
      }

      input.addEventListener('input', function () {
        const term = this.value.trim();
        clearTimeout(timer);
        if (term.length < 1) { results.style.display = 'none'; return; }
        positionResults();
        timer = setTimeout(() => {
          fetch(searchUrl + '?term=' + encodeURIComponent(term))
            .then(r => r.json()).then(render);
        }, 200);
      });

      results.addEventListener('click', function (e) {
        const item = e.target.closest('.pm-search-item');
        if (!item) return;
        window.location.href = perfilUrl + '?mascId=' + item.dataset.id;
      });

      results.addEventListener('mouseover', function(e) {
        const item = e.target.closest('.pm-search-item');
        if (item) item.style.background = '#faf8ff';
      });
      results.addEventListener('mouseout', function(e) {
        const item = e.target.closest('.pm-search-item');
        if (item) item.style.background = '';
      });

      document.addEventListener('click', function(e) {
        if (!input.contains(e.target) && !results.contains(e.target))
          results.style.display = 'none';
      });
    })();
  </script>
}

@model DonacionViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" id="formulario">
    <form asp-action="Add" asp-controller="Donacion" method="post" autocomplete="ON">
        <input class="form-control" asp-for="dona_Id" type="hidden" />

        <!-- Información del Donante -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-info text-white d-flex align-items-center">
                <i class="fas fa-user fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información del Donante</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_NombreDonante">Nombre del Donante</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input class="form-control" asp-for="dona_NombreDonante" type="text" placeholder="Nombre completo del donante" />
                            </div>
                            <span class="text-danger" asp-validation-for="dona_NombreDonante"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_TelefonoDonante">Teléfono</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input class="form-control" asp-for="dona_TelefonoDonante" type="tel" placeholder="Número de teléfono" />
                            </div>
                            <span class="text-danger" asp-validation-for="dona_TelefonoDonante"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_EmailDonante">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input class="form-control" asp-for="dona_EmailDonante" type="email" placeholder="Correo electrónico" />
                            </div>
                            <span class="text-danger" asp-validation-for="dona_EmailDonante"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de la Donación -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-vitals text-white d-flex align-items-center">
                <i class="fas fa-hand-holding-heart fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información de la Donación</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_TipoDonacion">Tipo de Donación</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-gift"></i></span>
                                <select class="form-control" asp-for="dona_TipoDonacion" asp-items="Model.TiposDonacionDropdown">
                                    <option value="">-- Seleccionar Tipo --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="dona_TipoDonacion"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_FechaDonacion">Fecha de Donación</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                <input class="form-control" asp-for="dona_FechaDonacion" type="date" />
                            </div>
                            <span class="text-danger" asp-validation-for="dona_FechaDonacion"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_MontoMonetario">Monto Monetario</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                                <input class="form-control" asp-for="dona_MontoMonetario" type="number" min="0" step="0.01" placeholder="0.00" />
                            </div>
                            <span class="text-danger" asp-validation-for="dona_MontoMonetario"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_ValorEstimado">Valor Estimado</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calculator"></i></span>
                                <input class="form-control" asp-for="dona_ValorEstimado" type="number" min="0" step="0.01" placeholder="0.00" />
                            </div>
                            <span class="text-danger" asp-validation-for="dona_ValorEstimado"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_DescripcionArticulos">Descripción de Artículos</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-list"></i></span>
                                <textarea class="form-control" asp-for="dona_DescripcionArticulos" rows="3" placeholder="Descripción detallada de los artículos donados"></textarea>
                            </div>
                            <span class="text-danger" asp-validation-for="dona_DescripcionArticulos"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado y Refugio -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-appointment text-white d-flex align-items-center">
                <i class="fas fa-cogs fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Estado y Refugio</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_Estado">Estado</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-flag"></i></span>
                                <select class="form-control" asp-for="dona_Estado" asp-items="Model.EstadosDropdown">
                                    <option value="">-- Seleccionar Estado --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="dona_Estado"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Id">Refugio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-home"></i></span>
                                <select class="form-control" asp-for="refg_Id" asp-items="Model.RefugiosDropdown">
                                    <option value="">-- Seleccionar Refugio --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Id"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="dona_Observaciones">Observaciones</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-comment"></i></span>
                                <textarea class="form-control" asp-for="dona_Observaciones" rows="3" placeholder="Observaciones adicionales sobre la donación"></textarea>
                            </div>
                            <span class="text-danger" asp-validation-for="dona_Observaciones"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="actions-wrapper">
            <div class="actions-title">Acciones</div>
            <div class="actions-divider"></div>
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">* Los cambios se guardarán permanentemente</small>
                <div class="d-flex">
                    <a class="btn btn-modern btn-outline-cancel mr-3" asp-action="Index">
                        <i class="fas fa-times btn-icon"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-modern btn-solid-save">
                        <i class="fas fa-check btn-icon"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts{
    <script src="~/js/load-dropdownlist.js"></script>
}
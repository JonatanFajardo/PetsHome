@model EmpleadoCargoViewModel
@{
    ViewData["Title"] = "Cargos de Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header purpura con todos los controles -->
    <div class="pets-header-full">
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fa-user-tag mr-2 text-white"></i>Gestión de Cargos</h2>
                <button class="btn-nueva-mascota" id="add-btn" data-toggle="modal" data-target="#edit-modal">
                    <i class="fas fa-plus mr-2"></i>Nuevo Cargo
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por nombre o descripción...">
                </div>
                <div class="action-buttons">
                    <div class="view-toggle">
                        <button class="btn-control active" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                    </div>
                    <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tip de ayuda -->
    <div id="filter-tip" class="filter-tip">
        <div class="filter-tip__text">
            <i class="fas fa-hand-pointer" style="font-size: 18px;"></i>
            <span>Toca las tarjetas de abajo para filtrar entre cargos <strong>activos</strong>, <strong>inactivos</strong> o ver <strong>todos</strong>.</span>
        </div>
        <button class="filter-tip__close" onclick="document.getElementById('filter-tip').style.display='none'; sessionStorage.setItem('hideCargosFilterTip','1');" title="Cerrar">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <script>
        if (sessionStorage.getItem('hideCargosFilterTip') === '1') {
            document.getElementById('filter-tip').style.display = 'none';
        }
    </script>

    <!-- Cards de resumen -->
    <div class="summary-cards-grid">
        <!-- Card Activos -->
        <div class="summary-card summary-card--green" id="card-activos" onclick="filterByStatus('Activo')">
            <div class="summary-card__body">
                <div>
                    <div class="summary-card__title">Activos</div>
                    <div class="summary-card__count" id="count-activos">0</div>
                    <div class="summary-card__subtitle">En servicio</div>
                </div>
                <div class="summary-card__icon">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <div class="summary-card__footer">
                <span class="summary-card__action"><i class="fas fa-arrow-right" style="margin-right:4px;"></i>Filtrar activos</span>
            </div>
        </div>
        <!-- Card Inactivos -->
        <div class="summary-card summary-card--red" id="card-inactivos" onclick="filterByStatus('Inactivo')">
            <div class="summary-card__body">
                <div>
                    <div class="summary-card__title">Inactivos</div>
                    <div class="summary-card__count" id="count-inactivos">0</div>
                    <div class="summary-card__subtitle">Sin servicio</div>
                </div>
                <div class="summary-card__icon">
                    <i class="fas fa-ban"></i>
                </div>
            </div>
            <div class="summary-card__footer">
                <span class="summary-card__action"><i class="fas fa-arrow-right" style="margin-right:4px;"></i>Filtrar inactivos</span>
            </div>
        </div>
        <!-- Card Total -->
        <div class="summary-card summary-card--purple" id="card-total" onclick="filterByStatus('')">
            <div class="summary-card__body">
                <div>
                    <div class="summary-card__title">Total Cargos</div>
                    <div class="summary-card__count" id="count-total">0</div>
                    <div class="summary-card__subtitle">Registrados</div>
                </div>
                <div class="summary-card__icon">
                    <i class="fas fa-briefcase"></i>
                </div>
            </div>
            <div class="summary-card__footer">
                <span class="summary-card__action"><i class="fas fa-list" style="margin-right:4px;"></i>Ver todos</span>
            </div>
        </div>
    </div>

    <!-- Vista de Tabla -->
    <div id="tableView" class="pets-table-container">
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th>Descripcion</th>
                    <th width="120">Salario</th>
                    <th width="140">Estado</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargara los datos aqui -->
            </tbody>
        </table>
    </div>

    <!-- Modal Edit/Create -->
    <div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"></h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Add" method="post" autocomplete="off"
                      data-ajax="true"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="cag_Id" id="item-id" value="@ViewBag.cag_Id" />

                    <div class="modal-body">
                        <div class="form-row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="cag_Descripcion" class="control-label required"></label>
                                    <input asp-for="cag_Descripcion" class="form-control" maxlength="50" id="Descripcion" />
                                    <span class="text-danger" id="messageError"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="cag_Salario" class="control-label required"></label>
                                    <input asp-for="cag_Salario" class="form-control" type="number" step="0.01" id="Salario" />
                                    <span class="text-danger" id="messageSalarioError"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <div class="switch-container">
                                        <div>
                                            <label class="switch-label">Estado</label>
                                            <div class="switch-status" id="estadoStatus">Activo</div>
                                        </div>
                                        <label class="switch">
                                            <input type="checkbox" asp-for="cag_EsActivo" id="cag_EsActivo" checked>
                                            <span class="switch-slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary px-4"></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Fin Modal Edit/Create -->

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminacion
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax="true"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="cag_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>Esta seguro de eliminar este registro?</h5>
                        <p class="text-muted">Esta accion no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.catalogs.init.js"></script>
<script>
    // Inicializar tooltips
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });

    // Switch estado activo/inactivo
    $('#cag_EsActivo').on('change', function () {
        $('#estadoStatus').text(this.checked ? 'Activo' : 'Inactivo');
    });
</script>
<script src="~/js/pages/empleado-cargo.js"></script>
<script>
    // Configuracion del DataTable
    EmpleadoCargo.datatableCatalogs({
        listUrl: "@Url.Action("List")"
    });

    Catalogs.configure({
        displayName: "cargo de empleado",
        getUrl: "@Url.Action("Find")"
    });

    // Validación de duplicados
    EmpleadosCargo.initValidation("@Url.Action("ValidarDescripcion")");

    // Busqueda global
    $('#globalSearch').on('keyup', function() {
        $('#datatable').DataTable().search(this.value).draw();
    });

    // Actualizar contadores de las cards
    function updateStatCards() {
        var table = $('#datatable').DataTable();
        var data = table.rows().data();
        var activos = 0, inactivos = 0;
        data.each(function (row) {
            if (row.esActivo && row.esActivo.toLowerCase().indexOf('activo') !== -1 && row.esActivo.toLowerCase().indexOf('inactivo') === -1) {
                activos++;
            } else {
                inactivos++;
            }
        });
        $('#count-activos').text(activos);
        $('#count-inactivos').text(inactivos);
        $('#count-total').text(data.length);
    }

    // Filtrar tabla por estado al hacer clic en card
    var currentFilter = '';
    function filterByStatus(status) {
        currentFilter = status;
        var table = $('#datatable').DataTable();
        table.column(3).search(status).draw();
        // Resaltar card activa
        $('.summary-card').removeClass('summary-card--active-green summary-card--active-red summary-card--active-purple');
        if (status === 'Activo') {
            $('#card-activos').addClass('summary-card--active-green');
        } else if (status === 'Inactivo') {
            $('#card-inactivos').addClass('summary-card--active-red');
        } else {
            $('#card-total').addClass('summary-card--active-purple');
        }
    }

    // Actualizar cards despues de que DataTable cargue los datos
    $('#datatable').on('init.dt', function () {
        updateStatCards();
    });
    $('#datatable').on('xhr.dt', function () {
        setTimeout(updateStatCards, 100);
    });


    // Exportar a PDF
    function exportPDF() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-pdf').trigger();
    }

    // Exportar a Excel
    function exportExcel() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-excel').trigger();
    }

    // Exportar a CSV (mejorado)
    function exportCSV() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();

        var csv = 'ID,Descripcion,Salario,Estado\n';
        data.each(function(row) {
            // Implementar segun estructura de datos
            console.log('Exportar CSV - Implementar segun datos');
        });

        var blob = new Blob([csv], { type: 'text/csv' });
        var url = window.URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'empleadocargo_' + new Date().toISOString().slice(0,10) + '.csv';
        a.click();
    }
</script>
}

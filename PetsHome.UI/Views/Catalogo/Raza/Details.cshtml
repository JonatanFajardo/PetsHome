@model RazaViewModel
@{
    ViewData["Title"] = "Detalles de Raza";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-paw"></i>
                        </div>
                        <div class="profile-badge">#@Model.raza_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>@Model.raza_Descripcion</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-paw"></i>
                            <span>Raza</span>
                        </div>
                        <div class="profile-meta">
                            @if (!string.IsNullOrEmpty(Model.raza_TipoAnimal))
                            {
                                <div class="profile-meta-item">
                                    @if (Model.raza_TipoAnimal.ToLower().Contains("perro"))
                                    {
                                        <i class="fas fa-dog"></i>
                                    }
                                    else if (Model.raza_TipoAnimal.ToLower().Contains("gato"))
                                    {
                                        <i class="fas fa-cat"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-paw"></i>
                                    }
                                    <span>@Model.raza_TipoAnimal</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.raza_Tamano))
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-ruler-vertical"></i>
                                    <span>@Model.raza_Tamano</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                    <button type="button" class="btn-detail btn-detail-danger" onclick="confirmDelete(@Model.raza_Id)">
                        <i class="fas fa-trash"></i>
                        <span>Eliminar</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información Principal -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información de la Raza</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-tag"></i>
                                    <span>Descripción</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.raza_Descripcion</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.raza_TipoAnimal))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-dog"></i>
                                        <span>Tipo de Animal</span>
                                    </div>
                                    <div class="detail-value">@Model.raza_TipoAnimal</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.raza_Tamano))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-ruler-vertical"></i>
                                        <span>Tamaño</span>
                                    </div>
                                    <div class="detail-value">@Model.raza_Tamano</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.raza_TipoPelaje))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-feather"></i>
                                        <span>Tipo de Pelaje</span>
                                    </div>
                                    <div class="detail-value">@Model.raza_TipoPelaje</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.raza_ImagenUrl))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-image"></i>
                                        <span>Imagen</span>
                                    </div>
                                    <div class="detail-value">
                                        <a href="@Model.raza_ImagenUrl" target="_blank" class="btn btn-sm btn-info">
                                            <i class="fas fa-external-link-alt"></i> Ver imagen
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Información de Auditoría -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-user-plus"></i>
                                    <span>Creado por</span>
                                </div>
                                <div class="detail-value">@(Model.raza_NombreUsuarioCrea ?? "Sistema")</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-calendar-plus"></i>
                                    <span>Fecha de creación</span>
                                </div>
                                <div class="detail-value">@(Model.raza_FechaCrea?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                            </div>
                            @if (Model.raza_UsuarioModifica.HasValue)
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-user-edit"></i>
                                        <span>Modificado por</span>
                                    </div>
                                    <div class="detail-value">@(Model.raza_NombreUsuarioModifica ?? "Sistema")</div>
                                </div>
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-calendar-check"></i>
                                        <span>Última modificación</span>
                                    </div>
                                    <div class="detail-value">@(Model.raza_FechaModifica?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="delete-confirm-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Remove" method="post">
                <input type="hidden" name="raza_Id" id="delete-raza-id">
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h5>¿Está seguro de eliminar la raza "@Model.raza_Descripcion"?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer justify-content-center border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            $('#delete-raza-id').val(id);
            $('#delete-confirm-modal').modal('show');
        }
    </script>
}

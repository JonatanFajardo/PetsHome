@model RazaFormViewModel
@{
    ViewData["Title"] = "Razas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header púrpura con todos los controles -->
    <div class="pets-header-full">
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fa-dog mr-2 text-white"></i>Gestión de Razas</h2>
                <button class="btn-nueva-mascota" id="add-btn" data-toggle="modal" data-target="#edit-modal">
                    <i class="fas fa-plus mr-2"></i>Nuevo Raza
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por nombre o categoría...">
                </div>
                <div class="action-buttons">
                    <div class="view-toggle">
                        <button class="btn-control active" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                    </div>
                    <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vista de Tabla -->
    <div id="tableView" class="pets-table-container">
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th>Descripción</th>
                    <th>Tipo Animal</th>
                    <th>Tamaño</th>
                    <th>Tipo Pelaje</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargará los datos aquí -->
            </tbody>
        </table>
    </div>

    <!-- Modal Edit/Create -->
    <div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"></h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Add" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="raza_Id" id="item-id" value="@ViewBag.raza_Id" />

                    <div class="modal-body">
                        <div class="form-row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="raza_Descripcion" class="control-label required"></label>
                                    <input asp-for="raza_Descripcion" class="form-control" maxlength="50" id="Descripcion" />
                                    <span class="text-danger" id="messageError"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="raza_TipoAnimal" class="control-label"></label>
                                    <select asp-for="raza_TipoAnimal" class="form-control">
                                        <option value="">Seleccione...</option>
                                        <option value="Perro">Perro</option>
                                        <option value="Gato">Gato</option>
                                        <option value="Ave">Ave</option>
                                        <option value="Conejo">Conejo</option>
                                        <option value="Roedor">Roedor</option>
                                        <option value="Reptil">Reptil</option>
                                        <option value="Otro">Otro</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="raza_Tamano" class="control-label"></label>
                                    <select asp-for="raza_Tamano" class="form-control">
                                        <option value="">Seleccione...</option>
                                        <option value="Pequeño">Pequeño</option>
                                        <option value="Mediano">Mediano</option>
                                        <option value="Grande">Grande</option>
                                        <option value="Gigante">Gigante</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="raza_TipoPelaje" class="control-label"></label>
                                    <select asp-for="raza_TipoPelaje" class="form-control">
                                        <option value="">Seleccione...</option>
                                        <option value="Corto">Corto</option>
                                        <option value="Largo">Largo</option>
                                        <option value="Rizado">Rizado</option>
                                        <option value="Sin pelo">Sin pelo</option>
                                        <option value="Semilargo">Semilargo</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="raza_ImagenUrl" class="control-label"></label>
                                    <input asp-for="raza_ImagenUrl" class="form-control" maxlength="500" placeholder="URL de la imagen" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary px-4"></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Fin Modal Edit/Create -->

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="raza_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>¿Está seguro de eliminar esta raza?</h5>
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.catalogs.init.js"></script>
<script>
    // Inicializar tooltips
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
<script src="~/js/pages/raza.js"></script>
<script>
    // Configuración del DataTable
    Raza.datatableCatalogs({
        listUrl: "@Url.Action("List")",
        detailsUrl: "@Url.Action("Details")"
    });

    // Configuración de Catalogs para el modal
    Catalogs.configure({
        displayName: "raza",
        getUrl: "@Url.Action("Find")"
    });

    // Búsqueda global
    $('#globalSearch').on('keyup', function() {
        $('#datatable').DataTable().search(this.value).draw();
    });


    // Exportar a PDF
    function exportPDF() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-pdf').trigger();
    }

    // Exportar a Excel
    function exportExcel() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-excel').trigger();
    }

    // Exportar a CSV (mejorado)
    function exportCSV() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();

        var csv = 'ID,Descripción,Tipo\n';
        data.each(function(row) {
            // Implementar según estructura de datos
            console.log('Exportar CSV - Implementar según datos');
        });

        var blob = new Blob([csv], { type: 'text/csv' });
        var url = window.URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'raza_' + new Date().toISOString().slice(0,10) + '.csv';
        a.click();
    }
</script>
}

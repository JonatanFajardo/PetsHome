@{
    ViewData["Title"] = "Control de Vacunación";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Control de vacunacion";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/control-vacunacion.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
}

<div class="col-12">
  <div class="pets-container">
    <div class="pets-header-full">
      <breadcrumb></breadcrumb>
      <div class="pets-header-content">
        <div class="pets-title-section">
          <h2 class="text-white"><i class="fas fa-syringe mr-2 text-white"></i>Control de Vacunación</h2>
        </div>
        <div class="pets-controls">
          <div class="search-container">
            <i class="fas fa-search"></i>
            <input type="text" id="searchMascota" placeholder="Buscar mascota..." oninput="applyFilters()" />
          </div>
          <div class="action-buttons">
            <select class="btn-control" id="filterEspecie" onchange="applyFilters()" style="cursor:pointer;">
              <option value="">Especie</option>
              <option value="Perro">Perros</option>
              <option value="Gato">Gatos</option>
              <option value="Conejo">Conejos</option>
            </select>
            <select class="btn-control" id="filterRefugio" onchange="applyFilters()" style="cursor:pointer;">
              <option value="">Refugio</option>
            </select>
            <select class="btn-control" id="filterVacuna" onchange="applyFilters()" style="cursor:pointer;">
              <option value="">Vacuna específica</option>
            </select>
            <button class="btn-nueva-mascota" onclick="exportPDF()">
              <i class="fas fa-file-pdf mr-1"></i>Exportar PDF
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

<!-- KPI CARDS -->
<div class="kpi-row" id="kpiRow"></div>

<!-- TABLE -->
<div class="table-wrap">
    <div class="table-toolbar">
        <div class="toolbar-title">
            <i class="bi bi-table"></i>
            Matriz de Vacunación
        </div>
        <div class="legend-group">
            <div class="legend-item">
                <div class="legend-dot ok"><i class="bi bi-check-lg"></i></div>
                Al día
            </div>
            <div class="legend-item">
                <div class="legend-dot warn"><i class="bi bi-clock"></i></div>
                Por vencer
            </div>
            <div class="legend-item">
                <div class="legend-dot red"><i class="bi bi-x-lg"></i></div>
                Vencida / Pendiente
            </div>
            <div class="legend-item">
                <div class="legend-dot na"><i class="bi bi-dash"></i></div>
                No aplica
            </div>
        </div>
    </div>

    <div class="matrix-scroll" id="matrixScroll">
        <table class="vac-matrix" id="vacMatrix">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>

    <div class="stats-footer" id="statsFooter"></div>
</div>

</div><!-- /col-12 -->

<!-- TOAST -->
<div class="toast-wrap" id="toastWrap"></div>

<!-- MODAL: Agendar vacunación -->
<div class="modal fade" id="scheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-calendar-plus"></i>
                    Agendar Vacunación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="modal-pet-info" id="modalPetInfo"></div>
                <div class="alert-vencida" id="modalAlert"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label"><i class="bi bi-person-badge"></i> Veterinario responsable</label>
                        <select class="form-select" id="modalVeterinario"></select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label"><i class="bi bi-calendar3"></i> Fecha propuesta</label>
                        <input type="date" class="form-control" id="modalDate"/>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label"><i class="bi bi-clock"></i> Hora</label>
                        <input type="time" class="form-control" value="09:00"/>
                    </div>
                    <div class="col-12">
                        <label class="form-label"><i class="bi bi-chat-left-text"></i> Observaciones</label>
                        <textarea class="form-control" rows="2" placeholder="Notas adicionales…"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-primary-custom" onclick="confirmSchedule()">
                    <i class="bi bi-check2-circle"></i> Confirmar cita
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window._urls = {
            matrizData:   '@Url.Action("MatrizData",   "ControlVacunacion")',
            refugiosList: '@Url.Action("RefugiosList", "ControlVacunacion")',
            agendarCita:  '@Url.Action("AgendarCita",  "ControlVacunacion")'
        };
    </script>
    <script src="~/js/pages/control-vacunacion.js"></script>
}

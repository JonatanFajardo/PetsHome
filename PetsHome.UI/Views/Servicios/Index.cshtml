@{
    ViewData["Title"] = "Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Listado de servicios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
        <div class="pets-header-full">
            <breadcrumb></breadcrumb>
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white"><i class="fas fa-concierge-bell mr-2 text-white"></i>Servicios</h2>
                    <button class="btn-nueva-mascota btn-insertar" id="add-btn-header"
                            onclick="window.location.href='@Url.Action("Create")'">
                        <i class="fas fa-plus mr-2"></i>Nuevo
                    </button>
                </div>
                <div class="pets-controls">
                    <div class="search-container">
                        <i class="fas fa-search"></i>
                        <input type="text" id="globalSearch" placeholder="Buscar por código, nombre o descripción...">
                    </div>
                </div>
            </div>
        </div>

        <div class="pets-table-container">
            <table class="pets-table" id="datatable">
                <thead>
                    <tr>
                        <th width="80">ID</th>
                        <th width="120">Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th width="130">Precio</th>
                        <th width="150" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Delete -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Remove" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" name="serv_Id" id="delete-item-id">
                <div class="modal-body text-center py-4">
                    <div class="mb-3"><i class="fas fa-trash-alt text-danger" style="font-size:48px;"></i></div>
                    <h5>¿Está seguro de eliminar este servicio?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window._urls = {
            urlList:   '@Url.Action("List")',
            urlDetail: '@Url.Action("Detail")',
            urlInsert: '@Url.Action("Create")',
            urlUpdate: '@Url.Action("Find")'
        };
    </script>
    <script src="~/js/components/datatable/datatable.init.js"></script>
    <script src="~/js/pages/servicios.js"></script>
    <script>
        Servicios.datatable(window._urls);

        $('#globalSearch').on('keyup', function () {
            $('#datatable').DataTable().search(this.value).draw();
        });
    </script>
}

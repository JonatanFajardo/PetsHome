@model PetsHome.Business.Models.ConsultaViewModel
@{
    ViewData["Title"] = "En Consulta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "En consulta";

    var ficha = Model.Ficha;
    var nombreMascota = Model.NombreMascota;

    string statusCss = ficha?.EstadoSalud == "En Tratamiento" ? "treatment"
                     : ficha?.EstadoSalud == "Crítico"        ? "critical"
                                                              : "healthy";
    string statusLabel = ficha?.EstadoSalud ?? "Saludable";
}

@section Styles {
    <link rel="stylesheet" href="~/css/perfil-medico-mascota.css" />
    <link rel="stylesheet" href="~/css/search-select.css" />
    <link rel="stylesheet" href="~/css/en-consulta.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        .app-wrapper { min-height: auto; }
        .pets-container { margin-bottom: 14px; }
    </style>
}

@Html.AntiForgeryToken()

@if (!Model.SinPaciente)
{
<div class="col-12">
    <div class="pets-container">
        <div class="pets-header-full">
            <breadcrumb></breadcrumb>
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white"><i class="bi bi-clipboard2-pulse mr-2 text-white"></i>En Consulta — @nombreMascota</h2>
                </div>
                <div class="pets-controls ec-topbar">
                    <div class="ec-search">
                        <i class="bi bi-search"></i>
                        <input type="text" id="ecMascSearch" placeholder="Buscar otro paciente..." autocomplete="off" />
                        <div id="ecMascResults" class="ec-search-results"></div>
                    </div>
                    <button type="button" id="btnFinalizar" class="ec-btn-finalizar">
                        <i class="bi bi-check2-circle"></i> Finalizar consulta
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-12" style="padding:0">
    <div class="consulta-wrap">

        <!-- ════════════ IZQUIERDA: PACIENTE ════════════ -->
        <div>
            <div class="ec-card">
                <div class="ec-pet-head">
                    <div class="ec-pet-avatar">🐾</div>
                    <div class="ec-pet-name">@nombreMascota</div>
                    <div class="ec-pet-meta">
                        @ficha?.Raza · @ficha?.Edad<br />
                        @ficha?.Sexo · @(ficha?.EsEsterilizada == true ? "Esterilizado/a" : "No esterilizado/a")
                    </div>
                    <span class="ec-status @statusCss">@statusLabel</span>
                </div>

                <div class="ec-divider"></div>

                @{
                    var respTipo = ficha?.ResponsableTipo;
                    var respNombre = ficha?.ResponsableNombre;
                    var respContacto = ficha?.ResponsableContacto;
                    bool esInterno = string.Equals(respTipo, "Interno", StringComparison.OrdinalIgnoreCase);
                }
                <div class="ec-responsable @(esInterno ? "interno" : "cliente")">
                    @if (esInterno)
                    {
                        <div class="ec-resp-head">🏠 Paciente interno</div>
                        <div class="ec-resp-name">@(string.IsNullOrWhiteSpace(respNombre) ? "Refugio / Rescate" : respNombre)</div>
                        @if (!string.IsNullOrWhiteSpace(respContacto))
                        {
                            <div class="ec-resp-contact"><i class="bi bi-telephone"></i> @respContacto</div>
                        }
                    }
                    else
                    {
                        <div class="ec-resp-head">👤 Dueño</div>
                        <div class="ec-resp-name">@(string.IsNullOrWhiteSpace(respNombre) ? "Sin dueño registrado" : respNombre)</div>
                        @if (!string.IsNullOrWhiteSpace(respContacto))
                        {
                            <div class="ec-resp-contact"><i class="bi bi-telephone"></i> @respContacto</div>
                        }
                    }
                </div>

                <div class="ec-card-title"><i class="bi bi-card-list"></i> Ficha</div>
                <div class="ec-ficha-row">
                    <div><b>Microchip</b> · @(ficha?.Microchip ?? "N/A")</div>
                    <div><b>Peso</b> · @(ficha?.Peso?.ToString("0.##") ?? "—") kg</div>
                    <div><b>Refugio</b> · @(ficha?.Refugio ?? "—")</div>
                    <div><b>Último control</b> · @(ficha?.UltimaVisita?.ToString("dd MMM yyyy") ?? "—")</div>
                    <div><b>Total citas</b> · @(ficha?.TotalCitas ?? 0)</div>
                </div>
            </div>

            <div class="ec-card">
                <div class="ec-card-title"><i class="bi bi-clock-history"></i> Historial rápido</div>
                @if (Model.Perfil.UltimasCitas.Any())
                {
                    foreach (var c in Model.Perfil.UltimasCitas)
                    {
                        <div class="ec-hist-item">
                            <div class="ec-hist-dot"><i class="bi bi-stethoscope"></i></div>
                            <div class="ec-hist-txt">
                                <div class="ec-hist-evt">@c.TipoConsulta</div>
                                <div class="ec-hist-date">@c.cita_FechaConsulta.ToString("dd MMM yyyy") · @c.Veterinario</div>
                                @if (!string.IsNullOrEmpty(c.cita_Diagnostico))
                                {
                                    <div class="ec-hist-date">@c.cita_Diagnostico</div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="ec-empty-line">Sin citas previas registradas.</div>
                }
            </div>
        </div>

        <!-- ════════════ CENTRO: FLUJO DE TRABAJO ════════════ -->
        <div>
            <!-- ① Motivo / Tipo de consulta -->
            <div class="ec-card">
                <div class="ec-step"><span class="ec-step-num">1</span> Motivo y tipo de consulta</div>
                <div class="ec-field">
                    <label class="ec-label">Tipo de consulta</label>
                    <select id="ecTipoConsulta" class="ec-select">
                        <option value="">Seleccione...</option>
                        @foreach (var t in Model.TiposConsulta)
                        {
                            <option value="@t.tipoCon_Id">@t.tipoCon_Descripcion</option>
                        }
                    </select>
                </div>
                <div class="ec-field" style="margin-bottom:0">
                    <label class="ec-label">Motivo de la consulta</label>
                    <textarea id="ecMotivo" class="ec-textarea" placeholder="Describe el motivo de la visita..."></textarea>
                </div>
            </div>

            <!-- ② Signos vitales -->
            <div class="ec-card">
                <div class="ec-step"><span class="ec-step-num">2</span> Signos vitales</div>
                <div class="ec-grid-2">
                    <div class="ec-field ec-vital" style="margin-bottom:0">
                        <label class="ec-label">Peso</label>
                        <input type="number" step="0.01" min="0" id="ecPeso" class="ec-input"
                               value="@(ficha?.Peso?.ToString("0.##") ?? "")" placeholder="0.00" />
                        <span class="ec-unit">kg</span>
                    </div>
                    <div class="ec-field ec-vital" style="margin-bottom:0">
                        <label class="ec-label">Temperatura</label>
                        <input type="number" step="0.1" min="0" id="ecTemperatura" class="ec-input" placeholder="38.5" />
                        <span class="ec-unit">°C</span>
                    </div>
                </div>
            </div>

            <!-- ③ Diagnóstico -->
            <div class="ec-card">
                <div class="ec-step"><span class="ec-step-num">3</span> Diagnóstico</div>
                <textarea id="ecDiagnostico" class="ec-textarea" placeholder="Diagnóstico y observaciones clínicas..."></textarea>
                <div id="ecSugerencias" class="ec-sug" style="display:none"></div>
            </div>

            <!-- ④ Recetar / Aplicar -->
            <div class="ec-card">
                <div class="ec-step"><span class="ec-step-num">4</span> Recetar y aplicar</div>

                <div class="ec-field">
                    <label class="ec-label">Medicamentos recetados</label>
                    <div id="ecMedSelect"></div>
                    <div class="ec-lines" id="ecMedLines">
                        <div class="ec-empty-line">Aún no has agregado medicamentos.</div>
                    </div>
                </div>

                <div class="ec-field" style="margin-bottom:0">
                    <label class="ec-label">Vacuna aplicada</label>
                    <div id="ecVacSelect"></div>
                    <div class="ec-lines" id="ecVacLines">
                        <div class="ec-empty-line">Ninguna vacuna aplicada en esta consulta.</div>
                    </div>
                </div>
            </div>

            <!-- ⑤ Próxima cita -->
            <div class="ec-card">
                <div class="ec-step"><span class="ec-step-num">5</span> Próxima cita</div>
                <div class="ec-grid-2">
                    <div class="ec-field" style="margin-bottom:0">
                        <label class="ec-label">Fecha de seguimiento</label>
                        <input type="date" id="ecProximaCita" class="ec-input" />
                    </div>
                    <div class="ec-field" style="margin-bottom:0">
                        <label class="ec-label">Motivo del seguimiento</label>
                        <input type="text" id="ecMotivoProxima" class="ec-input" placeholder="Control, refuerzo..." />
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════ DERECHA: BANDERAS ROJAS + ACCIONES ════════════ -->
        <div>
            <div class="ec-card">
                <div class="ec-card-title"><i class="bi bi-flag-fill" style="color:#DC2626"></i> Banderas rojas</div>

                @if (Model.MedicamentosActivos.Any())
                {
                    foreach (var m in Model.MedicamentosActivos)
                    {
                        <div class="ec-flag warn">
                            <span class="ec-flag-ico"><i class="bi bi-capsule"></i></span>
                            <div class="ec-flag-txt">
                                <div class="ec-flag-title">Medicamento activo: @m.Medicamento</div>
                                <div class="ec-flag-sub">
                                    @m.Dosis
                                    @if (m.DiasRestantes.HasValue) { <text> · @m.DiasRestantes día(s) restante(s)</text> }
                                </div>
                            </div>
                        </div>
                    }
                }

                @if (Model.VacunasVencidas.Any())
                {
                    foreach (var v in Model.VacunasVencidas)
                    {
                        <div class="ec-flag">
                            <span class="ec-flag-ico"><i class="bi bi-shield-exclamation"></i></span>
                            <div class="ec-flag-txt">
                                <div class="ec-flag-title">Vacuna vencida: @v.VacunaNombre</div>
                                <div class="ec-flag-sub">Requiere refuerzo · aplicada @(v.FechaAplicada?.ToString("dd MMM yyyy") ?? "—")</div>
                            </div>
                        </div>
                    }
                }

                @if (Model.TotalBanderasRojas == 0)
                {
                    <div class="ec-flag-none"><i class="bi bi-check-circle-fill"></i> Sin medicamentos activos ni vacunas vencidas.</div>
                }

                @* Alergias y enfermedades crónicas: tbMascotas no tiene estos campos hoy. *@
                @* TODO: requiere campo nuevo en tbMascotas para registrar alergias/crónicas. *@
                <div class="ec-divider"></div>
                <div class="ec-flag-none" style="background:#F9FAFB;border-color:#E5E7EB;color:#6B7280">
                    <i class="bi bi-info-circle"></i> Sin alergias registradas
                </div>
            </div>

            <div class="ec-card">
                <div class="ec-card-title"><i class="bi bi-lightning-charge-fill"></i> Acciones rápidas</div>
                <button type="button" class="ec-action" id="btnAgendarSeguimiento">
                    <i class="bi bi-calendar-plus"></i> Agendar seguimiento
                </button>
                <button type="button" class="ec-action" id="btnGenerarReceta">
                    <i class="bi bi-file-earmark-medical"></i> Generar receta
                </button>
            </div>
        </div>

    </div>
</div>
}
else
{
    <div class="col-12">
        <div class="pets-container">
            <div class="pets-header-full">
                <breadcrumb></breadcrumb>
                <div class="pets-header-content">
                    <div class="pets-title-section">
                        <h2 class="text-white"><i class="bi bi-clipboard2-pulse mr-2 text-white"></i>En Consulta</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12" style="padding:0">
        <div class="ec-empty-wrap">
            <div class="ec-empty-card">
                <div class="ec-empty-icon">🐾</div>
                <h2 class="ec-empty-title">Ningún paciente en consulta</h2>

                @if (Model.SalaEspera != null && Model.SalaEspera.Any())
                {
                    <p class="ec-empty-sub">Elige a quién atender:</p>
                    <div class="ec-queue">
                        @{
                            int turno = 0;
                        }
                        @foreach (var p in Model.SalaEspera)
                        {
                            turno++;
                            var prio = (p.Prioridad ?? "Normal");
                            var prioCls = prio.Equals("Urgente", StringComparison.OrdinalIgnoreCase) ? "urgente"
                                        : prio.Equals("Alta", StringComparison.OrdinalIgnoreCase) ? "alta"
                                        : "normal";
                            <div class="ec-queue-card prio-@prioCls">
                                <div class="ec-queue-turno">#@turno</div>
                                <div class="ec-queue-body">
                                    <div class="ec-queue-head">
                                        <span class="ec-queue-masc">@p.MascotaNombre</span>
                                        <span class="ec-queue-prio prio-@prioCls">@prio</span>
                                    </div>
                                    <div class="ec-queue-dueno">
                                        @if (p.EsInterno)
                                        {
                                            <span>🏠 Interno</span>
                                        }
                                        else
                                        {
                                            <span>👤 @(string.IsNullOrWhiteSpace(p.DuenoNombre) ? "Sin dueño" : p.DuenoNombre)</span>
                                        }
                                    </div>
                                    <div class="ec-queue-meta">
                                        @if (!string.IsNullOrWhiteSpace(p.TipoConsulta))
                                        {
                                            <span class="ec-queue-tag"><i class="bi bi-clipboard2-pulse"></i> @p.TipoConsulta</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.Motivo))
                                        {
                                            <span class="ec-queue-motivo">@p.Motivo</span>
                                        }
                                        <span class="ec-queue-espera"><i class="bi bi-clock"></i> @p.MinutosEspera min esperando</span>
                                    </div>
                                </div>
                                <button type="button" class="ec-queue-atender"
                                        data-cita="@p.CitaId" data-masc="@p.MascId">
                                    <i class="bi bi-play-circle"></i> Atender
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="ec-empty-sub">No hay pacientes en espera. Busca un expediente o registra uno nuevo.</p>
                }

                <div class="ec-empty-tools">
                    <div class="ec-empty-search">
                        <i class="bi bi-search"></i>
                        <input type="text" id="ecEmptySearch" placeholder="Buscar expediente de paciente..." autocomplete="off" />
                        <div id="ecEmptyResults" class="ec-search-results"></div>
                    </div>
                    <a class="ec-empty-nuevo" href="@Url.Action("Create", "Mascota")">
                        <i class="bi bi-plus-circle"></i> Registrar nuevo paciente
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/components/search-select.js"></script>
    <script>
        window._urls = {
            guardar: '@Url.Action("Guardar", "Consulta")',
            consultaIndex: '@Url.Action("Index", "Consulta")',
            buscarMascota: '@Url.Action("Search", "Mascota")',
            crearMascota: '@Url.Action("Create", "Mascota")',
            atender: '@Url.Action("Atender", "Consulta")',
            crearCita: '@Url.Action("Create", "CitaMedica")',
            sugerencias: '@Url.Action("Sugerencias", "Lookup")'
        };
        window._mascId = @Model.MascId;
        window._citaId = @(Context.Request.Query["citaId"].ToString() is var q && int.TryParse(q, out var _ci) ? _ci : 0);
    </script>
    <script src="~/js/pages/en-consulta.js"></script>
}

@model RecetaDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Receta";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Determinar estado de la receta
    var estado = Model.receta_Estado ?? "Activa";
    var estadoColor = estado switch
    {
        "Activa" => "status-activo",
        "Completada" => "status-adoptado",
        "Cancelada" => "status-inactivo",
        _ => "status-activo"
    };
    var estadoIcono = estado switch
    {
        "Activa" => "fa-check-circle",
        "Completada" => "fa-calendar-check",
        "Cancelada" => "fa-times-circle",
        _ => "fa-check-circle"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
    <link rel="stylesheet" href="~/css/receta-dosis.css" />
}

<div class="col-12">
    <div class="detail-container">
        <!-- Header con gradiente y foto de perfil -->
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-prescription-bottle-alt"></i>
                        </div>
                        <div class="profile-badge">#@Model.receta_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>@Model.receta_Medicamento</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-paw"></i>
                            <span>@Model.masc_Nombre</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas @estadoIcono"></i>
                                <span>@estado</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.TipoMedicamento))
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-pills"></i>
                                    <span>@Model.TipoMedicamento</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ViaAdministracion))
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-syringe"></i>
                                    <span>@Model.ViaAdministracion</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("Index", "PerfilMedico", new { mascId = Model.masc_Id })" class="btn-detail btn-detail-white" style="background:#E8F5E9;color:#2E7D32;border-color:#2E7D32">
                        <i class="fas fa-stethoscope"></i>
                        <span>Perfil Médico</span>
                    </a>
                    <a href="@Url.Action("Find", new { id = Model.receta_Id })" class="btn-detail btn-detail-white">
                        <i class="fas fa-edit"></i>
                        <span>Editar</span>
                    </a>
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                    <button type="button" class="btn-detail btn-detail-danger" onclick="confirmDelete(@Model.receta_Id)">
                        <i class="fas fa-trash"></i>
                        <span>Eliminar</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información del Medicamento -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-pills"></i>
                        <h3>Información del Medicamento</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-prescription-bottle"></i>
                                    <span>Medicamento</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.receta_Medicamento</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.TipoMedicamento))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-capsules"></i>
                                        <span>Tipo de Medicamento</span>
                                    </div>
                                    <div class="detail-value">@Model.TipoMedicamento</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.ViaAdministracion))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-syringe"></i>
                                        <span>Vía de Administración</span>
                                    </div>
                                    <div class="detail-value">@Model.ViaAdministracion</div>
                                </div>
                            }

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-toggle-on"></i>
                                    <span>Estado</span>
                                </div>
                                <div class="detail-value">
                                    <span class="status-badge @estadoColor">@estado</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información de Dosificación -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-flask"></i>
                        <h3>Dosificación</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            @if (!string.IsNullOrEmpty(Model.receta_Dosis))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-weight"></i>
                                        <span>Dosis</span>
                                    </div>
                                    <div class="detail-value detail-value-large">@Model.receta_Dosis</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.receta_Frecuencia))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-clock"></i>
                                        <span>Frecuencia</span>
                                    </div>
                                    <div class="detail-value">@Model.receta_Frecuencia</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.receta_Duracion))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-calendar-alt"></i>
                                        <span>Duración</span>
                                    </div>
                                    <div class="detail-value">@Model.receta_Duracion</div>
                                </div>
                            }

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-sync-alt"></i>
                                    <span>Resurtidos</span>
                                </div>
                                <div class="detail-value">
                                    <div class="resurtidos-box">
                                        <span class="resurtidos-badge @(Model.ResurtidosUsados < Model.ResurtidosAutorizados ? "" : "agotado")" id="resurtidosBadge">
                                            <i class="fas fa-sync-alt"></i>
                                            <span id="resurtidosTexto">@Model.ResurtidosUsados de @Model.ResurtidosAutorizados usados</span>
                                        </span>
                                        <button type="button" class="btn btn-primary btn-sm" id="btnResurtir"
                                                style="@(Model.ResurtidosUsados < Model.ResurtidosAutorizados ? "" : "display:none;")">
                                            <i class="fas fa-redo mr-1"></i> Resurtir
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-paw"></i>
                                    <span>Mascota</span>
                                </div>
                                <div class="detail-value">@Model.masc_Nombre</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.receta_FechaInicio.HasValue || Model.receta_FechaFin.HasValue)
                {
                    <!-- Fechas del Tratamiento -->
                    <div class="detail-card detail-card-full">
                        <div class="detail-card-header">
                            <i class="fas fa-calendar"></i>
                            <h3>Período del Tratamiento</h3>
                        </div>
                        <div class="detail-card-body">
                            <div class="detail-list">
                                <div class="row">
                                    @if (Model.receta_FechaInicio.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <div class="detail-label">
                                                    <i class="fas fa-calendar-plus"></i>
                                                    <span>Fecha de Inicio</span>
                                                </div>
                                                <div class="detail-value">@Model.receta_FechaInicio.Value.ToString("dd/MM/yyyy")</div>
                                            </div>
                                        </div>
                                    }
                                    @if (Model.receta_FechaFin.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <div class="detail-label">
                                                    <i class="fas fa-calendar-check"></i>
                                                    <span>Fecha de Fin</span>
                                                </div>
                                                <div class="detail-value">@Model.receta_FechaFin.Value.ToString("dd/MM/yyyy")</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.receta_Instrucciones))
                {
                    <!-- Instrucciones -->
                    <div class="detail-card detail-card-full">
                        <div class="detail-card-header">
                            <i class="fas fa-file-alt"></i>
                            <h3>Instrucciones</h3>
                        </div>
                        <div class="detail-card-body">
                            <div class="detail-list">
                                <div class="detail-item">
                                    <div class="detail-value">@Model.receta_Instrucciones</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Información de Auditoría -->
                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Creado por</span>
                                        </div>
                                        <div class="detail-value">@(!string.IsNullOrEmpty(Model.receta_NombreUsuarioCrea) ? Model.receta_NombreUsuarioCrea : $"Usuario ID: {Model.receta_UsuarioCrea}")</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-calendar-plus"></i>
                                            <span>Fecha de creación</span>
                                        </div>
                                        <div class="detail-value">@Model.receta_FechaCrea.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                                @if (Model.receta_UsuarioModifica.HasValue)
                                {
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-user-edit"></i>
                                                <span>Modificado por</span>
                                            </div>
                                            <div class="detail-value">@(!string.IsNullOrEmpty(Model.receta_NombreUsuarioModifica) ? Model.receta_NombreUsuarioModifica : $"Usuario ID: {Model.receta_UsuarioModifica}")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-calendar-check"></i>
                                                <span>Última modificación</span>
                                            </div>
                                            <div class="detail-value">@(Model.receta_FechaModifica?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="delete-confirm-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Remove" method="post">
                <input type="hidden" name="receta_Id" id="delete-receta-id">
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h5>¿Está seguro de eliminar la receta de @Model.receta_Medicamento?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window._urls = { resurtir: '@Url.Action("Resurtir", "Receta")' };
        var _recetaId = @Model.receta_Id;

        function confirmDelete(id) {
            $('#delete-receta-id').val(id);
            $('#delete-confirm-modal').modal('show');
        }

        (function () {
            var btn = document.getElementById('btnResurtir');
            if (!btn) return;

            function hacerResurtido() {
                btn.disabled = true;
                var original = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Resurtiendo...';

                window.postForm(window._urls.resurtir, { recetaId: _recetaId })
                    .then(function (res) {
                        if (res && res.ok) {
                            // Actualizar el conteo en pantalla con lo que devuelve el backend.
                            var txt = document.getElementById('resurtidosTexto');
                            if (txt) txt.textContent = res.usados + ' de ' + res.autorizados + ' usados';
                            var badge = document.getElementById('resurtidosBadge');
                            if (res.usados >= res.autorizados) {
                                if (badge) badge.classList.add('agotado');
                                btn.style.display = 'none';
                            }
                            if (window.Swal) {
                                Swal.fire({ icon: 'success', title: 'Resurtido registrado', text: res.mensaje || '', timer: 1800, showConfirmButton: false });
                            } else {
                                alert(res.mensaje || 'Resurtido registrado');
                            }
                        } else {
                            btn.disabled = false; btn.innerHTML = original;
                            var msg = (res && res.mensaje) ? res.mensaje : 'No se pudo resurtir la receta.';
                            if (window.Swal) { Swal.fire({ icon: 'error', title: 'Error', text: msg }); }
                            else { alert(msg); }
                        }
                    })
                    .catch(function () {
                        btn.disabled = false; btn.innerHTML = original;
                        if (window.Swal) { Swal.fire({ icon: 'error', title: 'Error', text: 'Error de conexion.' }); }
                        else { alert('Error de conexion.'); }
                    });
            }

            btn.addEventListener('click', function () {
                if (window.Swal) {
                    Swal.fire({
                        icon: 'question',
                        title: 'Resurtir receta',
                        text: 'Se registrara una nueva entrega de esta receta. Continuar?',
                        showCancelButton: true,
                        confirmButtonText: 'Si, resurtir',
                        cancelButtonText: 'Cancelar'
                    }).then(function (r) { if (r.isConfirmed) hacerResurtido(); });
                } else if (confirm('Se registrara una nueva entrega de esta receta. Continuar?')) {
                    hacerResurtido();
                }
            });
        })();
    </script>
}

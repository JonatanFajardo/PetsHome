@model SustanciaControladaIndexViewModel
@{
    ViewData["Title"] = "Sustancias controladas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Sustancias controladas";
    ViewData["UseDatatableInit"] = true;
    ViewData["UsePdfExport"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
        <!-- Header -->
        <div class="pets-header-full">
            <breadcrumb></breadcrumb>
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white"><i class="fas fa-prescription-bottle-medical mr-2 text-white"></i>Sustancias controladas</h2>
                    <button class="btn-nueva-mascota btn-insertar"
                            onclick="window.location.href='@Url.Action("Create")'">
                        <i class="fas fa-plus mr-2"></i>Registrar movimiento
                    </button>
                </div>
                <p class="text-white mb-0 mt-2" style="opacity:0.9;">
                    Bitácora regulatoria: cada entrada, administración, desecho o devolución de fármacos controlados queda registrada con su testigo y paciente.
                </p>
            </div>
        </div>

        <!-- Resumen de saldos por fármaco -->
        <div class="pets-table-container" style="margin-bottom:20px;">
            <h4 style="padding:14px 18px 0;color:#6b21a8;font-weight:700;">
                <i class="fas fa-scale-balanced mr-2"></i>Saldo por fármaco
            </h4>
            <table class="pets-table">
                <thead>
                    <tr>
                        <th>Fármaco</th>
                        <th width="90" class="text-center">DEA</th>
                        <th width="110" class="text-right">Recibido</th>
                        <th width="110" class="text-right">Devuelto</th>
                        <th width="120" class="text-right">Administrado</th>
                        <th width="110" class="text-right">Desechado</th>
                        <th width="120" class="text-right">Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Saldos == null || Model.Saldos.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Aún no hay movimientos registrados.</td></tr>
                    }
                    else
                    {
                        foreach (var s in Model.Saldos)
                        {
                            <tr>
                                <td><i class="fas fa-pills mr-2" style="color:#7c3aed;"></i><strong>@s.Farmaco</strong> <span class="text-muted">(@s.itm_Codigo)</span></td>
                                <td class="text-center">@(string.IsNullOrEmpty(s.DeaSchedule) ? "—" : s.DeaSchedule)</td>
                                <td class="text-right">@s.TotalRecibido.ToString("0.###")</td>
                                <td class="text-right">@s.TotalDevuelto.ToString("0.###")</td>
                                <td class="text-right">@s.TotalAdministrado.ToString("0.###")</td>
                                <td class="text-right">@s.TotalDesechado.ToString("0.###")</td>
                                <td class="text-right">
                                    <span style="font-weight:700;padding:3px 10px;border-radius:12px;@(s.Saldo <= 0 ? "background:#fee2e2;color:#991b1b;" : "background:#dcfce7;color:#166534;")">
                                        @s.Saldo.ToString("0.###")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Bitácora de movimientos -->
        <div class="pets-controls" style="padding:0 4px 10px;">
            <div class="search-container">
                <i class="fas fa-search"></i>
                <input type="text" id="globalSearch" placeholder="Buscar por fármaco, tipo, paciente o testigo...">
            </div>
            <div class="action-buttons">
                <button class="btn-export-datatable" onclick="location.reload()">Recargar</button>
                <div id="export-buttons-container" class="export-buttons-container"></div>
            </div>
        </div>

        <div class="pets-table-container">
            <table class="pets-table" id="datatable">
                <thead>
                    <tr>
                        <th width="60">ID</th>
                        <th>Fármaco</th>
                        <th width="130">Movimiento</th>
                        <th width="100" class="text-right">Cantidad</th>
                        <th>Paciente</th>
                        <th>Testigo</th>
                        <th width="150">Fecha</th>
                        <th width="90" class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Modal anular -->
        <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i>Anular movimiento</h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <form asp-action="Remove" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scm_Id" id="delete-item-id">
                        <div class="modal-body text-center py-4">
                            <div class="mb-3"><i class="fas fa-trash-alt text-danger" style="font-size:48px;"></i></div>
                            <h5>¿Anular este movimiento?</h5>
                            <p class="text-muted">Se marca como anulado y deja de contar para el saldo. Por auditoría no se borra físicamente.</p>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                                <i class="fas fa-times mr-2"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash mr-2"></i>Anular
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.init.js"></script>
<script src="~/js/pages/sustancias-controladas.js"></script>
<script>
    window._urls = {
        list:   '@Url.Action("List")',
        detail: '@Url.Action("Detail")',
        remove: '@Url.Action("Remove")'
    };

    SustanciasControladas.datatable({
        urlList:   "@Url.Action("List")",
        urlDetail: "@Url.Action("Detail")"
    });

    $('#globalSearch').on('keyup', function () {
        $('#datatable').DataTable().search(this.value).draw();
    });
</script>
}

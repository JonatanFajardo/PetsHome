@model ConsentimientoFormViewModel
@{
    ViewData["Title"] = Model.isEdit ? "Editar consentimiento" : "Nuevo consentimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["UseFormValidation"] = true;
    ViewData["CurrentPantalla"] = "Listado de consentimientos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">

        <div class="pets-header-full">
            <breadcrumb></breadcrumb>
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white">
                        <i class="fas fa-file-signature mr-2 text-white"></i>@(Model.isEdit ? "Editar consentimiento" : "Nuevo consentimiento")
                    </h2>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Index")'">
                        <i class="fas fa-arrow-left mr-2"></i>Volver al Listado
                    </button>
                </div>
                <p class="text-white mb-0 mt-2" style="opacity:0.9;">
                    @(Model.isEdit ? "Actualice la autorización mientras siga pendiente de firma" : "El dueño autoriza un procedimiento; luego se registra su firma desde el detalle")
                </p>
            </div>
        </div>

        <div class="pets-body-full">
            <div class="container-fluid">
                <form asp-action="Add" asp-controller="Consentimiento" method="post" autocomplete="off" id="consForm">
                    <input asp-for="cons_Id" type="hidden" />
                    <input asp-for="cita_Id" type="hidden" />

                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title">Datos del consentimiento</h2>
                            <p class="card-description">Mascota, tipo de procedimiento y texto que el dueño autoriza</p>
                        </div>
                        <div class="card-content">
                            <div class="form-grid">

                                <div class="form-group">
                                    <label asp-for="masc_Id">Mascota <span class="required">*</span></label>
                                    <select class="form-control" asp-for="masc_Id">
                                        <option value="">-- Seleccione --</option>
                                        @foreach (var m in Model.MascotaList)
                                        {
                                            <option value="@m.masc_Id">@m.masc_Nombre</option>
                                        }
                                    </select>
                                    <span class="text-danger" asp-validation-for="masc_Id"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="cons_Tipo">Tipo de consentimiento <span class="required">*</span></label>
                                    <select class="form-control" asp-for="cons_Tipo" asp-items="Model.TipoList" id="cons_Tipo">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                    <span class="text-danger" asp-validation-for="cons_Tipo"></span>
                                </div>

                                <div class="form-group" style="grid-column:1 / -1;">
                                    <label asp-for="cons_Texto">
                                        Texto del consentimiento <span class="required">*</span>
                                        <button type="button" class="btn btn-outline btn-sm ml-2" id="btnPlantilla" style="padding:2px 10px;font-size:12px;">
                                            <i class="fas fa-wand-magic-sparkles mr-1"></i>Usar plantilla del tipo
                                        </button>
                                    </label>
                                    <textarea class="form-control" asp-for="cons_Texto" rows="8" placeholder="Declaración que el dueño autoriza y firma..."></textarea>
                                    <span class="text-danger" asp-validation-for="cons_Texto"></span>
                                </div>

                                <div class="form-group" style="grid-column:1 / -1;">
                                    <label asp-for="cons_Notas">Notas internas</label>
                                    <textarea class="form-control" asp-for="cons_Notas" rows="2" placeholder="Notas internas (no forman parte de la autorización)"></textarea>
                                    <span class="text-danger" asp-validation-for="cons_Notas"></span>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn btn-outline" asp-action="Index">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-content-save"></i> @(Model.isEdit ? "Actualizar" : "Guardar")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Plantillas simples por tipo (v1: texto libre, estas solo pre-llenan).
        var PLANTILLAS = {
            'General': 'Yo, en calidad de responsable de la mascota, autorizo al personal veterinario a realizar el examen clínico, los procedimientos diagnósticos y el tratamiento que consideren necesarios para su atención. Declaro haber sido informado/a de los riesgos y acepto proceder.',
            'Cirugia': 'Autorizo la intervención quirúrgica de mi mascota. Comprendo que toda cirugía conlleva riesgos y que pueden surgir complicaciones imprevistas. Autorizo al equipo veterinario a tomar las decisiones que consideren necesarias durante el procedimiento para preservar la vida y el bienestar del animal.',
            'Anestesia': 'Autorizo la administración de anestesia a mi mascota. He sido informado/a de que la anestesia implica riesgos, incluso en pacientes aparentemente sanos, y acepto dichos riesgos para permitir el procedimiento indicado.',
            'Eutanasia': 'Autorizo la eutanasia humanitaria de mi mascota. Declaro haber sido informado/a sobre el estado de salud del animal y sobre el procedimiento, y tomo esta decisión de forma libre y consciente.'
        };

        $(function () {
            $("#consForm").validate({
                rules: {
                    masc_Id: { required: true },
                    cons_Tipo: { required: true },
                    cons_Texto: { required: true }
                }
            });

            function aplicarPlantilla(force) {
                var tipo = $('#cons_Tipo').val();
                var txt = PLANTILLAS[tipo];
                if (!txt) return;
                var actual = $('#cons_Texto').val();
                if (force || !actual || actual.trim() === '') {
                    $('#cons_Texto').val(txt);
                }
            }

            $('#btnPlantilla').on('click', function () { aplicarPlantilla(true); });
            // Al elegir el tipo, sugiere la plantilla si el texto está vacío.
            $('#cons_Tipo').on('change', function () { aplicarPlantilla(false); });
        });
    </script>
}

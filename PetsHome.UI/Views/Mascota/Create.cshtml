@model MascotaViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" id="formulario">
    <form asp-action="Add" asp-controller="Mascota" method="post" autocomplete="ON" enctype="multipart/form-data">
        <input class="form-control" asp-for="masc_Id" type="hidden" />

        <!-- Información Básica -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-info text-white d-flex align-items-center">
                <i class="fas fa-info-circle fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información Básica</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Nombre">Nombre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                <input class="form-control" asp-for="masc_Nombre" type="text" placeholder="Nombre de la mascota" />
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Nombre"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="raza_Id">Raza</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-dog"></i></span>
                                <select class="form-control" asp-for="raza_Id" asp-items="Model.razaList">
                                    <option value="">-- Seleccionar Raza --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="raza_Id"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Edad">Edad</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                <input class="form-control" asp-for="masc_Edad" type="number" min="0" placeholder="Edad en años" />
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Edad"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Sexo">Sexo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-venus-mars"></i></span>
                                <select class="form-control" asp-for="masc_Sexo" asp-items="Model.sexoList">
                                    <option value="">-- Seleccionar Sexo --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Sexo"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Color">Color</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-palette"></i></span>
                                <input class="form-control" asp-for="masc_Color" type="text" placeholder="Color del pelaje" />
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Color"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Historia">Historia</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-history"></i></span>
                                <input class="form-control" asp-for="masc_Historia" type="text" placeholder="Historia de la mascota" />
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Historia"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Características Físicas -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-vitals text-white d-flex align-items-center">
                <i class="fas fa-ruler-combined fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Características Físicas</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Peso">Peso (kg)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-weight"></i></span>
                                <input class="form-control" asp-for="masc_Peso" type="number" min="0" step="0.1" placeholder="0.0" />
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Peso"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="masc_Talla">Talla (cm)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-ruler-vertical"></i></span>
                                <input class="form-control" asp-for="masc_Talla" type="number" min="0" placeholder="0" />
                            </div>
                            <span class="text-danger" asp-validation-for="masc_Talla"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Imagen de Perfil -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-treatment text-white d-flex align-items-center">
                <i class="fas fa-camera fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Imagen de Perfil</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="ImageFile">Seleccionar Imagen</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-image"></i></span>
                                <input asp-for="ImageFile" type="file" class="form-control" onchange="previewFile()" id="file" accept="image/png, image/jpeg, image/gif" />
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                            <small class="form-text text-muted">Seleccione una imagen (.jpg, .png) con un tamaño menor de 2 MB (2,048 KB).</small>
                        </div>
                    </div>
                    <div class="col-md-12 text-center">
                        <img src="@ViewBag.ImageFile" class="img-fluid rounded-circle shadow" style="max-height: 200px; max-width: 200px;" alt="Vista previa de imagen" id="img">
                        <input type="hidden" asp-for="masc_Imagen" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Refugio -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-appointment text-white d-flex align-items-center">
                <i class="fas fa-home fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información de Refugio</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Id">Refugio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-building"></i></span>
                                <select class="form-control" asp-for="refg_Id" asp-items="Model.refugioList">
                                    <option value="">-- Seleccionar Refugio --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Id"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="proc_Id">Procedencia</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                <select class="form-control" asp-for="proc_Id" asp-items="Model.procedenciaList">
                                    <option value="">-- Seleccionar Procedencia --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="proc_Id"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="actions-wrapper">
            <div class="actions-title">Acciones</div>
            <div class="actions-divider"></div>
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">* Los cambios se guardarán permanentemente</small>
                <div class="d-flex">
                    <a class="btn btn-modern btn-outline-cancel mr-3" asp-action="Index">
                        <i class="fas fa-times btn-icon"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-modern btn-solid-save">
                        <i class="fas fa-check btn-icon"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts{
    <script src="~/js/load-dropdownlist.js"></script>
    <script src="~/js/helpers-custom/image-Extension.js"></script>
}
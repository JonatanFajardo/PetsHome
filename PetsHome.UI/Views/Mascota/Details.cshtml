@model MascotaViewModel
@{
    ViewData["Title"] = "Detalles de Mascota";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Determinar estado de la mascota
    var estado = "Disponible";
    var estadoColor = "status-disponible";
    var estadoIcono = "fa-heart";

    if (Model.masc_EsAdoptado == true)
    {
        estado = "Adoptado";
        estadoColor = "status-adoptado";
        estadoIcono = "fa-home";
    }
    else if (Model.masc_EsReservado == true)
    {
        estado = "En Tratamiento";
        estadoColor = "status-tratamiento";
        estadoIcono = "fa-hospital";
    }

    // Preparar imagen
    string imgBase64Data = "";
    string imagenUrl = "/images/default-pet.png";
    if (Model.masc_Imagen != null && Model.masc_Imagen.Length > 0)
    {
        imgBase64Data = Convert.ToBase64String(Model.masc_Imagen);
        imagenUrl = $"data:image/png;base64,{imgBase64Data}";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <!-- Header con gradiente y foto de perfil -->
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        @if (!string.IsNullOrEmpty(imgBase64Data))
                        {
                            <img src="@imagenUrl" alt="@Model.masc_Nombre" class="profile-photo-large">
                        }
                        else
                        {
                            <div class="profile-photo-placeholder">
                                <i class="fas fa-paw"></i>
                            </div>
                        }
                        <div class="profile-badge">#@Model.masc_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>@Model.masc_Nombre</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-dog"></i>
                            <span>@Model.raza_Descripcion</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas @estadoIcono"></i>
                                <span>@estado</span>
                            </div>
                            @if (Model.masc_Edad.HasValue)
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-birthday-cake"></i>
                                    <span>@Model.masc_Edad año@(Model.masc_Edad > 1 ? "s" : "")</span>
                                </div>
                            }
                            <div class="profile-meta-item">
                                <i class="fas fa-@(Model.masc_Sexo == "Macho" ? "mars" : "venus")"></i>
                                <span>@Model.masc_Sexo</span>
                            </div>
                            @if (Model.masc_Peso.HasValue)
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-weight"></i>
                                    <span>@Model.masc_Peso kg</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("Find", new { id = Model.masc_Id })" class="btn-detail btn-detail-white">
                        <i class="fas fa-edit"></i>
                        <span>Editar</span>
                    </a>
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                    <button type="button" class="btn-detail btn-detail-danger" onclick="confirmDelete(@Model.masc_Id)">
                        <i class="fas fa-trash"></i>
                        <span>Eliminar</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información General -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información General</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-tag"></i>
                                    <span>Nombre</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.masc_Nombre</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-dog"></i>
                                    <span>Raza</span>
                                </div>
                                <div class="detail-value">@Model.raza_Descripcion</div>
                            </div>

                            @if (Model.masc_Edad.HasValue)
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-birthday-cake"></i>
                                        <span>Edad</span>
                                    </div>
                                    <div class="detail-value">@Model.masc_Edad año@(Model.masc_Edad > 1 ? "s" : "")</div>
                                </div>
                            }

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-venus-mars"></i>
                                    <span>Sexo</span>
                                </div>
                                <div class="detail-value">@Model.masc_Sexo</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-palette"></i>
                                    <span>Color</span>
                                </div>
                                <div class="detail-value">@Model.masc_Color</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-heart"></i>
                                    <span>Estado</span>
                                </div>
                                <div class="detail-value">
                                    <span class="status-badge @estadoColor">@estado</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Medidas Físicas -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-ruler-combined"></i>
                        <h3>Medidas Físicas</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="stats-grid">
                            @if (Model.masc_Peso.HasValue)
                            {
                                <div class="stat-box">
                                    <div class="stat-icon">
                                        <i class="fas fa-weight"></i>
                                    </div>
                                    <div class="stat-value">@Model.masc_Peso</div>
                                    <div class="stat-label">Peso (kg)</div>
                                </div>
                            }

                            @if (Model.masc_Talla.HasValue)
                            {
                                <div class="stat-box">
                                    <div class="stat-icon">
                                        <i class="fas fa-ruler-vertical"></i>
                                    </div>
                                    <div class="stat-value">@Model.masc_Talla</div>
                                    <div class="stat-label">Talla (cm)</div>
                                </div>
                            }
                        </div>

                        <div class="detail-list mt-3">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-palette"></i>
                                    <span>Color</span>
                                </div>
                                <div class="detail-value">@Model.masc_Color</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ubicación y Procedencia -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-map-marker-alt"></i>
                        <h3>Ubicación y Procedencia</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-home"></i>
                                    <span>Refugio</span>
                                </div>
                                <div class="detail-value">@Model.refg_Nombre</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-map-signs"></i>
                                    <span>Procedencia</span>
                                </div>
                                <div class="detail-value">@Model.proc_Descripcion</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Historia -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-book"></i>
                        <h3>Historia</h3>
                    </div>
                    <div class="detail-card-body">
                        @if (!string.IsNullOrEmpty(Model.masc_Historia))
                        {
                            <div class="detail-value">@Model.masc_Historia</div>
                        }
                        else
                        {
                            <div class="empty-state-detail" style="padding: 2rem;">
                                <i class="fas fa-book-open"></i>
                                <p>No hay historia registrada</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Información de Auditoría -->
                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Creado por</span>
                                        </div>
                                        <div class="detail-value">@(Model.NombreUsuarioCrea ?? "Sistema")</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-calendar-plus"></i>
                                            <span>Fecha de creación</span>
                                        </div>
                                        <div class="detail-value">@Model.masc_masc_FechaCrea.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                                @if (Model.masc_UsuarioModifica.HasValue)
                                {
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-user-edit"></i>
                                                <span>Modificado por</span>
                                            </div>
                                            <div class="detail-value">@(Model.masc_NombreUsuarioModifica ?? "Sistema")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-calendar-check"></i>
                                                <span>Última modificación</span>
                                            </div>
                                            <div class="detail-value">@(Model.masc_FechaModifica?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="delete-confirm-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Remove" method="post">
                <input type="hidden" name="masc_Id" id="delete-masc-id">
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h5>¿Está seguro de eliminar a @Model.masc_Nombre?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            $('#delete-masc-id').val(id);
            $('#delete-confirm-modal').modal('show');
        }
    </script>
}
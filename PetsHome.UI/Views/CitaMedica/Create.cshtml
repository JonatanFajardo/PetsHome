                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header header-treatment text-white d-flex align-items-center">
                <i class="fas fa-pills fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white"> Tratamiento y Procedimientos</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Add" method="post" autocomplete="ON" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="vac_Id">Vacuna Aplicada</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-syringe"></i></span>
                                    <input class="form-control" asp-for="vac_Id" type="text" placeholder="ID de la vacuna" />
                                </div>
                                <span class="text-danger" asp-validation-for="vac_Id"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="medic_MedicamentosRecetados">Medicamentos Recetados</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-prescription-bottle-alt"></i></span>
                                    <input class="form-control" asp-for="medic_MedicamentosRecetados" type="text" placeholder="Medicamentos prescritos" />
                                </div>
                                <span class="text-danger" asp-validation-for="medic_MedicamentosRecetados"></span>

                                    <input class="form-control" asp-for="medic_Temperatura" type="number" min="0" step="0.1" placeholder="0.0" />
                                </div>
                                <span class="text-danger" asp-validation-for="medic_Temperatura"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label" asp-for="medic_FrecuenciaCardiaca">Frecuencia Cardíaca</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-heartbeat"></i></span>
                                    <input class="form-control" asp-for="medic_FrecuenciaCardiaca" type="number" min="0" placeholder="0" />
                                </div>
                                <span class="text-danger" asp-validation-for="medic_FrecuenciaCardiaca"></span>

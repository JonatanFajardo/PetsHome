                                </div>
                                <span class="text-danger" asp-validation-for="medic_FechaConsulta"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="medic_TipoConsulta">Tipo de Consulta</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-clipboard-list"></i></span>
                                    <input class="form-control" asp-for="medic_TipoConsulta" type="text" placeholder="Ej: Consulta general, Emergencia, Control" />
                                </div>
                                <span class="text-danger" asp-validation-for="medic_TipoConsulta"></span>

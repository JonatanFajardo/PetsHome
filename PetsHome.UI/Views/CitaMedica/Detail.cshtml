@model CitaMedicaDetailViewModel
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="avatar-container position-relative">
                                <div class="avatar-circle bg-light d-flex align-items-center justify-content-center">
                                    <i class="fas fa-paw text-primary fa-2x"></i>
                                </div>
                                <div class="avatar-status bg-success"></div>
                            </div>
                        </div>
                        <div class="col">
                            <h4 class="mb-1 text-white font-weight-bold">@Model.masc_Nombre</h4>
                            <div class="mb-2">
                                <span class="badge badge-light text-white px-3 py-1">
                                    <i class="fas fa-dna mr-1"></i>@Model.raza_Descripcion
                                </span>
                            </div>
                            <p class="text-white-50 mb-0">
                                <i class="fas fa-calendar-alt mr-1"></i>Consulta: @Model.medic_FechaConsulta.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <!-- Información General -->
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-info-circle text-primary mr-2"></i>Información General
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">ID Cita:</span>
                                        <span class="info-value badge badge-outline-primary">@Model.medic_Id</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Mascota:</span>
                                        <span class="info-value">@Model.masc_Nombre</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Raza:</span>
                                        <span class="info-value">@Model.raza_Descripcion</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Comportamiento:</span>
                                        <span class="info-value badge badge-info text-white">@Model.com_Descripcion</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Fecha Consulta:</span>
                                        <span class="info-value">
                                            <i class="fas fa-calendar-alt text-muted mr-1"></i>
                                            @Model.medic_FechaConsulta.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Tipo Consulta:</span>
                                        <span class="info-value badge badge-secondary text-white">@Model.medic_TipoConsulta</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información Médica -->
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-stethoscope text-success mr-2"></i>Información Médica
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">Peso:</span>
                                        <span class="info-value">
                                            <i class="fas fa-weight text-muted mr-1"></i>
                                            @Model.medic_Peso kg
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Temperatura:</span>
                                        <span class="info-value">
                                            <i class="fas fa-thermometer-half text-muted mr-1"></i>
                                            @Model.medic_Temperatura°C
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Frec. Cardíaca:</span>
                                        <span class="info-value">
                                            <i class="fas fa-heartbeat text-danger mr-1"></i>
                                            @Model.medic_FrecuenciaCardiaca bpm
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Frec. Respiratoria:</span>
                                        <span class="info-value">
                                            <i class="fas fa-lungs text-info mr-1"></i>
                                            @Model.medic_FrecuenciaRespiratoria rpm
                                        </span>
                                    </div>

                                    
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información Clínica -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-clipboard-list text-warning mr-2"></i>Información Clínica
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="info-group">
                                            <div class="info-item">
                                                <span class="info-label">Motivo Consulta:</span>
                                                <div class="info-value-text">@Model.medic_MotivoConsulta</div>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Diagnóstico:</span>
                                                <div class="info-value-text">@Model.medic_Diagnostico</div>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Medicamentos Recetados:</span>
                                                <div class="info-value-text">@Model.medic_MedicamentosRecetados</div>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Dosificación:</span>
                                                <div class="info-value-text">@Model.medic_Dosificacion</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-group">
                                            <div class="info-item">
                                                <span class="info-label">Procedimientos:</span>
                                                <div class="info-value-text">@Model.medic_ProcedimientosRealizados</div>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Resultados Exámenes:</span>
                                                <div class="info-value-text">@Model.medic_ResultadosExamenes</div>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Próxima Cita:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-calendar-plus text-muted mr-1"></i>
                                                    @(Model.medic_ProximaCita?.ToString("dd/MM/yyyy") ?? "N/A")
                                                </span>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Motivo Próxima Cita:</span>
                                                <div class="info-value-text">@Model.medic_MotivoProximaCita</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información de Auditoría -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-history text-info mr-2"></i>Información de Auditoría
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="info-group">
                                            <div class="info-item">
                                                <span class="info-label">Usuario Creación:</span>
                                                <span class="info-value">@Model.UsuarioCreacion</span>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Fecha Creación:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-plus-circle text-muted mr-1"></i>
                                                    @Model.medic_FechaCrea.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="info-group">
                                            <div class="info-item">
                                                <span class="info-label">Usuario Modificación:</span>
                                                <span class="info-value">@(Model.UsuarioModificacion ?? "N/A")</span>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Fecha Modificación:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-edit text-muted mr-1"></i>
                                                    @(Model.medic_FechaModifica?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light no-print">
                    <div class="row">
                        <div class="col-md-6">
                            <a href="/CitaMedica/Find/@Model.medic_Id" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit mr-1"></i>Editar
                            </a>
                            <button id="btnImprimir" class="btn btn-outline-secondary btn-sm ml-2">
                                <i class="fas fa-print mr-1"></i>Imprimir
                            </button>
                            <button class="btn btn-outline-success btn-sm ml-2">
                                <i class="fas fa-file-pdf mr-1"></i>Generar PDF
                            </button>
                        </div>
                        <div class="col-md-6 text-right">
                            <small class="text-muted">
                                <i class="fas fa-clock mr-1"></i>
                                Última actualización: @(Model.medic_FechaModifica?.ToString("dd/MM/yyyy") ?? "N/A")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

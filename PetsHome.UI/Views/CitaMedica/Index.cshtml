@model CitaMedicaListViewModel
@{
    ViewData["Title"] = "Citas Médicas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header púrpura con todos los controles -->
    <div class="pets-header-full">
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fas fa-notes-medical mr-2 text-white"></i>Gestión de Citas Médicas</h2>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Create")'">
                    <i class="fas fa-plus mr-2"></i>Nueva Cita Médica
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por mascota, diagnóstico o tipo de consulta...">
                </div>
                <div class="action-buttons">
                    <div class="view-toggle">
                        <button class="btn-control active" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                    </div>
                        <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vista de Tabla -->
    <div id="tableView" class="pets-table-container">
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th>Mascota</th>
                    <th width="180">Tipo Consulta</th>
                    <th>Diagnóstico</th>
                    <th width="100">Peso</th>
                    <th width="120">Temperatura</th>
                    <th width="140">Próxima Cita</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargará los datos aquí -->
            </tbody>
        </table>
    </div>


    <!-- Vista de Cards (oculta por defecto) -->
    <div id="gridView" style="display: none;">
        <div class="row" id="citasGrid">
            <!-- Las tarjetas se generarán dinámicamente -->
        </div>
    </div>

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="cita_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>¿Está seguro de eliminar esta cita médica?</h5>
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.init.js"></script>
<script src="~/js/pages/cita-medica.js"></script>
<script>
    // Configuración del DataTable
    CitaMedica.datatable({
        urlList: "@Url.Action("List")",
        urlDetail: "@Url.Action("Detail")",
        urlInsert: "@Url.Action("Create")",
        urlUpdate: "@Url.Action("Find")"
    });

    // Búsqueda global
    $('#globalSearch').on('keyup', function() {
        $('#datatable').DataTable().search(this.value).draw();
    });

    // Alternar entre vista tabla y cards
    function toggleView(view) {
        if (view === 'table') {
            $('#tableView').show();
            $('#gridView').hide();
            $('#tableViewBtn').addClass('active');
            $('#gridViewBtn').removeClass('active');
        } else {
            $('#tableView').hide();
            $('#gridView').show();
            $('#tableViewBtn').removeClass('active');
            $('#gridViewBtn').addClass('active');
            loadCardsView();
        }
    }

    // Cargar vista de tarjetas
    function loadCardsView() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();
        var html = '';

        if (data.length === 0) {
            html = '<div class="col-12 text-center py-5"><p class="text-muted">No se encontraron citas médicas</p></div>';
        } else {
            data.each(function(row) {
                var tipoConsultaBadge = getTipoConsultaBadge(row.cita_TipoConsulta);
                var peso = row.cita_Peso ? row.cita_Peso + ' kg' : 'N/A';
                var temperatura = row.cita_Temperatura ? row.cita_Temperatura + '°C' : 'N/A';
                var proximaCita = row.cita_ProximaCita ? new Date(row.cita_ProximaCita).toLocaleDateString('es-ES') : 'Sin programar';
                var diagnostico = row.cita_Diagnostico ? (row.cita_Diagnostico.length > 100 ? row.cita_Diagnostico.substring(0, 100) + '...' : row.cita_Diagnostico) : 'Sin diagnóstico';

                html += `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="pet-card">
                            <div style="position: relative;">
                                <div class="pet-card-img">
                                    <i class="fas fa-notes-medical"></i>
                                </div>
                                <span class="pet-badge">#${String(row.cita_Id).padStart(3, '0')}</span>
                            </div>
                            <div class="p-3">
                                <h5 class="mb-1"><i class="fas fa-paw mr-2"></i>${row.masc_Nombre}</h5>
                                <div class="mb-2">${tipoConsultaBadge}</div>
                                <p class="text-muted mb-2" style="font-size: 0.85rem;">${diagnostico}</p>
                                <div class="mb-2">
                                    <small class="text-muted"><i class="fas fa-weight mr-2"></i>Peso: <strong>${peso}</strong></small>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted"><i class="fas fa-thermometer-half mr-2"></i>Temp: <strong>${temperatura}</strong></small>
                                </div>
                                <div class="mb-3">
                                    <small class="text-muted"><i class="far fa-calendar-alt mr-2"></i>Próxima: <strong>${proximaCita}</strong></small>
                                </div>
                                <div class="d-flex justify-content-end">
                                    <button class="action-btn btn-view" onclick="viewCitaMedica(${row.cita_Id})" title="Ver">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="action-btn btn-edit" onclick="editCitaMedica(${row.cita_Id})" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="action-btn btn-delete" onclick="deleteCitaMedica(${row.cita_Id})" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        $('#citasGrid').html(html);
    }

    // Funciones para acciones de citas médicas
    function viewCitaMedica(id) {
        window.location.href = '@Url.Action("Detail")' + '/' + id;
    }

    function editCitaMedica(id) {
        window.location.href = '@Url.Action("Find")' + '/' + id;
    }

    function deleteCitaMedica(id) {
        $('#delete-item-id').val(id);
        $('#delete-modal').modal('show');
    }

    // Obtener badge según tipo de consulta
    function getTipoConsultaBadge(tipo) {
        var badges = {
            'Consulta General': '<span class="status-badge badge-primary">Consulta General</span>',
            'Emergencia': '<span class="status-badge badge-danger">Emergencia</span>',
            'Vacunación': '<span class="status-badge badge-success">Vacunación</span>',
            'Cirugía': '<span class="status-badge badge-warning">Cirugía</span>',
            'Control': '<span class="status-badge badge-info">Control</span>'
        };
        return badges[tipo] || '<span class="status-badge badge-secondary">' + tipo + '</span>';
    }
</script>
}



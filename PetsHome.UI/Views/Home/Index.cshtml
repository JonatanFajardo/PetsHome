@model PetsHome.Business.Models.HomeViewModel
@using System.Linq
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header>
    <link href="~/css/home-style.css" rel="stylesheet" />
</header>

<div class="home-container">
    <!-- Welcome Section -->
    <div class="welcome-section">
        <!-- Welcome Card -->
        <div class="welcome-card">
            <div class="welcome-bg"></div>
            <div class="welcome-content">
                <div class="welcome-text">
                    <h2>¡Bienvenido a PetsHome! 🐾</h2>
                    <p>Tu centro de gestión integral para el cuidado de mascotas</p>
                    <button class="welcome-btn" onclick="location.href='@Url.Action("Index", "Mascota")'">
                        <i class="fas fa-compass me-2"></i>Explorar
                    </button>
                </div>
                <div class="welcome-pet-image">
                    <img src="~/images/perrita.jpg" alt="Mascota" class="welcome-img">
                </div>
            </div>
        </div>

        <!-- Weather Card -->
        <div class="weather-card">
            <div class="weather-bg"></div>
            <div class="weather-content">
                <img id="weather-icon" src="" alt="Clima" class="weather-icon-img" style="display: none;">
                <i class="fas fa-cloud-sun weather-icon-fa" id="weather-icon-default"></i>
                <div class="weather-temp" id="weather-temperature">--°C</div>
                <p class="weather-desc" id="weather-condition">Cargando clima...</p>
                <p class="weather-date" id="weather-location">Honduras</p>
                <small class="text-danger mt-2" id="weather-error-message" style="display: none;"></small>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="stats-grid">
        <div class="stat-card" style="background: linear-gradient(135deg, #ede9fe 0%, #f3e8ff 100%)">
            <div class="stat-icon" style="background: linear-gradient(135deg, #a855f7 0%, #9333ea 100%)">
                <i class="fas fa-dog"></i>
            </div>
            <div class="stat-value">@Model.TotalMascotasRegistradas</div>
            <div class="stat-label">Mascotas Registradas</div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%)">
            <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-value">@Model.ProximasCitasMedicas</div>
            <div class="stat-label">Próximas Citas Médicas</div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #fef3c7 0%, #fef9c3 100%)">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%)">
                <i class="fas fa-hand-holding-heart"></i>
            </div>
            <div class="stat-value">@Model.DonacionesRecibidas</div>
            <div class="stat-label">Donaciones Recibidas</div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, #d1fae5 0%, #ecfdf5 100%)">
            <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)">
                <i class="fas fa-heart"></i>
            </div>
            <div class="stat-value">@Model.AdopcionesPendientes</div>
            <div class="stat-label">Adopciones Pendientes</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions-card">
        <h3>Acciones Rápidas</h3>
        <div class="actions-grid">
            <button class="action-btn" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%)" onclick="location.href='@Url.Action("Create", "Mascota")'">
                <div class="action-content">
                    <i class="fas fa-plus"></i>
                    <span>Nueva Mascota</span>
                </div>
            </button>
            <button class="action-btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)" onclick="location.href='@Url.Action("Create", "Solicitud")'">
                <div class="action-content">
                    <i class="fas fa-calendar-plus"></i>
                    <span>Agendar Cita</span>
                </div>
            </button>
            <button class="action-btn" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%)" onclick="location.href='@Url.Action("Index", "Inventario")'">
                <div class="action-content">
                    <i class="fas fa-boxes"></i>
                    <span>Ver Inventario</span>
                </div>
            </button>
            <button class="action-btn" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)" onclick="location.href='@Url.Action("Index", "Adopcion")'">
                <div class="action-content">
                    <i class="fas fa-home"></i>
                    <span>Adopciones</span>
                </div>
            </button>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- Left Column -->
        <div class="content-left">
            <!-- Appointments -->
            <div class="appointments-card">
                <div class="card-header-custom">
                    <h3>Próximas Citas</h3>
                    <span class="card-date">Hoy • @DateTime.Now.ToString("dd MMM yyyy")</span>
                </div>
                <div class="appointments-list">
                    <div class="appointment-item">
                        <div class="appointment-icon" style="background: #fce7f3">
                            <i class="fas fa-heartbeat" style="color: #ec4899"></i>
                        </div>
                        <div class="appointment-info">
                            <div class="appointment-pet">Consulta General - Max</div>
                            <div class="appointment-type">Dr. García</div>
                        </div>
                        <div class="appointment-time">
                            <i class="fas fa-clock"></i>
                            <span>10:30 AM</span>
                        </div>
                    </div>
                    <div class="appointment-item">
                        <div class="appointment-icon" style="background: #dbeafe">
                            <i class="fas fa-syringe" style="color: #3b82f6"></i>
                        </div>
                        <div class="appointment-info">
                            <div class="appointment-pet">Vacunación - Luna</div>
                            <div class="appointment-type">Dr. Martínez</div>
                        </div>
                        <div class="appointment-time">
                            <i class="fas fa-clock"></i>
                            <span>2:00 PM</span>
                        </div>
                    </div>
                    <div class="appointment-item">
                        <div class="appointment-icon" style="background: #fef3c7">
                            <i class="fas fa-cut" style="color: #f59e0b"></i>
                        </div>
                        <div class="appointment-info">
                            <div class="appointment-pet">Cirugía - Buddy</div>
                            <div class="appointment-type">Dr. López</div>
                        </div>
                        <div class="appointment-time">
                            <i class="fas fa-clock"></i>
                            <span>Mañana 9:00 AM</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Adoptions -->
            <div class="adoptions-card">
                <div class="card-header-custom">
                    <h3>Adopciones Recientes</h3>
                    <button class="view-all-btn" onclick="location.href='@Url.Action("Index", "Adopcion")'">Ver todas</button>
                </div>
                <div class="adoptions-list">
                    @if (Model?.UltimasAdopciones != null && Model.UltimasAdopciones.Any())
                    {
                        foreach (var adopcion in Model.UltimasAdopciones)
                        {
                            var iconClass = adopcion.adop_Estado == "Aprobado" ? "fa-paw" :
                                           adopcion.adop_Estado == "Rechazado" ? "fa-times-circle" : "fa-heart";
                            var iconBg = adopcion.adop_Estado == "Aprobado" ? "#d1fae5" :
                                        adopcion.adop_Estado == "Rechazado" ? "#fee2e2" : "#fce7f3";
                            var iconColor = adopcion.adop_Estado == "Aprobado" ? "#10b981" :
                                           adopcion.adop_Estado == "Rechazado" ? "#ef4444" : "#ec4899";
                            var estadoTexto = adopcion.adop_Estado ?? "Pendiente";
                            var nombreMascota = adopcion.masc_Nombre ?? "Mascota";
                            var nombreAdoptante = adopcion.per_Nombre ?? "una familia";
                            var diasTranscurridos = (DateTime.Now - adopcion.adop_FechaCrea).Days;
                            var tiempoTexto = diasTranscurridos == 0 ? "Hoy" :
                                             diasTranscurridos == 1 ? "Ayer" :
                                             $"Hace {diasTranscurridos} días";

                            <div class="adoption-activity-item">
                                <div class="adoption-activity-icon" style="background: @iconBg">
                                    <i class="fas @iconClass" style="color: @iconColor"></i>
                                </div>
                                <div class="adoption-activity-info">
                                    <div class="adoption-activity-name">@nombreMascota - @estadoTexto</div>
                                    <div class="adoption-activity-detail">Por @nombreAdoptante</div>
                                </div>
                                <div class="adoption-activity-time">@tiempoTexto</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="adoption-activity-item">
                            <div class="adoption-activity-info text-center w-100">
                                <small class="text-muted">No hay adopciones recientes</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="content-right">
            <!-- Featured Pet -->
            <div class="featured-pet-card">
                <div class="featured-pet-bg"></div>
                <div class="featured-pet-content">
                    <div class="featured-pet-badge">
                        <span>Disponible</span>
                    </div>
                    <div class="featured-pet-image-container">🐕</div>
                    <h4 class="featured-pet-name">Rocky</h4>
                    <p class="featured-pet-details">Labrador • 1 año</p>
                    <button class="featured-pet-btn" onclick="location.href='@Url.Action("Index", "Adopcion")'">Ver Detalles</button>
                </div>
            </div>

            <!-- Tips -->
            <div class="tips-card">
                <h3>💡 Tip de Cuidado</h3>
                <div class="tip-main">
                    <p class="tip-text" id="tip-text">La socialización temprana es clave para el desarrollo saludable de cachorros. Expón a diferentes personas, animales y ambientes de forma controlada.</p>
                    <div class="tip-progress" id="tip-indicators"></div>
                </div>
                <div class="tip-reminders">
                    <h4>Recordatorios Importantes</h4>
                    <div class="tip-reminders-list">
                        <div class="tip-reminder">
                            <i class="fas fa-exclamation-triangle" style="color: #ea580c"></i>
                            <span class="tip-reminder-text">5 medicamentos vencen esta semana</span>
                        </div>
                        <div class="tip-reminder">
                            <i class="fas fa-calendar-alt" style="color: #2563eb"></i>
                            <span class="tip-reminder-text">Revisión de inventario programada para mañana</span>
                        </div>
                        <div class="tip-reminder">
                            <i class="fas fa-stethoscope" style="color: #9333ea"></i>
                            <span class="tip-reminder-text">3 mascotas necesitan refuerzo de vacunas</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/pages/home.js"></script>
}

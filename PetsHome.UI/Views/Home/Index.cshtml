@model PetsHome.Business.Models.HomeViewModel
@using System.Linq
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header>
    <link href="~/css/home-style.css" rel="stylesheet" />
    <link href="~/css/dashboard-admin-charts.css" rel="stylesheet" />
</header>


<div class="home-container">

    <!-- ROW 1: Hero + Weather -->
    <div class="welcome-section">
        <div class="welcome-card">
            <div class="welcome-bg"></div>
            <div class="welcome-content">
                <div class="welcome-text">
                    <div class="welcome-badge">✨ Sistema de gestión integral</div>
                    <h2>¡Bienvenido a PetsHome!</h2>
                    <p>Tu centro de gestión para el cuidado de mascotas</p>
                    <button class="welcome-btn" onclick="location.href='@Url.Action("Index", "Mascota")'">
                        🚀 Explorar sistema
                    </button>
                </div>
                <div class="welcome-pet-image">
                    <img src="~/images/perrita.jpg" alt="Mascota" class="welcome-img">
                </div>
            </div>
        </div>

        <div class="weather-card">
            <div class="weather-bg"></div>
            <div class="weather-content">
                <img id="weather-icon" src="" alt="Clima" class="weather-icon-img" style="display:none;">
                <i class="fas fa-cloud-sun weather-icon-fa" id="weather-icon-default"></i>
                <div class="weather-label">Clima actual</div>
                <div class="weather-temp" id="weather-temperature">--°C</div>
                <p class="weather-desc" id="weather-condition">Cargando clima...</p>
                <p class="weather-date" id="weather-location">
                    <i class="fas fa-map-marker-alt me-1"></i>Honduras
                </p>
                <small class="text-danger mt-2" id="weather-error-message" style="display:none;"></small>
            </div>
        </div>
    </div>

    <!-- ROW 2: Stats -->
    <div class="stats-grid">
        <div class="stat-card stat-purple">
            <div class="stat-icon icon-purple"><i class="fas fa-paw"></i></div>
            <div class="stat-body">
                <div class="stat-value">@Model.TotalMascotasRegistradas</div>
                <div class="stat-label">Mascotas Registradas</div>
            </div>
            <div class="stat-trend trend-up">↑ +2 este mes</div>
        </div>
        <div class="stat-card stat-blue">
            <div class="stat-icon icon-blue"><i class="fas fa-calendar-check"></i></div>
            <div class="stat-body">
                <div class="stat-value">@Model.ProximasCitasMedicas</div>
                <div class="stat-label">Próximas Citas Médicas</div>
            </div>
            <div class="stat-trend trend-up">↑ Hoy</div>
        </div>
        <div class="stat-card stat-amber">
            <div class="stat-icon icon-amber"><i class="fas fa-hand-holding-heart"></i></div>
            <div class="stat-body">
                <div class="stat-value">@Model.DonacionesRecibidas</div>
                <div class="stat-label">Donaciones Recibidas</div>
            </div>
            <div class="stat-trend trend-neutral">Sin cambios</div>
        </div>
        <div class="stat-card stat-green">
            <div class="stat-icon icon-green"><i class="fas fa-heart"></i></div>
            <div class="stat-body">
                <div class="stat-value">@Model.AdopcionesPendientes</div>
                <div class="stat-label">Adopciones Pendientes</div>
            </div>
            <div class="stat-trend trend-neutral">Sin cambios</div>
        </div>
    </div>

    <!-- ROW 3: Quick Actions -->
    <div class="quick-actions-card">
        <div class="sec-header">
            <h3 class="sec-title">Acciones Rápidas</h3>
        </div>
        <div class="actions-grid">
            <button class="action-btn qa-red" onclick="location.href='@Url.Action("Create", "Mascota")'">
                <i class="fas fa-plus"></i>
                <span>Nueva Mascota</span>
            </button>
            <button class="action-btn qa-green" onclick="location.href='@Url.Action("Create", "Solicitud")'">
                <i class="fas fa-calendar-plus"></i>
                <span>Agendar Cita</span>
            </button>
            <button class="action-btn qa-amber" onclick="location.href='@Url.Action("Index", "Inventario")'">
                <i class="fas fa-boxes"></i>
                <span>Ver Inventario</span>
            </button>
            <button class="action-btn qa-blue" onclick="location.href='@Url.Action("Index", "Adopcion")'">
                <i class="fas fa-home"></i>
                <span>Adopciones</span>
            </button>
        </div>
    </div>

    <!-- ROW 4: Main Content -->
    <div class="content-grid">

        <!-- Left Column -->
        <div class="content-left">

            <!-- Appointments -->
            <div class="appointments-card">
                <div class="card-header-custom">
                    <h3 class="sec-title">Próximas Citas</h3>
                    <span class="card-date">Hoy • @DateTime.Now.ToString("dd MMM yyyy")</span>
                </div>
                <div class="appointments-list">
                    <div class="appointment-item">
                        <div class="appointment-icon appt-pink">🩺</div>
                        <div class="appointment-info">
                            <div class="appointment-pet">Consulta General — Max</div>
                            <div class="appointment-type">Dr. García</div>
                        </div>
                        <div class="appointment-time-block">
                            <span class="appt-time-text">10:30 AM</span>
                            <span class="appt-tag tag-today">Hoy</span>
                        </div>
                    </div>
                    <div class="appointment-item">
                        <div class="appointment-icon appt-teal">💉</div>
                        <div class="appointment-info">
                            <div class="appointment-pet">Vacunación — Luna</div>
                            <div class="appointment-type">Dr. Martínez</div>
                        </div>
                        <div class="appointment-time-block">
                            <span class="appt-time-text">2:00 PM</span>
                            <span class="appt-tag tag-today">Hoy</span>
                        </div>
                    </div>
                    <div class="appointment-item">
                        <div class="appointment-icon appt-orange">🔬</div>
                        <div class="appointment-info">
                            <div class="appointment-pet">Cirugía — Buddy</div>
                            <div class="appointment-type">Dr. López</div>
                        </div>
                        <div class="appointment-time-block">
                            <span class="appt-time-text">9:00 AM</span>
                            <span class="appt-tag tag-tomorrow">Mañana</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Adoptions -->
            <div class="adoptions-card">
                <div class="card-header-custom">
                    <h3 class="sec-title">Adopciones Recientes</h3>
                    <button class="view-all-btn" onclick="location.href='@Url.Action("Index", "Adopcion")'">
                        Ver todas →
                    </button>
                </div>
                <div class="adoptions-list">
                    @if (Model?.UltimasAdopciones != null && Model.UltimasAdopciones.Any())
                    {
                        foreach (var adopcion in Model.UltimasAdopciones)
                        {
                            var iconEmoji = adopcion.adop_Estado == "Aprobado" ? "🐾" :
                                            adopcion.adop_Estado == "Rechazado" ? "✖️" : "🐶";
                            var iconBg   = adopcion.adop_Estado == "Aprobado" ? "adpt-green" :
                                           adopcion.adop_Estado == "Rechazado" ? "adpt-red" : "adpt-pink";
                            var estadoTexto      = adopcion.adop_Estado ?? "Pendiente";
                            var nombreMascota    = adopcion.masc_Nombre ?? "Mascota";
                            var nombreAdoptante  = adopcion.per_Nombre  ?? "una familia";
                            var dias             = (DateTime.Now - adopcion.adop_FechaCrea).Days;
                            var tiempoTexto      = dias == 0 ? "Hoy" : dias == 1 ? "Ayer" : $"Hace {dias} días";

                            <div class="adoption-activity-item">
                                <div class="adoption-activity-icon @iconBg">@iconEmoji</div>
                                <div class="adoption-activity-info">
                                    <div class="adoption-activity-name">@nombreMascota — @estadoTexto</div>
                                    <div class="adoption-activity-detail">Por @nombreAdoptante</div>
                                </div>
                                <div class="adoption-activity-time">@tiempoTexto</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="adoption-activity-item">
                            <div class="adoption-activity-info text-center w-100">
                                <small class="text-muted">No hay adopciones recientes</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="content-right">

            <!-- Featured Pet -->
            <div class="featured-pet-card">
                <div class="featured-pet-img">🦮</div>
                <div class="featured-pet-content">
                    <div class="featured-pet-header">
                        <div>
                            <h4 class="featured-pet-name">Rocky</h4>
                            <p class="featured-pet-details">Labrador · 1 año</p>
                        </div>
                        <div class="pet-avail">
                            <span class="pet-avail-dot"></span>Disponible
                        </div>
                    </div>
                    <button class="featured-pet-btn" onclick="location.href='@Url.Action("Index", "Adopcion")'">
                        Ver Detalles
                    </button>
                </div>
            </div>

            <!-- Tips + Reminders -->
            <div class="tips-card">
                <div class="tip-header-row">
                    <span class="tip-icon-lbl">💡</span>
                    <span class="tip-title-text">Tip de Cuidado</span>
                </div>
                <p class="tip-text" id="tip-text">
                    La socialización temprana es clave para el desarrollo saludable de cachorros.
                    Expón a diferentes personas, animales y ambientes de forma controlada.
                </p>
                <div class="tip-progress" id="tip-indicators"></div>

                <div class="tip-reminders">
                    <h4 class="tip-reminders-title">Recordatorios</h4>
                    <div class="tip-reminder">
                        <i class="fas fa-exclamation-triangle" style="color:#ea580c"></i>
                        <span>5 medicamentos vencen esta semana</span>
                    </div>
                    <div class="tip-reminder">
                        <i class="fas fa-calendar-alt" style="color:#2563eb"></i>
                        <span>Revisión de inventario programada para mañana</span>
                    </div>
                    <div class="tip-reminder">
                        <i class="fas fa-stethoscope" style="color:#9333ea"></i>
                        <span>3 mascotas necesitan refuerzo de vacunas</span>
                    </div>
                </div>
            </div>



        </div>
    </div>

    
@* ══════════════════════════════════════════════════════════
   SECCIÓN DE ANALYTICS — Dashboard Admin Avanzado
   ══════════════════════════════════════════════════════════ *@
@{
    var admin      = Model?.DashboardAdmin;
    var solicitudes= admin?.SolicitudesPendientes ?? new List<PetsHome.Common.Entities.PR_General_DashboardAdmin_SolicitudesPendientesResult>();
    var usuarios   = admin?.UsuariosPorRol        ?? new List<PetsHome.Common.Entities.PR_General_DashboardAdmin_UsuariosPorRolResult>();
    var inventario = admin?.InventarioAlertas      ?? new List<PetsHome.Common.Entities.PR_General_DashboardAdmin_InventarioAlertaResult>();
    var citasHoy   = admin?.CitasHoy              ?? new List<PetsHome.Common.Entities.PR_General_DashboardAdmin_CitasHoyResult>();
    var rolIconos  = new Dictionary<string,string>{
        {"Administrador","🛡"},{"Director","👔"},{"Supervisor","📋"},
        {"Veterinario","🩺"},{"Cuidador","🐾"},{"Básico","👤"}
    };
}

<div class="da-wrap" id="da-analytics">

    <!-- Header -->
    <div class="da-header">
        <div class="da-header-badge">📊 Análisis del Sistema</div>
        <h2 class="da-header-title">Panel de Control Avanzado</h2>
        <p class="da-header-sub">Métricas en tiempo real · actualizado al cargar la página</p>
        @{
            var rolIdClaim = User.FindFirst("RoleId")?.Value;
            int.TryParse(rolIdClaim, out int rolIdAdmin);
        }
        @if (rolIdAdmin == 1)
        {
            <button type="button" id="btn-refrescar-fechas" class="da-btn-refresh" title="Mueve toda la data del demo a fechas relativas a hoy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 0 1 15.5-6.4L21 8"/><path d="M21 3v5h-5"/>
                    <path d="M21 12a9 9 0 0 1-15.5 6.4L3 16"/><path d="M3 21v-5h5"/>
                </svg>
                <span>Refrescar fechas del demo</span>
            </button>
        }
    </div>

    <!-- ── Fila 1: Área (2/3) + Donut (1/3) ── -->
    <div class="da-grid da-grid-2-1" data-aos="fade-up">
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Tendencias · Últimos 6 Meses</span>
                <span class="da-chip">Ingresos vs Adopciones</span>
            </div>
            <div id="chart-tendencias"></div>
        </div>
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Mascotas por Estado</span>
            </div>
            <div id="chart-estados"></div>
        </div>
    </div>

    <!-- ── Fila 2: Top Razas (1/3) + Heatmap (2/3) ── -->
    <div class="da-grid da-grid-1-2" data-aos="fade-up" data-aos-delay="80">
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Top Razas Adoptadas</span>
            </div>
            <div id="chart-razas"></div>
        </div>
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Demanda de Citas · Últimas 4 Semanas</span>
                <span class="da-chip">Por día y hora</span>
            </div>
            <div id="chart-heatmap"></div>
        </div>
    </div>

    <!-- ── Fila 3: Embudo + Solicitudes pendientes ── -->
    <div class="da-grid da-grid-equal-2" data-aos="fade-up" data-aos-delay="120">
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Embudo de Adopción</span>
            </div>
            <div id="chart-embudo"></div>
        </div>
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Solicitudes Pendientes</span>
                <a href="@Url.Action("Index","Solicitud")" class="da-link">Ver todas →</a>
            </div>
            @if (solicitudes.Any())
            {
                <div class="da-card-body">
                    <table class="da-table">
                        <thead>
                            <tr>
                                <th>Mascota</th>
                                <th>Solicitante</th>
                                <th>Espera</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in solicitudes)
                            {
                                <tr>
                                    <td>@s.masc_Nombre</td>
                                    <td>@s.sol_NombreCompleto</td>
                                    <td>
                                        <span class="da-dias @(s.DiasAntiguedad >= 7 ? "da-dias-alert" : "")">
                                            @s.DiasAntiguedad d
                                        </span>
                                    </td>
                                    <td><span class="da-badge-estado">@s.sol_Estado</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="da-empty">Sin solicitudes pendientes</div>
            }
        </div>
    </div>

    <!-- ── Fila 4: Usuarios + Inventario + Citas hoy ── -->
    <div class="da-grid da-grid-3-equal" data-aos="fade-up" data-aos-delay="160">

        <!-- Usuarios por rol -->
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Usuarios del Sistema</span>
                <a href="@Url.Action("Index","Usuario")" class="da-link">Ver →</a>
            </div>
            @if (usuarios.Any())
            {
                <div class="da-total-users">@usuarios.Sum(u => u.Cantidad) usuarios activos</div>
                @foreach (var u in usuarios)
                {
                    var icono = rolIconos.TryGetValue(u.Rol, out var ic) ? ic : "👤";
                    <div class="da-rol-row">
                        <span class="da-rol-icon">@icono</span>
                        <span class="da-rol-name">@u.Rol</span>
                        <span class="da-rol-count">@u.Cantidad</span>
                    </div>
                }
            }
            else
            {
                <div class="da-empty">Sin datos</div>
            }
        </div>

        <!-- Alertas de inventario -->
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Alertas de Inventario</span>
                <a href="@Url.Action("Index","RecepcionMercancia")" class="da-link">Ver →</a>
            </div>
            @if (inventario.Any())
            {
                @foreach (var item in inventario)
                {
                    <div class="da-inv-row">
                        <div>
                            <div class="da-inv-name">@item.Descripcion</div>
                            <div class="da-inv-cat">@item.Categoria</div>
                        </div>
                        <span class="da-stock-badge @(item.Estado == "Agotado" ? "da-stock-agotado" : "da-stock-bajo")">
                            @(item.Estado == "Agotado" ? "Agotado" : item.StockActual + " uds")
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="da-empty">Sin alertas de inventario</div>
            }
        </div>

        <!-- Citas de hoy -->
        <div class="da-card">
            <div class="da-card-head">
                <span class="da-card-title">Citas de Hoy</span>
                <a href="@Url.Action("Index","CitaMedica")" class="da-link">Ver →</a>
            </div>
            @if (citasHoy.Any())
            {
                <div class="da-card-body">
                    @foreach (var c in citasHoy.Take(8))
                    {
                        <div class="da-cita-row">
                            <div class="da-cita-hora">@c.cita_FechaConsulta.ToString("hh:mm tt")</div>
                            <div class="da-cita-info">
                                <div class="da-cita-nombre">@c.masc_Nombre</div>
                                <div class="da-cita-tipo">@c.cita_TipoConsulta</div>
                            </div>
                            <span class="da-cita-estado @(c.cita_Estado == "Urgente" ? "da-cita-urgente" : "")">
                                @c.cita_Estado
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="da-empty">Sin citas programadas hoy</div>
            }
        </div>

    </div>
</div>
</div>


@section scripts {
    <script>
    window._adminDash = {
        tendencias: @Html.Raw(Json.Serialize(Model.DashboardAdmin.Tendencias)),
        estados:    @Html.Raw(Json.Serialize(Model.DashboardAdmin.MascotasEstado)),
        razas:      @Html.Raw(Json.Serialize(Model.DashboardAdmin.TopRazas)),
        heatmap:    @Html.Raw(Json.Serialize(Model.DashboardAdmin.HeatmapCitas)),
        embudo:     @Html.Raw(Json.Serialize(Model.DashboardAdmin.EmbudoAdopcion))
    };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.46.0/dist/apexcharts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/countup.js@2.8.0/dist/countUp.umd.js"></script>
    <script src="~/js/pages/home.js"></script>
    <script src="~/js/pages/dashboard-admin-charts.js"></script>

    @if (rolIdAdmin == 1)
    {
        <script>
        (function () {
            var btn = document.getElementById('btn-refrescar-fechas');
            if (!btn) return;

            btn.addEventListener('click', function () {
                if (typeof Swal === 'undefined') { runRefresh(); return; }

                Swal.fire({
                    title: '¿Refrescar fechas del demo?',
                    text: 'Esto moverá todas las fechas (mascotas, adopciones, donaciones, citas, eventos…) a ventanas relativas a hoy. Acción solo de demo.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, refrescar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#6c63ff'
                }).then(function (res) { if (res.isConfirmed) runRefresh(); });
            });

            function runRefresh() {
                btn.disabled = true; btn.classList.add('is-loading');
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var form  = new FormData();
                if (token) form.append('__RequestVerificationToken', token.value);

                fetch('@Url.Action("RefrescarFechasDemo", "Home")', { method: 'POST', body: form })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: data.ok ? 'Listo' : 'Error',
                                text: data.msg,
                                icon: data.ok ? 'success' : 'error',
                                confirmButtonColor: '#6c63ff'
                            }).then(function () { if (data.ok) window.location.reload(); });
                        } else {
                            alert(data.msg);
                            if (data.ok) window.location.reload();
                        }
                    })
                    .catch(function () {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire('Error', 'No se pudo contactar al servidor.', 'error');
                        } else {
                            alert('No se pudo contactar al servidor.');
                        }
                    })
                    .finally(function () { btn.disabled = false; btn.classList.remove('is-loading'); });
            }
        })();
        </script>
        @Html.AntiForgeryToken()
    }
}
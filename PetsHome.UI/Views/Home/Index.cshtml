@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header>
    <link href="~/css/coming-soon/style.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f2f5; /* Fondo más suave para toda la página */
        }

        .stat-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
            border-radius: 15px;
            color: white; /* Texto blanco para todas las stat-cards */
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%); /* Degradado por defecto */
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.15); /* Sombra más pronunciada al hacer hover */
            }

            .stat-card.primary-gradient {
                background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); /* Azul profundo a violeta */
            }

            .stat-card.success-gradient {
                background: linear-gradient(135deg, #2af598 0%, #009efd 100%); /* Verde aqua a azul claro */
            }

            .stat-card.warning-gradient {
                background: linear-gradient(135deg, #ffc371 0%, #ff5f6d 100%); /* Naranja cálido a rojo coral */
            }

            .stat-card.info-gradient {
                background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%); /* Verde menta a azul cielo */
            }

        .welcome-card {
            background: linear-gradient(135deg, #ACD8FD 0%, #85C1FC 100%); /* Se mantiene el degradado azul suave */
            border-radius: 20px;
            border: none;
            overflow: hidden;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

        .carousel-card {
            background: linear-gradient(135deg, #fce043 0%, #fb7247 100%); /* Amarillo vibrante a naranja */
            border-radius: 20px;
            border: none;
            overflow: hidden;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

        .quick-action-card {
            border-radius: 15px;
            border: none;
            transition: all 0.3s ease;
            cursor: pointer;
            background-color: #ffffff; /* Fondo blanco para mayor limpieza */
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

            .quick-action-card:hover {
                transform: translateY(-5px); /* Más notorio al hacer hover */
                box-shadow: 0 8px 15px rgba(0,0,0,0.1);
            }

        .icon-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 24px;
            background-color: rgba(255,255,255,0.9); /* Blanco semitransparente para los iconos */
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .stat-card .icon-circle {
            color: inherit; /* Hereda el color del texto de la tarjeta, que ahora es blanco */
        }

        .recent-activity {
            background: #ffffff; /* Fondo blanco */
            border-radius: 15px;
            border: none;
            box-shadow: 0 8px 15px rgba(0,0,0,0.05);
        }

        .activity-item {
            border-left: 4px solid;
            padding-left: 15px;
            margin-bottom: 15px;
        }

            .activity-item:last-child {
                margin-bottom: 0;
            }

            .activity-item .text-primary {
                border-color: #007bff;
            }

            .activity-item .text-success {
                border-color: #28a745;
            }

            .activity-item .text-danger {
                border-color: #dc3545;
            }

        .weather-widget {
            background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%); /* Degradado azul cielo a azul claro */
            color: white;
            border-radius: 15px;
            border: none;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

        .tip-card {
            background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); /* Se mantiene el degradado durazno */
            border-radius: 15px;
            border: none;
            box-shadow: 0 8px 15px rgba(0,0,0,0.05);
            color: #333; /* Texto más oscuro para mejor contraste */
        }

            .tip-card .card-title {
                color: #d9534f; /* Un rojo más vibrante para el ícono y título */
            }

        /* Estilos para el carrusel de imágenes para que el texto sea más legible */
        .carousel-caption {
            background-color: rgba(0, 0, 0, 0.4); /* Fondo semi-transparente para el texto */
            border-radius: 5px;
            padding: 5px 10px;
        }

            .carousel-caption h6, .carousel-caption p {
                color: white;
            }

        .list-group-item {
            border-bottom: 1px solid #eee !important; /* Separador sutil para las citas */
        }

            .list-group-item:last-child {
                border-bottom: none !important;
            }

        .btn-outline-primary {
            color: #007bff;
            border-color: #007bff;
            transition: all 0.3s ease;
        }

            .btn-outline-primary:hover {
                background-color: #007bff;
                color: white;
                box-shadow: 0 4px 8px rgba(0,123,255,0.2);
            }

        .card.mt-3.bg-light { /* Tarjeta de recordatorios */
            background-color: #ffffff !important; /* Asegurar fondo blanco */
            box-shadow: 0 8px 15px rgba(0,0,0,0.05);
        }
    </style>
</header>

<body class="coming-soon">
    <div class="container-fluid px-4">
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card welcome-card" style="height: 200px">
                    <div class="card-body d-flex align-items-center">
                        <div class="row w-100">
                            <div class="col-6">
                                <h2 class="text-white mb-3">¡Bienvenido a PetsHome! 🐾</h2>
                                <p class="text-white opacity-90">Tu centro de gestión integral para el cuidado de mascotas</p>
                                <button class="btn btn-light btn-sm mt-2">
                                    <i class="fas fa-paw me-2"></i>Comenzar Tour
                                </button>
                            </div>
                            <div class="col-6 text-end">
                                <img src="~/images/perrita.jpg" class="img-fluid rounded-circle" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid rgba(255,255,255,0.7);" alt="Mascota">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card weather-widget" style="height: 200px">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <div class="mb-3">
                            <i class="fas fa-sun fa-3x mb-2" style="color: rgba(255,255,255,0.9);"></i>
                            <h4>24°C</h4>
                        </div>
                        <p class="mb-0">Perfecto para pasear mascotas</p>
                        <small class="opacity-75">La Ermita, Francisco Morazán</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card stat-card primary-gradient">
                    <div class="card-body text-center">
                        <div class="icon-circle text-primary">
                            <i class="fas fa-dog"></i>
                        </div>
                        <h3 class="mb-1">247</h3>
                        <p class="mb-0">Mascotas Registradas</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card stat-card success-gradient">
                    <div class="card-body text-center">
                        <div class="icon-circle text-success">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h3 class="mb-1">18</h3>
                        <p class="mb-0">Citas Hoy</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card stat-card warning-gradient">
                    <div class="card-body text-center">
                        <div class="icon-circle text-warning">
                            <i class="fas fa-pills"></i>
                        </div>
                        <h3 class="mb-1">5</h3>
                        <p class="mb-0">Medicamentos por Vencer</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card stat-card info-gradient">
                    <div class="card-body text-center">
                        <div class="icon-circle text-info">
                            <i class="fas fa-heart"></i>
                        </div>
                        <h3 class="mb-1">12</h3>
                        <p class="mb-0">Adopciones Pendientes</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4 mb-4">
                <h5 class="mb-3 text-secondary">Acciones Rápidas</h5>
                <div class="row">
                    <div class="col-6 mb-3">
                        <div class="card quick-action-card text-center p-3" onclick="location.href='@Url.Action("Create", "Mascota")'">
                            <i class="fas fa-plus-circle fa-2x text-primary mb-2"></i>
                            <small class="d-block text-muted">Nueva Mascota</small>
                        </div>
                    </div>
                    <div class="col-6 mb-3">
                        <div class="card quick-action-card text-center p-3" onclick="location.href='@Url.Action("Create", "Solicitud")'">
                            <i class="fas fa-calendar-plus fa-2x text-success mb-2"></i>
                            <small class="d-block text-muted">Agendar Cita</small>
                        </div>
                    </div>
                    <div class="col-6 mb-3">
                        <div class="card quick-action-card text-center p-3" onclick="location.href='@Url.Action("Index", "Inventario")'">
                            <i class="fas fa-boxes fa-2x text-warning mb-2"></i>
                            <small class="d-block text-muted">Ver Inventario</small>
                        </div>
                    </div>
                    <div class="col-6 mb-3">
                        <div class="card quick-action-card text-center p-3" onclick="location.href='@Url.Action("Index", "Adopcion")'">
                            <i class="fas fa-home fa-2x text-info mb-2"></i>
                            <small class="d-block text-muted">Adopciones</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <h5 class="mb-3 text-secondary">Actividad Reciente</h5>
                <div class="card recent-activity">
                    <div class="card-body">
                        <div class="activity-item">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Hace 2 horas</small>
                                <i class="fas fa-dog text-primary"></i>
                            </div>
                            <p class="mb-1"><strong>Max</strong> fue registrado</p>
                            <small class="text-muted">Golden Retriever, 2 años</small>
                        </div>
                        <div class="activity-item">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Hace 4 horas</small>
                                <i class="fas fa-syringe text-success"></i>
                            </div>
                            <p class="mb-1">Vacuna aplicada a <strong>Luna</strong></p>
                            <small class="text-muted">Antirrábica</small>
                        </div>
                        <div class="activity-item">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Ayer</small>
                                <i class="fas fa-heart text-danger"></i>
                            </div>
                            <p class="mb-1"><strong>Mimi</strong> fue adoptada</p>
                            <small class="text-muted">Por la familia González</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <h5 class="mb-3 text-secondary">Mascotas Destacadas</h5>
                <div class="card carousel-card">
                    <div id="petCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner" style="height: 200px">
                            <div class="carousel-item active">
                                <img class="d-block w-100 img-fluid" src="~/images/PerroFondoMorado (1).jpg" alt="Mascota 1" style="height: 200px; object-fit: cover;">
                                <div class="carousel-caption d-none d-md-block">
                                    <h6>Rocky</h6>
                                    <p>Disponible para adopción</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img class="d-block w-100 img-fluid" src="~/images/PerroFondoMorado (2).jpg" alt="Mascota 2" style="height: 200px; object-fit: cover;">
                                <div class="carousel-caption d-none d-md-block">
                                    <h6>Bella</h6>
                                    <p>Busca familia amorosa</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img class="d-block w-100 img-fluid" src="~/images/PerroFondoMorado (3).jpg" alt="Mascota 3" style="height: 200px; object-fit: cover;">
                                <div class="carousel-caption d-none d-md-block">
                                    <h6>Charlie</h6>
                                    <p>Muy juguetón</p>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#petCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#petCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h5 class="mb-3 text-secondary">Próximas Citas</h5>
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                                <div>
                                    <h6 class="mb-1">Consulta General - Max</h6>
                                    <small class="text-muted">Dr. García • 10:30 AM</small>
                                </div>
                                <span class="badge bg-primary rounded-pill">Hoy</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                                <div>
                                    <h6 class="mb-1">Vacunación - Luna</h6>
                                    <small class="text-muted">Dr. Martínez • 2:00 PM</small>
                                </div>
                                <span class="badge bg-success rounded-pill">Hoy</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                                <div>
                                    <h6 class="mb-1">Cirugía - Buddy</h6>
                                    <small class="text-muted">Dr. López • 9:00 AM</small>
                                </div>
                                <span class="badge bg-warning text-dark rounded-pill">Mañana</span>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <a href="@Url.Action("Index", "Citas")" class="btn btn-outline-primary btn-sm">Ver todas las citas</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <h5 class="mb-3 text-secondary">Consejos y Recordatorios</h5>
                <div class="card tip-card">
                    <div class="card-body">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-lightbulb fa-2x text-warning"></i>
                            </div>
                            <div>
                                <h6 class="card-title">💡 Tip de Cuidado</h6>
                                <p class="card-text">El ejercicio regular es fundamental para la salud física y mental de las mascotas. Un perro adulto necesita al menos 30 minutos de actividad diaria.</p>
                                <small class="text-muted">Fuente: Asociación Veterinaria Mundial</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-danger">⚠️ Recordatorios Importantes</h6>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><i class="fas fa-exclamation-triangle text-warning me-2"></i>5 medicamentos vencen esta semana</li>
                            <li class="mb-2"><i class="fas fa-calendar-alt text-info me-2"></i>Revisión de inventario programada para mañana</li>
                            <li><i class="fas fa-bell text-primary me-2"></i>3 mascotas necesitan refuerzo de vacunas</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Auto-advance carousel
        var petCarousel = new bootstrap.Carousel(document.getElementById('petCarousel'), {
            interval: 4000,
            wrap: true
        });

        // Add click animation to stat cards
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('click', function() {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);
            });
        });
    </script>
</body>
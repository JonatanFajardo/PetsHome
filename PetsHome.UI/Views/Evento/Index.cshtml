@model EventoViewModel
@{
    ViewData["Title"] = "Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["UseDatatableInit"] = true;
    ViewData["UsePdfExport"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header púrpura con todos los controles -->
    <div class="pets-header-full">
        <breadcrumb></breadcrumb>
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fa-calendar-alt mr-2 text-white"></i>Gestión de Eventos</h2>
                <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Create")'">
                    <i class="fas fa-plus mr-2"></i>Nuevo Evento
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por nombre, descripción o ubicación...">
                </div>
                <div class="action-buttons">
                    <div class="view-toggle">
                        <button class="btn-control active" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                        <button class="btn-control" id="calViewBtn" onclick="toggleView('calendar')">
                            <i class="fas fa-calendar-alt"></i><span>Calendario</span>
                        </button>
                    </div>
                    <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vista de Tabla -->
    <div id="tableView" class="pets-table-container">
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th>Descripción</th>
                    <th>Evento</th>
                    <th>Refugio</th>
                    <th width="140">Fecha</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargará los datos aquí -->
            </tbody>
        </table>
    </div>


    <!-- Vista de Cards (oculta por defecto) -->
    <div id="gridView" style="display: none;">
        <div class="row" id="eventosGrid">
            <!-- Las tarjetas se generaran dinamicamente -->
        </div>
    </div>

    <!-- Vista Calendario -->
    <div id="calView" style="display:none; padding:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <button onclick="Evento.prevMes()" style="background:none;border:1px solid #dce1e9;border-radius:7px;padding:5px 12px;cursor:pointer;"><i class="fas fa-chevron-left"></i></button>
            <span id="cal-mes-anio" style="font-size:15px;font-weight:600;color:#1a1d21;"></span>
            <button onclick="Evento.nextMes()" style="background:none;border:1px solid #dce1e9;border-radius:7px;padding:5px 12px;cursor:pointer;"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:0;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Lu</div>
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Ma</div>
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Mi</div>
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Ju</div>
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Vi</div>
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Sa</div>
            <div style="background:#f8f9fb;padding:8px;text-align:center;font-size:12px;font-weight:600;color:#6b7280;border-bottom:1px solid #e5e7eb;">Do</div>
        </div>
        <div id="cal-grid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:0;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 10px 10px;overflow:hidden;"></div>
    </div>

    <!-- Modal evento del calendario -->
    <div class="modal fade" id="calEventoModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-calendar-alt mr-2"></i><span id="cal-modal-nombre"></span></h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <div class="modal-body">
                    <p><i class="fas fa-home mr-2 text-muted"></i><span id="cal-modal-refugio"></span></p>
                    <p><i class="fas fa-calendar-day mr-2 text-muted"></i><span id="cal-modal-fecha"></span></p>
                </div>
                <div class="modal-footer border-0">
                    <a id="cal-modal-detalle" href="#" class="btn btn-primary btn-sm px-3">
                        <i class="fas fa-eye mr-1"></i>Ver detalle completo
                    </a>
                    <a id="cal-modal-editar" href="#" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="fas fa-edit mr-1"></i>Editar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="eve_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>¿Está seguro de eliminar este evento?</h5>
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.init.js"></script>
<script>
    // Inicializar tooltips
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
<script src="~/js/pages/evento.js"></script>
<script>
    // Configuración del DataTable
    Evento.datatable({
        urlList: "@Url.Action("List")",
        urlDetail: "@Url.Action("Detail")",
        urlInsert: "@Url.Action("Create")",
        urlUpdate: "@Url.Action("Find")"
    });

    // Búsqueda global
    $('#globalSearch').on('keyup', function() {
        $('#datatable').DataTable().search(this.value).draw();
    });


    // URLs para calendario
    window._urlEventoDetail = '@Url.Action("Detail")';
    window._urlEventoFind   = '@Url.Action("Find")';

    // Alternar entre vista tabla, cards y calendario
    function toggleView(view) {
        $('#tableView').hide(); $('#gridView').hide(); $('#calView').hide();
        $('#tableViewBtn, #gridViewBtn, #calViewBtn').removeClass('active');
        if (view === 'table') {
            $('#tableView').show(); $('#tableViewBtn').addClass('active');
        } else if (view === 'grid') {
            $('#gridView').show(); $('#gridViewBtn').addClass('active');
            loadCardsView();
        } else if (view === 'calendar') {
            $('#calView').show(); $('#calViewBtn').addClass('active');
            Evento.renderCalendar();
        }
    }

    // Re-render si el calendario está visible y la tabla recarga
    $('#datatable').on('draw.dt', function () {
        if ($('#calView').is(':visible')) Evento.renderCalendar();
    });

    // Cargar vista de tarjetas
    function loadCardsView() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();
        var html = '';

        if (data.length === 0) {
            html = '<div class="col-12 text-center py-5"><p class="text-muted">No se encontraron registros</p></div>';
        } else {
            data.each(function(row) {
                
                html += `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card-item">
                            <div style="position: relative;">
                                <div class="card-item-img">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <span class="card-badge">#${String(row.eve_Id).padStart(3, '0')}</span>
                            </div>
                            <div class="p-3">
                                <h5 class="mb-1">${row.eve_Descripcion}</h5>
                                <p class="text-muted small mb-2">${row.eve_Fecha}</p>
                                <p class="text-muted mb-2"><i class="fas fa-info-circle mr-2"></i>${row.refg_Nombre}</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    
                                    <div>
                                        <button class="action-btn btn-view" onclick="viewItem(${row.eve_Id})" title="Ver">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="action-btn btn-edit" onclick="editItem(${row.eve_Id})" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn btn-delete" onclick="deleteItem(${row.eve_Id})" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        $('#cardsGrid').html(html);
    }

    // Funciones para acciones
    function viewItem(id) {
        window.location.href = '@Url.Action("Detail")' + '/' + id;
    }

    function editItem(id) {
        window.location.href = '@Url.Action("Find")' + '/' + id;
    }

    function deleteItem(id) {
        $('#delete-item-id').val(id);
        $('#delete-modal').modal('show');
    }

    function getEstadoBadge(estado) {
        var badges = {
            'Disponible': '<span class="status-badge status-disponible">Disponible</span>',
            'Adoptado': '<span class="status-badge status-adoptado">Adoptado</span>',
            'En Tratamiento': '<span class="status-badge status-tratamiento">En Tratamiento</span>',
            'Activo': '<span class="status-badge status-activo">Activo</span>',
            'Inactivo': '<span class="status-badge status-inactivo">Inactivo</span>',
            'Pendiente': '<span class="status-badge status-pendiente">Pendiente</span>',
            'Aprobado': '<span class="status-badge status-aprobado">Aprobado</span>'
        };
        return badges[estado] || badges['Activo'];
    }


    // Exportar a PDF
    function exportPDF() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-pdf').trigger();
    }

    // Exportar a Excel
    function exportExcel() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-excel').trigger();
    }

    // Exportar a CSV (mejorado)
    function exportCSV() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();

        var csv = 'ID,Descripción,Evento,Refugio,Fecha\n';
        data.each(function(row) {
            // Implementar según estructura de datos
            console.log('Exportar CSV - Implementar según datos');
        });

        var blob = new Blob([csv], { type: 'text/csv' });
        var url = window.URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'evento_' + new Date().toISOString().slice(0,10) + '.csv';
        a.click();
    }
</script>
<style>
    .cal-cell { min-height:80px; border-right:1px solid #e5e7eb; border-bottom:1px solid #e5e7eb; padding:4px 6px; background:#fff; vertical-align:top; }
    .cal-cell:nth-child(7n) { border-right:none; }
    .cal-cell-off { background:#f9fafb; }
    .cal-cell-hoy { background:#6C5CE7 !important; }
    .cal-cell-hoy .cal-dia-num { color:#fff !important; }
    .cal-dia-num { font-size:12px; font-weight:600; color:#374151; margin-bottom:3px; }
    .cal-pill { font-size:11px; padding:2px 6px; border-radius:4px; background:#ede9fe; color:#5b21b6; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:2px; }
    .cal-pill:hover { background:#ddd6fe; }
    .cal-pill-more { background:#f3f4f6; color:#6b7280; cursor:default; }
</style>
}

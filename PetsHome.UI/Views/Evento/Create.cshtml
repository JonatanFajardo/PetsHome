@model EventoViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" id="formulario">
    <form asp-action="Add" method="post" autocomplete="ON" enctype="multipart/form-data">
        <input class="form-control" asp-for="eve_Id" type="hidden" />

        <!-- Información del Evento -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-info text-white d-flex align-items-center">
                <i class="fas fa-calendar-plus fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información del Evento</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="eve_Descripcion">Descripción</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-align-left"></i></span>
                                <input class="form-control" asp-for="eve_Descripcion" type="text" placeholder="Descripción del evento" />
                            </div>
                            <span class="text-danger" asp-validation-for="eve_Descripcion"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Id">Refugio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-home"></i></span>
                                <select class="form-control" asp-for="refg_Id" asp-items="Model.refugioList">
                                    <option value="">-- Seleccionar Refugio --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Id"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Horario del Evento -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-vitals text-white d-flex align-items-center">
                <i class="fas fa-clock fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Horario del Evento</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="eve_HoraInicio">Hora de Inicio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-play"></i></span>
                                <input class="form-control" asp-for="eve_HoraInicio" type="time" />
                            </div>
                            <span class="text-danger" asp-validation-for="eve_HoraInicio"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="eve_HoraFinal">Hora de Finalización</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-stop"></i></span>
                                <input class="form-control" asp-for="eve_HoraFinal" type="time" />
                            </div>
                            <span class="text-danger" asp-validation-for="eve_HoraFinal"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="eve_Fecha">Fecha del Evento</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                <input class="form-control" asp-for="eve_Fecha" type="date"
                                       value="@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.Now, "Central America Standard Time").ToString("yyyy-MM-ddTHH:mm")" />
                            </div>
                            <span class="text-danger" asp-validation-for="eve_Fecha"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="actions-wrapper">
            <div class="actions-title">Acciones</div>
            <div class="actions-divider"></div>
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">* Los cambios se guardarán permanentemente</small>
                <div class="d-flex">
                    <a class="btn btn-modern btn-outline-cancel mr-3" asp-action="Index">
                        <i class="fas fa-times btn-icon"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-modern btn-solid-save">
                        <i class="fas fa-check btn-icon"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts{
<script src="~/js/load-dropdownlist.js"></script>
<script src="~/js/helpers-custom/image-Extension.js"></script>
}

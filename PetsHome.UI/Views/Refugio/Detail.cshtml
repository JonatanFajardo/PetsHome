@model RefugioViewModel
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="avatar-container position-relative">
                                <div class="avatar-circle bg-light d-flex align-items-center justify-content-center">
                                    <i class="fas fa-home text-primary fa-2x"></i>
                                </div>
                                <div class="avatar-status bg-success"></div>
                            </div>
                        </div>
                        <div class="col">
                            <h4 class="mb-1 text-white font-weight-bold">@Model.refg_Nombre</h4>
                            <div class="mb-2">
                                <span class="badge badge-light text-primary px-3 py-1">
                                    <i class="fas fa-shield-alt mr-1"></i>@Model.EsActivo
                                </span>
                            </div>
                            <p class="text-white-50 mb-0">
                                <i class="fas fa-envelope mr-1"></i>@Model.refg_Correo
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <!-- Información General -->
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-info-circle text-primary mr-2"></i>Información General
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">ID:</span>
                                        <span class="info-value badge badge-outline-primary">@Model.refg_Id</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Nombre:</span>
                                        <span class="info-value">@Model.refg_Nombre</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Ubicación:</span>
                                        <span class="info-value">
                                            <i class="fas fa-map-marker-alt text-muted mr-1"></i>
                                            @Model.refg_Ubicacion
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">RTN:</span>
                                        <span class="info-value">@Model.refg_RTN</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Teléfono:</span>
                                        <span class="info-value">
                                            <i class="fas fa-phone text-muted mr-1"></i>
                                            @Model.refg_Telefono
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Correo:</span>
                                        <span class="info-value">
                                            <i class="fas fa-envelope text-muted mr-1"></i>
                                            @Model.refg_Correo
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Estado:</span>
                                        <span class="info-value badge badge-success text-white">@Model.EsActivo</span>
                                    </div>
                                </div>
                            </div>
                            <div class="info-section mt-4">
                                <h6 class="section-title">
                                    <i class="fas fa-clipboard-list text-info mr-2"></i>Información Adicional
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">Descripción:</span>
                                        <div class="info-value">
                                            <div class="bg-light p-3 rounded">
                                                <i class="fas fa-info text-muted mr-1"></i>
                                                @Model.refg_InformacionAdicional
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información Adicional y Ubicación -->
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-map text-success mr-2"></i>Ubicación Administrativa
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">Departamento:</span>
                                        <span class="info-value">
                                            <i class="fas fa-building text-muted mr-1"></i>
                                            @Model.depto_Descripcion
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Municipio:</span>
                                        <span class="info-value">
                                            <i class="fas fa-city text-muted mr-1"></i>
                                            @Model.mpio_Descripcion
                                        </span>
                                    </div>
                                </div>
                            </div>


                            <div class="info-section mt-4">
                                <h6 class="section-title">
                                    <i class="fas fa-history text-warning mr-2"></i>Información de Auditoría
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">Creado por:</span>
                                        <span class="info-value">
                                            <i class="fas fa-user text-muted mr-1"></i>
                                            @Model.refg_NombreUsuarioCrea
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Fecha Creación:</span>
                                        <span class="info-value">
                                            <i class="fas fa-plus-circle text-muted mr-1"></i>
                                            @Model.refg_FechaCrea.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Modificado por:</span>
                                        <span class="info-value">
                                            <i class="fas fa-user-edit text-muted mr-1"></i>
                                            @(Model.refg_NombreUsuarioModifica ?? "N/A")
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Fecha Modificación:</span>
                                        <span class="info-value">
                                            <i class="fas fa-edit text-muted mr-1"></i>
                                            @(Model.refg_FechaModifica?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light no-print">
                    <div class="row">
                        <div class="col-md-6">
                            <a href="/Refugio/Find/@Model.refg_Id" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit mr-1"></i>Editar
                            </a>
                            <button id="btnImprimir" class="btn btn-outline-secondary btn-sm ml-2">
                                <i class="fas fa-print mr-1"></i>Imprimir
                            </button>
                            <button class="btn btn-outline-info btn-sm ml-2">
                                <i class="fas fa-map mr-1"></i>Ver Ubicación
                            </button>
                        </div>
                        <div class="col-md-6 text-right">
                            <small class="text-muted">
                                <i class="fas fa-clock mr-1"></i>
                                Última actualización: @(Model.refg_FechaModifica?.ToString("dd/MM/yyyy") ?? "N/A")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

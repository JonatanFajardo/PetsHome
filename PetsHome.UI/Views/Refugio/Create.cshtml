@model RefugioViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" id="formulario">
    <form asp-action="Add" method="post" autocomplete="ON" enctype="multipart/form-data">
        <input class="form-control" asp-for="refg_Id" type="hidden" />

        <!-- Información Básica -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-info text-white d-flex align-items-center">
                <i class="fas fa-info-circle fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información Básica</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Nombre">Nombre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-home"></i></span>
                                <input class="form-control" asp-for="refg_Nombre" type="text" placeholder="Nombre del refugio" />
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Nombre"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Ubicacion">Ubicación</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                <input class="form-control" asp-for="refg_Ubicacion" type="text" placeholder="Dirección del refugio" />
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Ubicacion"></span>
                        </div>
                    </div>
                    <!-- Campo Identidad -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_RTN" for="Identidad">Identidad</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                <input class="form-control" asp-for="refg_RTN" type="text"
                                       id="identidadInput"
                                       placeholder="0000-0000-00000"
                                       maxlength="15"
                                       pattern="[0-9]{4}-[0-9]{4}-[0-9]{5}" />
                            </div>
                            <span class="text-danger" asp-validation-for="refg_RTN"></span>
                        </div>
                    </div>
                    <!-- Campo Telefono -->
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Telefono">Teléfono</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input class="form-control"
                                       asp-for="refg_Telefono"
                                       type="text"
                                       id="telefonoInput"
                                       placeholder="0000-0000"
                                       maxlength="9"
                                       pattern="[0-9]{4}-[0-9]{4}" />
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Telefono"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Correo">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input class="form-control" asp-for="refg_Correo" type="email" placeholder="correo@ejemplo.com" />
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Correo"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Estado</label>
                            <div class="form-check">
                                <input type="checkbox" asp-for="refg_EsActivo" class="form-check-input" id="refg_EsActivo" />
                                <label class="form-check-label" for="refg_EsActivo" asp-for="refg_EsActivo">
                                    <i class="fas fa-toggle-on me-2"></i>Refugio activo
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ubicación Geográfica -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-vitals text-white d-flex align-items-center">
                <i class="fas fa-globe-americas fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Ubicación Geográfica</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="depto_Id">Departamento</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-flag"></i></span>
                                <select class="form-control" asp-for="depto_Id" asp-items="Model.departamentoList">
                                    <option value="">-- Seleccionar Departamento --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="depto_Id"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="mpio_Id">Municipio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-city"></i></span>
                                <select class="form-control" asp-for="mpio_Id" asp-items="Model.municipioList">
                                    <option value="">-- Seleccionar Municipio --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="mpio_Id"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información Adicional -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-treatment text-white d-flex align-items-center">
                <i class="fas fa-clipboard-list fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información Adicional</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_InformacionAdicional">Información Adicional</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-sticky-note"></i></span>
                                <textarea class="form-control" asp-for="refg_InformacionAdicional" rows="4" placeholder="Información adicional sobre el refugio..."></textarea>
                            </div>
                            <span class="text-danger" asp-validation-for="refg_InformacionAdicional"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="text-right mt-4">
            <a class="btn btn-secondary btn-lg" asp-action="Index">
                <i class="fas fa-times"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-primary btn-lg me-3">
                <i class="fas fa-save"></i> Guardar
            </button>
        </div>
    </form>
</div>

@section Scripts{
<script src="~/js/load-dropdownlist.js"></script>
<script src="~/js/helpers-custom/Input-formatter.js"></script>
<script src="~/js/helpers-custom/image-Extension.js"></script>
}
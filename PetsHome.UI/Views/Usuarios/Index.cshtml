@model PetsHome.Business.Models.UsuarioCrudViewModel
@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
        <div class="pets-header-full">
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white"><i class="fas fa-users mr-2 text-white"></i>Gestion de Usuarios</h2>
                    <button class="btn-nueva-mascota" data-toggle="modal" data-target="#edit-modal" id="add-btn-header">
                        <i class="fas fa-plus mr-2"></i>Nuevo Usuario
                    </button>
                </div>
                <div class="pets-controls">
                    <div class="search-container">
                        <i class="fas fa-search"></i>
                        <input type="text" id="globalSearch" placeholder="Buscar usuario...">
                    </div>
                    <div class="action-buttons">
                        <button class="btn-export-datatable" onclick="$('#datatable').DataTable().ajax.reload()">
                            <i class="fas fa-sync-alt mr-1"></i>Recargar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="datatable" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-user-edit mr-2"></i>Gestion de Usuario</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form-usuario">
                <div class="modal-body">
                    <input type="hidden" id="item-id" name="usu_Id" value="0" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Nombre de Usuario <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="Usu_Nombre" name="Usu_Nombre" placeholder="Ej: jsmith" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Rol <span class="text-danger">*</span></label>
                                <select class="form-control" id="Rol_Id" name="Rol_Id" required>
                                    <option value="">Seleccione un rol</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Empleado Id</label>
                                <input type="number" class="form-control" id="Emp_Id" name="Emp_Id" value="0" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Estado</label>
                                <div class="mt-2">
                                    <input type="checkbox" id="Usu_EsActivo" name="Usu_EsActivo" value="true" checked />
                                    <label for="Usu_EsActivo">Usuario activo</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-1"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 440px;">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body text-center px-5 pb-4">
                <div class="mb-3">
                    <div style="width:70px;height:70px;background:#fee2e2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;">
                        <i class="fas fa-exclamation-triangle text-danger fa-2x"></i>
                    </div>
                </div>
                <h5 class="mb-2">Eliminar usuario</h5>
                <p class="text-muted mb-3">Esta seguro de eliminar al usuario <strong id="delete-item-name"></strong>?</p>
                <input type="hidden" id="delete-item-id" />
            </div>
            <div class="modal-footer border-0 px-5 pb-4" style="gap:12px;">
                <button type="button" class="btn btn-secondary flex-fill" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger flex-fill" id="btn-confirm-delete">Eliminar</button>
            </div>
        </div>
    </div>
</div>


@model HistorialMedicoViewModel
@{
    ViewData["Title"] = "Detalles de Historial Médico";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var esterilizado = Model.medic_Esterilizacion == true ? "Sí" : "No";
    var esterilizadoColor = Model.medic_Esterilizacion == true ? "status-activo" : "status-inactivo";
    var esterilizadoIcono = Model.medic_Esterilizacion == true ? "fa-check-circle" : "fa-times-circle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-file-medical"></i>
                        </div>
                        <div class="profile-badge">#@Model.medic_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>Ficha Médica #@Model.medic_Id</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-paw"></i>
                            <span>@Model.Mascota</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas @esterilizadoIcono"></i>
                                <span>Esterilizado: @esterilizado</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Comportamiento))
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-smile"></i>
                                    <span>@Model.Comportamiento</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                    <button type="button" class="btn-detail btn-detail-danger" onclick="confirmDelete(@Model.medic_Id)">
                        <i class="fas fa-trash"></i>
                        <span>Eliminar</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información General -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información General</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-paw"></i>
                                    <span>Mascota</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.Mascota</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-cut"></i>
                                    <span>Esterilización</span>
                                </div>
                                <div class="detail-value">
                                    <span class="status-badge @esterilizadoColor">@esterilizado</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Comportamiento))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-smile"></i>
                                        <span>Comportamiento</span>
                                    </div>
                                    <div class="detail-value">@Model.Comportamiento</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Información Médica -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-notes-medical"></i>
                        <h3>Información Médica</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            @if (!string.IsNullOrEmpty(Model.medic_SaludCuidado))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-heartbeat"></i>
                                        <span>Cuidado de Salud</span>
                                    </div>
                                    <div class="detail-value">@Model.medic_SaludCuidado</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.medic_InformacionAdicional))
                {
                    <!-- Información Adicional -->
                    <div class="detail-card detail-card-full">
                        <div class="detail-card-header">
                            <i class="fas fa-file-alt"></i>
                            <h3>Información Adicional</h3>
                        </div>
                        <div class="detail-card-body">
                            <div class="detail-list">
                                <div class="detail-item">
                                    <div class="detail-value">@Model.medic_InformacionAdicional</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Información de Auditoría -->
                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Creado por</span>
                                        </div>
                                        <div class="detail-value">@(Model.medic_NombreUsuarioCrea ?? "Sistema")</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-calendar-plus"></i>
                                            <span>Fecha de creación</span>
                                        </div>
                                        <div class="detail-value">@Model.medic_FechaCrea.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                                @if (Model.medic_UsuarioModifica.HasValue)
                                {
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-user-edit"></i>
                                                <span>Modificado por</span>
                                            </div>
                                            <div class="detail-value">@(Model.medic_NombreUsuarioModifica ?? "Sistema")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-calendar-check"></i>
                                                <span>Última modificación</span>
                                            </div>
                                            <div class="detail-value">@(Model.medic_FechaModifica?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="delete-confirm-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Remove" method="post">
                <input type="hidden" name="medic_Id" id="delete-medic-id">
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h5>¿Está seguro de eliminar este historial médico?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            $('#delete-medic-id').val(id);
            $('#delete-confirm-modal').modal('show');
        }
    </script>
}

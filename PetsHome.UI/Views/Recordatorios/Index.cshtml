@{
    ViewData["Title"] = "Recordatorios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Recordatorios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
        <!-- Header -->
        <div class="pets-header-full">
            <breadcrumb></breadcrumb>
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white"><i class="fas fa-bell mr-2 text-white"></i>Recordatorios</h2>
                    <div style="display:flex;gap:10px;flex-wrap:wrap;">
                        <button class="btn-nueva-mascota btn-insertar" id="btnGenerar">
                            <i class="fas fa-wand-magic-sparkles mr-2"></i>Generar recordatorios
                        </button>
                    </div>
                </div>
                <p class="text-white mb-0 mt-2" style="opacity:0.9;">
                    Tareas de seguimiento: "a esta mascota le toca algo en tal fecha" (refuerzo de vacuna, control).
                    El botón "Generar" los crea solo desde las vacunas aplicadas y las próximas citas. No envía correo ni mensajes.
                </p>

                <!-- Filtros -->
                <div class="pets-controls" style="gap:12px;flex-wrap:wrap;">
                    <div class="search-container">
                        <i class="fas fa-search"></i>
                        <input type="text" id="globalSearch" placeholder="Buscar por mascota, responsable o tipo...">
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                        <select id="fEstado" class="form-control" style="width:auto;">
                            <option value="Pendiente">Pendientes</option>
                            <option value="Enviado">Enviados</option>
                            <option value="Hecho">Hechos</option>
                            <option value="Descartado">Descartados</option>
                            <option value="">Todos</option>
                        </select>
                        <input type="date" id="fDesde" class="form-control" style="width:auto;" title="Desde (fecha objetivo)">
                        <input type="date" id="fHasta" class="form-control" style="width:auto;" title="Hasta (fecha objetivo)">
                        <button class="btn-export-datatable" id="btnFiltrar"><i class="fas fa-filter mr-1"></i>Filtrar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="pets-table-container">
            <table class="pets-table" id="tablaRecordatorios">
                <thead>
                    <tr>
                        <th>Mascota</th>
                        <th>Responsable</th>
                        <th width="140">Tipo</th>
                        <th width="140">Fecha objetivo</th>
                        <th width="120">Faltan</th>
                        <th width="120">Estado</th>
                        <th>Nota</th>
                        <th width="160" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="cuerpoTabla">
                    <tr><td colspan="8" style="text-align:center;padding:24px;color:#9ca3af;">Cargando…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window._urls = {
        list:          '@Url.Action("List")',
        detail:        '@Url.Action("Detail")',
        generar:       '@Url.Action("Generar")',
        marcarHecho:   '@Url.Action("MarcarHecho")',
        descartar:     '@Url.Action("Descartar")',
        marcarEnviado: '@Url.Action("MarcarEnviado")'
    };
</script>
<script src="~/js/pages/recordatorios.js"></script>
}

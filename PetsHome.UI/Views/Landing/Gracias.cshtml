@using System
@{
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "amigo/a";
    var mascota = ViewBag.Mascota as PetsHome.Business.Models.MascotaDetailsViewModel;
    var imgSrc = mascota?.masc_Imagen != null && mascota.masc_Imagen.Length > 0
        ? $"data:image/jpeg;base64,{Convert.ToBase64String(mascota.masc_Imagen)}"
        : "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=600&h=600&fit=crop";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>¡Solicitud enviada! — PetsHome</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=Inter:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="~/css/landing-page.css"/>
  <style>
    body { background: #f8f9fe; font-family: 'Inter', sans-serif; margin: 0; min-height: 100vh; display: flex; flex-direction: column; }

    .success-nav {
      background: rgba(255,255,255,.95); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(108,92,231,.08); padding: .75rem 0;
    }

    .success-wrap {
      flex: 1; display: flex; align-items: center; justify-content: center;
      padding: 3rem 1rem;
    }

    .success-card {
      background: #fff; border-radius: 2rem;
      box-shadow: 0 20px 60px rgba(108,92,231,.12);
      max-width: 680px; width: 100%; overflow: hidden;
      animation: slideUp .6s cubic-bezier(.16,1,.3,1) both;
    }
    @@keyframes slideUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Top banner */
    .success-banner {
      background: linear-gradient(135deg, var(--ph-primary) 0%, var(--ph-primary-dk) 100%);
      padding: 3rem 2.5rem 2rem; text-align: center; position: relative; overflow: hidden;
    }
    .success-banner::before {
      content: ''; position: absolute; inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .check-circle {
      width: 80px; height: 80px; border-radius: 50%;
      background: rgba(255,255,255,.15); backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.5rem; position: relative;
      animation: popIn .5s .3s cubic-bezier(.16,1,.3,1) both;
    }
    @@keyframes popIn {
      from { opacity: 0; transform: scale(.5); }
      to   { opacity: 1; transform: scale(1); }
    }
    .check-circle i { font-size: 2rem; color: #fff; }
    .banner-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 900; font-size: 1.75rem; color: #fff; margin-bottom: .5rem;
    }
    .banner-sub { color: rgba(255,255,255,.8); font-size: .95rem; }

    /* Body */
    .success-body { padding: 2.5rem; }

    /* Animal preview */
    .animal-preview {
      display: flex; align-items: center; gap: 1.25rem;
      background: #f8f9fe; border-radius: 1.25rem; padding: 1.25rem;
      border: 1px solid rgba(108,92,231,.1); margin-bottom: 2rem;
    }
    .animal-preview-img {
      width: 72px; height: 72px; border-radius: 1rem; object-fit: cover; flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(0,0,0,.1);
    }
    .animal-preview-name {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800; font-size: 1.1rem; color: #0e1726;
    }
    .animal-preview-breed { color: #6b7280; font-size: .875rem; }

    /* Steps */
    .steps-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700; font-size: .85rem; color: #0e1726;
      margin-bottom: 1rem; display: flex; align-items: center; gap: .5rem;
    }
    .steps-title i { color: var(--ph-primary); }

    .step-item {
      display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: flex-start;
    }
    .step-num {
      width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: .9rem;
    }
    .step-num-1 { background: #ede9fe; color: var(--ph-primary); }
    .step-num-2 { background: #d1fae5; color: #059669; }
    .step-num-3 { background: #fef3c7; color: #d97706; }
    .step-text strong { display: block; font-weight: 700; color: #0e1726; font-size: .9rem; margin-bottom: .15rem; }
    .step-text span { color: #6b7280; font-size: .83rem; }

    /* Actions */
    .success-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
    .btn-primary-sol {
      flex: 1; min-width: 160px; padding: .85rem 1.5rem; text-align: center;
      background: linear-gradient(135deg, var(--ph-primary) 0%, var(--ph-primary-dk) 100%);
      color: #fff; border-radius: .875rem; font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700; font-size: .9rem; text-decoration: none;
      display: flex; align-items: center; justify-content: center; gap: .5rem;
      transition: transform .2s, box-shadow .2s;
    }
    .btn-primary-sol:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(108,92,231,.3); color: #fff; text-decoration: none; }
    .btn-ghost-sol {
      flex: 1; min-width: 160px; padding: .85rem 1.5rem; text-align: center;
      background: #f8f9fe; color: #374151; border-radius: .875rem;
      font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: .9rem;
      text-decoration: none; border: 1.5px solid #e5e7eb;
      display: flex; align-items: center; justify-content: center; gap: .5rem;
      transition: background .2s;
    }
    .btn-ghost-sol:hover { background: #f3f4f6; color: #374151; text-decoration: none; }

    /* Confetti dots (decorative) */
    .confetti { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; overflow: hidden; }
    .dot { position: absolute; border-radius: 50%; opacity: .6; animation: fall linear infinite; }
    @@keyframes fall {
      from { transform: translateY(-20px) rotate(0deg); opacity: .8; }
      to   { transform: translateY(120px) rotate(360deg); opacity: 0; }
    }
  </style>
</head>
<body>

<!-- Navbar -->
<nav class="success-nav">
  <div class="container d-flex align-items-center justify-content-between">
    <a class="d-flex align-items-center" href="@Url.Action("Index","Landing")" style="gap:.6rem;text-decoration:none;">
      <div class="nav-logo-icon"><i class="fa-solid fa-paw"></i></div>
      <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:1.05rem;color:#0e1726;">PetsHome</span>
    </a>
  </div>
</nav>

<div class="success-wrap">
  <div class="success-card">

    <!-- Banner -->
    <div class="success-banner">
      <div class="confetti" id="confetti"></div>
      <div class="check-circle">
        <i class="fa-solid fa-check"></i>
      </div>
      <div class="banner-title">¡Solicitud enviada, @nombre.Split(' ')[0]!</div>
      <div class="banner-sub">Tu solicitud fue registrada. El equipo de PetsHome se pondrá en contacto contigo pronto. ¡Gracias por querer cambiar una vida!</div>
    </div>

    <!-- Body -->
    <div class="success-body">

      <!-- Animal -->
      @if (mascota != null)
      {
        <div class="animal-preview">
          <img src="@imgSrc" alt="@mascota.masc_Nombre" class="animal-preview-img"/>
          <div>
            <div class="animal-preview-name">@mascota.masc_Nombre</div>
            <div class="animal-preview-breed">@mascota.raza_Descripcion · @mascota.refg_Nombre</div>
            <div style="margin-top:.4rem;">
              <span style="background:#fef3c7;color:#92400e;font-size:.72rem;font-weight:700;padding:.2rem .6rem;border-radius:999px;">
                <i class="fa-solid fa-clock mr-1"></i>En revisión
              </span>
            </div>
          </div>
        </div>
      }

      <!-- Próximos pasos -->
      <div class="steps-title"><i class="fa-solid fa-list-check"></i> ¿Qué sigue ahora?</div>

      <div class="step-item">
        <div class="step-num step-num-1">1</div>
        <div class="step-text">
          <strong>Revisamos tu solicitud</strong>
          <span>El equipo del refugio revisará tu información en los próximos 1-2 días hábiles.</span>
        </div>
      </div>
      <div class="step-item">
        <div class="step-num step-num-2">2</div>
        <div class="step-text">
          <strong>Te contactamos</strong>
          <span>El equipo de PetsHome se pondrá en contacto contigo por teléfono o correo para coordinar una visita.</span>
        </div>
      </div>
      <div class="step-item">
        <div class="step-num step-num-3">3</div>
        <div class="step-text">
          <strong>¡Bienvenido a casa!</strong>
          <span>Tras la entrevista y aprobación, @(mascota?.masc_Nombre ?? "tu nuevo amigo") llega a su hogar definitivo.</span>
        </div>
      </div>

      <!-- Acciones -->
      <div class="success-actions">
        <a href="@Url.Action("Animales","Landing")" class="btn-primary-sol">
          <i class="fa-solid fa-paw"></i> Ver más animales
        </a>
        <a href="@Url.Action("Index","Landing")" class="btn-ghost-sol">
          <i class="fa-solid fa-house"></i> Ir al inicio
        </a>
      </div>

    </div>
  </div>
</div>

<script>
  // Confetti decorativo
  const container = document.getElementById('confetti');
  const colors = ['#6C5CE7','#1ba9af','#fff','#fbbf24','#34d399'];
  for (let i = 0; i < 18; i++) {
    const dot = document.createElement('div');
    dot.className = 'dot';
    const size = Math.random() * 8 + 4;
    dot.style.cssText = `
      width:${size}px; height:${size}px;
      background:${colors[Math.floor(Math.random()*colors.length)]};
      left:${Math.random()*100}%;
      top:${Math.random()*100}%;
      animation-duration:${Math.random()*2+1.5}s;
      animation-delay:${Math.random()*2}s;
    `;
    container.appendChild(dot);
  }
</script>
</body>
</html>

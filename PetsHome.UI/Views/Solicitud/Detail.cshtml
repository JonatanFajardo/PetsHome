@model SolicitudViewModel
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="avatar-container position-relative">
                                <div class="avatar-circle bg-light d-flex align-items-center justify-content-center">
                                    <i class="fas fa-paw text-primary fa-2x"></i>
                                </div>
                                <div class="avatar-status bg-success"></div>
                            </div>
                        </div>
                        <div class="col">
                            <h4 class="mb-1 text-white font-weight-bold">@Model.sol_Nombres @Model.sol_Apellidos</h4>
                            <div class="mb-2">
                                <span class="badge badge-light text-primary px-3 py-1">
                                    <i class="fas fa-id-card mr-1"></i>@Model.sol_Identidad
                                </span>
                            </div>
                            <p class="text-white-50 mb-0">
                                <i class="fas fa-envelope mr-1"></i>@Model.sol_Correo
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <!-- Información del Solicitante -->
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-user text-primary mr-2"></i>Información del Solicitante
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">ID Solicitud:</span>
                                        <span class="info-value badge badge-outline-primary">@Model.sol_Id</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Identidad:</span>
                                        <span class="info-value">@Model.sol_Identidad</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Nombres:</span>
                                        <span class="info-value">@Model.sol_Nombres</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Apellidos:</span>
                                        <span class="info-value">@Model.sol_Apellidos</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Teléfono:</span>
                                        <span class="info-value">
                                            <i class="fas fa-phone text-muted mr-1"></i>
                                            @Model.sol_Telefono
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Correo:</span>
                                        <span class="info-value">
                                            <i class="fas fa-envelope text-muted mr-1"></i>
                                            @Model.sol_Correo
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Información de la Mascota -->
                        <div class="col-md-6">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-paw text-success mr-2"></i>Información de la Mascota
                                </h6>
                                <div class="info-group">
                                    <div class="info-item">
                                        <span class="info-label">ID Mascota:</span>
                                        <span class="info-value badge badge-outline-success">@Model.masc_Id</span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Imagen:</span>
                                        <div class="info-value">
                                            <img src="@Model.masc_Imagen" alt="@Model.masc_Nombre" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;">
                                        </div>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Nombre:</span>
                                        <span class="info-value">
                                            <i class="fas fa-heart text-muted mr-1"></i>
                                            @Model.masc_Nombre
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Estado:</span>
                                        <span class="info-value badge @(Model.masc_EsAdoptado ? "badge-success" : "badge-warning") text-white">
                                            @(Model.masc_EsAdoptado ? "Adoptado" : "Disponible")
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Raza:</span>
                                        <span class="info-value">
                                            <i class="fas fa-dog text-muted mr-1"></i>
                                            @Model.raza_Descripcion
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Albergue:</span>
                                        <span class="info-value">
                                            <i class="fas fa-home text-muted mr-1"></i>
                                            @Model.refg_Nombre
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="info-section">
                                <h6 class="section-title">
                                    <i class="fas fa-history text-warning mr-2"></i>Información de Auditoría
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="info-group">
                                            <div class="info-item">
                                                <span class="info-label">Creado por:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-user text-muted mr-1"></i>
                                                    @Model.sol_NombreUsuarioCrea
                                                </span>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Fecha Creación:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-plus-circle text-muted mr-1"></i>
                                                    @Model.sol_FechaCrea.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="info-group">
                                            <div class="info-item">
                                                <span class="info-label">Modificado por:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-user-edit text-muted mr-1"></i>
                                                    @(Model.sol_NombreUsuarioModifica ?? "N/A")
                                                </span>
                                            </div>

                                            <div class="info-item">
                                                <span class="info-label">Fecha Modificación:</span>
                                                <span class="info-value">
                                                    <i class="fas fa-edit text-muted mr-1"></i>
                                                    @(Model.sol_FechaModifica?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light no-print">
                    <div class="row">
                        <div class="col-md-6">
                            <button class="btn btn-primary btn-sm">
                                <i class="fas fa-edit mr-1"></i>Editar
                            </button>
                            <button id="btnImprimir" class="btn btn-outline-secondary btn-sm ml-2">
                                <i class="fas fa-print mr-1"></i>Imprimir
                            </button>
                            <button class="btn btn-outline-success btn-sm ml-2">
                                <i class="fas fa-check mr-1"></i>Aprobar
                            </button>
                            <button class="btn btn-outline-danger btn-sm ml-2">
                                <i class="fas fa-times mr-1"></i>Rechazar
                            </button>
                        </div>
                        <div class="col-md-6 text-right">
                            <small class="text-muted">
                                <i class="fas fa-clock mr-1"></i>
                                Última actualización: @(Model.sol_FechaModifica?.ToString("dd/MM/yyyy") ?? "N/A")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

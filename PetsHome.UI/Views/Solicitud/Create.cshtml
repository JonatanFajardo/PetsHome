@model SolicitudFormViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
        <!-- Header con gradiente igual al Index -->
        <div class="pets-header-full">
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white">
                        <i class="fas fa-file-alt mr-2 text-white"></i>Registro de Solicitud
                    </h2>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Index")'">
                        <i class="fas fa-arrow-left mr-2"></i>Volver al Listado
                    </button>
                </div>
                <p class="text-white mb-0 mt-2" style="opacity: 0.9;">Complete la información de la nueva solicitud</p>
            </div>
        </div>

        <!-- Contenedor del formulario -->
        <div class="pets-body-full">
            <div class="container-fluid">

    <form asp-action="Add" method="post" autocomplete="ON" enctype="multipart/form-data">
        <input class="form-control" asp-for="sol_Id" type="hidden" />

        <!-- Datos del Solicitante -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Datos del solicitante</h2>
                <p class="card-description">Información personal del solicitante</p>
            </div>
            <div class="card-content">
                <div class="form-grid">
                    <!-- Campo Identidad -->
                    <div class="form-group">
                        <label asp-for="sol_Identidad">Identidad</label>
                        <input class="form-control" asp-for="sol_Identidad" type="number" placeholder="Ingrese el número de identidad" />
                        <span class="text-danger" asp-validation-for="sol_Identidad"></span>
                    </div>

                    <!-- Campo Nombres -->
                    <div class="form-group">
                        <label asp-for="sol_Nombres">Nombres</label>
                        <input class="form-control" asp-for="sol_Nombres" type="text" placeholder="Ingrese los nombres" />
                        <span class="text-danger" asp-validation-for="sol_Nombres"></span>
                    </div>

                    <!-- Campo Apellidos -->
                    <div class="form-group">
                        <label asp-for="sol_Apellidos">Apellidos</label>
                        <input class="form-control" asp-for="sol_Apellidos" type="text" placeholder="Ingrese los apellidos" />
                        <span class="text-danger" asp-validation-for="sol_Apellidos"></span>
                    </div>

                    <!-- Campo Teléfono -->
                    <div class="form-group">
                        <label asp-for="sol_Telefono">Teléfono</label>
                        <input class="form-control" asp-for="sol_Telefono" type="number" placeholder="Ingrese el teléfono" />
                        <span class="text-danger" asp-validation-for="sol_Telefono"></span>
                    </div>

                    <!-- Campo Correo -->
                    <div class="form-group">
                        <label asp-for="sol_Correo">Correo</label>
                        <input class="form-control" asp-for="sol_Correo" type="email" placeholder="correo@ejemplo.com" />
                        <span class="text-danger" asp-validation-for="sol_Correo"></span>
                    </div>

                    <!-- Campo Fecha -->
                    <div class="form-group">
                        <label asp-for="sol_Fecha">Fecha</label>
                        <input class="form-control" asp-for="sol_Fecha" type="date" />
                        <span class="text-danger" asp-validation-for="sol_Fecha"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Datos de la Solicitud -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Datos de la solicitud</h2>
                <p class="card-description">Información de la mascota solicitada</p>
            </div>
            <div class="card-content">
                @if (Model != null && Model.masc_Id > 0)
                {
                    <div class="row">
                        <div class="col-md-5">
                            <div class="detail-card">
                                <div class="detail-card-header">
                                    <i class="fas fa-paw"></i>
                                    <h3>Mascota seleccionada</h3>
                                </div>
                                <div class="detail-card-body">
                                    <div class="d-flex align-items-center">
                                        <div style="width: 96px; height: 96px; border-radius: 12px; overflow: hidden; background: #f2f2f2; display:flex; align-items:center; justify-content:center; margin-right:16px;">
                                            @{
                                                var hasImage = Model.masc_Imagen != null && Model.masc_Imagen.Length > 0;
                                                var imgSrc = hasImage ? $"data:image/png;base64,{Convert.ToBase64String(Model.masc_Imagen)}" : Url.Content("~/images/default-pet.png");
                                            }
                                            <img src="@imgSrc" alt="@Model.masc_Nombre" style="width:100%; height:100%; object-fit:cover;" />
                                        </div>
                                        <div>
                                            <div style="font-weight:600; font-size:18px;">@Model.masc_Nombre</div>
                                            <div class="text-muted">ID: @Model.masc_Id</div>
                                            <div class="text-muted">Raza: @Model.raza_Descripcion</div>
                                            <div class="text-muted">Refugio: @Model.refg_Nombre</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="form-grid">
                                <input asp-for="masc_Id" type="hidden" />
                                <div class="form-group">
                                    <label>Mascota</label>
                                    <input class="form-control" value="@Model.masc_Nombre (ID: @Model.masc_Id)" readonly />
                                    <span class="text-muted" style="font-size: 12px;">Seleccionada desde el detalle de Mascota</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-grid">
                        <!-- Campo Mascota -->
                        <div class="form-group">
                            <label asp-for="masc_Id">Mascota</label>
                            <input class="form-control" asp-for="masc_Id" type="number" placeholder="Ingrese el ID de la mascota" />
                            <span class="text-danger" asp-validation-for="masc_Id"></span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="form-actions">
            <a class="btn btn-outline" asp-action="Index">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="mdi mdi-content-save"></i> Guardar</button>
        </div>
    </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/load-dropdownlist.js"></script>
    <script src="~/js/Extensions/image-Extension.js"></script>
}

@model EmpleadoListViewModel
@{
    ViewData["Title"] = "Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header púrpura con todos los controles -->
    <div class="pets-header-full">
        <breadcrumb></breadcrumb>
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fas fa-user-tie mr-2 text-white"></i>Gestión de Empleados</h2>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Create")'">




                    <i class="fas fa-plus mr-2"></i>Nuevo Empleado
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por código, nombre o cargo...">
                </div>
                <div class="action-buttons">
                    <div class="view-toggle">
                        <button class="btn-control active" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                    </div>
                        <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de tip de filtrado -->
    <div id="filter-tip" class="filter-tip">
        <div class="filter-tip__text">
            <i class="fas fa-hand-pointer" style="font-size: 18px;"></i>
            <span>Toca las tarjetas de abajo para filtrar entre registros <strong>activos</strong>, <strong>inactivos</strong> o ver <strong>todos</strong>.</span>
        </div>
        <button class="filter-tip__close" onclick="document.getElementById('filter-tip').style.display='none'; sessionStorage.setItem('hideEmpleadoFilterTip','1');" title="Cerrar">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <script>
        if (sessionStorage.getItem('hideEmpleadoFilterTip') === '1') {
            document.getElementById('filter-tip').style.display = 'none';
        }
    </script>

    <!-- Cards de resumen -->
    <div class="summary-cards-grid">
        <div class="summary-card summary-card--green" id="card-activos" onclick="filterByStatus('Activo')">
            <div class="summary-card__body">
                <div>
                    <div class="summary-card__title">Activos</div>
                    <div class="summary-card__count" id="count-activos">0</div>
                    <div class="summary-card__subtitle">En servicio</div>
                </div>
                <div class="summary-card__icon"><i class="fas fa-check-circle"></i></div>
            </div>
            <div class="summary-card__footer">
                <span class="summary-card__action"><i class="fas fa-arrow-right" style="margin-right:4px;"></i>Filtrar activos</span>
            </div>
        </div>
        <div class="summary-card summary-card--red" id="card-inactivos" onclick="filterByStatus('Inactivo')">
            <div class="summary-card__body">
                <div>
                    <div class="summary-card__title">Inactivos</div>
                    <div class="summary-card__count" id="count-inactivos">0</div>
                    <div class="summary-card__subtitle">Sin servicio</div>
                </div>
                <div class="summary-card__icon"><i class="fas fa-ban"></i></div>
            </div>
            <div class="summary-card__footer">
                <span class="summary-card__action"><i class="fas fa-arrow-right" style="margin-right:4px;"></i>Filtrar inactivos</span>
            </div>
        </div>
        <div class="summary-card summary-card--purple" id="card-total" onclick="filterByStatus('')">
            <div class="summary-card__body">
                <div>
                    <div class="summary-card__title">Total Empleados</div>
                    <div class="summary-card__count" id="count-total">0</div>
                    <div class="summary-card__subtitle">Registrados</div>
                </div>
                <div class="summary-card__icon"><i class="fas fa-user-tie"></i></div>
            </div>
            <div class="summary-card__footer">
                <span class="summary-card__action"><i class="fas fa-list" style="margin-right:4px;"></i>Ver todos</span>
            </div>
        </div>
    </div>

    <!-- Vista de Tabla -->
    <div id="tableView" class="pets-table-container">
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th width="100">Código</th>
                    <th>Nombres</th>
                    <th>Cargos</th>
                    <th>Refugio</th>
                    <th width="140">Estado</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargará los datos aquí -->
            </tbody>
        </table>
    </div>


    <!-- Vista de Cards (oculta por defecto) -->
    <div id="gridView" style="display: none;">
        <div class="row" id="empleadosGrid">
            <!-- Las tarjetas se generarán dinámicamente -->
        </div>
    </div>

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="emp_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>¿Está seguro de eliminar este empleado?</h5>
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.init.js"></script>
<script src="~/js/pages/empleado.js"></script>
<script>
    // Configuración del DataTable
    Empleado.datatable({
        urlList: "@Url.Action("List")",
        urlDetail: "@Url.Action("Detail")",
        urlInsert: "@Url.Action("Create")",
        urlUpdate: "@Url.Action("Find")"
    });

    // Búsqueda global
    $('#globalSearch').on('keyup', function() {
        $('#datatable').DataTable().search(this.value).draw();
    });

    // Alternar entre vista tabla y cards
    function toggleView(view) {
        if (view === 'table') {
            $('#tableView').show();
            $('#gridView').hide();
            $('#tableViewBtn').addClass('active');
            $('#gridViewBtn').removeClass('active');
        } else {
            $('#tableView').hide();
            $('#gridView').show();
            $('#tableViewBtn').removeClass('active');
            $('#gridViewBtn').addClass('active');
            loadCardsView();
        }
    }

    // Cargar vista de tarjetas
    function loadCardsView() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();
        var html = '';

        if (data.length === 0) {
            html = '<div class="col-12 text-center py-5"><p class="text-muted">No se encontraron empleados</p></div>';
        } else {
            data.each(function(row) {
                var estadoBadge = getEstadoBadge(row.esActivo);
                html += `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="pet-card">
                            <div style="position: relative;">
                                <div class="pet-card-img">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                                <span class="pet-badge">#${String(row.emp_Id).padStart(3, '0')}</span>
                            </div>
                            <div class="p-3">
                                <h5 class="mb-1">${row.emp_Nombres}</h5>
                                <p class="text-muted small mb-2">${row.emp_Codigo}</p>
                                <p class="text-muted mb-2"><i class="fas fa-briefcase mr-2"></i>${row.cag_Descripcion || 'Sin cargo'}</p>
                                <p class="text-muted mb-3"><i class="fas fa-home mr-2"></i>${row.refg_Nombre}</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    ${estadoBadge}
                                    <div>
                                        <button class="action-btn btn-view" onclick="viewEmpleado(${row.emp_Id})" title="Ver">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="action-btn btn-edit" onclick="editEmpleado(${row.emp_Id})" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn btn-delete" onclick="deleteEmpleado(${row.emp_Id})" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        $('#empleadosGrid').html(html);
    }

    // Funciones para acciones de empleados
    function viewEmpleado(id) {
        window.location.href = '@Url.Action("Detail")' + '/' + id;
    }

    function editEmpleado(id) {
        window.location.href = '@Url.Action("Find")' + '/' + id;
    }

    function deleteEmpleado(id) {
        $('#delete-item-id').val(id);
        $('#delete-modal').modal('show');
    }

    // Obtener badge según estado
    function getEstadoBadge(estado) {
        var badges = {
            'Activo': '<span class="status-badge status-disponible">Activo</span>',
            'Inactivo': '<span class="status-badge status-adoptado">Inactivo</span>'
        };
        return badges[estado] || badges['Activo'];
    }

    // Actualizar contadores de las cards
    function updateStatCards() {
        var table = $('#datatable').DataTable();
        var data = table.rows().data();
        var activos = 0, inactivos = 0;
        data.each(function (row) {
            if (row.esActivo && row.esActivo.toLowerCase().indexOf('activo') !== -1
                && row.esActivo.toLowerCase().indexOf('inactivo') === -1) {
                activos++;
            } else {
                inactivos++;
            }
        });
        $('#count-activos').text(activos);
        $('#count-inactivos').text(inactivos);
        $('#count-total').text(data.length);
    }

    var currentFilter = '';
    function filterByStatus(status) {
        currentFilter = status;
        var table = $('#datatable').DataTable();
        table.column(5).search(status).draw();
        $('.summary-card').removeClass('summary-card--active-green summary-card--active-red summary-card--active-purple');
        if (status === 'Activo') $('#card-activos').addClass('summary-card--active-green');
        else if (status === 'Inactivo') $('#card-inactivos').addClass('summary-card--active-red');
        else $('#card-total').addClass('summary-card--active-purple');
    }

    $('#datatable').on('init.dt', function () { updateStatCards(); });
    $('#datatable').on('xhr.dt', function () { setTimeout(updateStatCards, 100); });
</script>
}

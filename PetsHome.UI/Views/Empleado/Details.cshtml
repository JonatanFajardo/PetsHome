@model EmpleadoDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Determinar estado del empleado
    var estado = Model.emp_EsActivo ? "Activo" : "Inactivo";
    var estadoColor = Model.emp_EsActivo ? "status-activo" : "status-inactivo";
    var estadoIcono = Model.emp_EsActivo ? "fa-check-circle" : "fa-times-circle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <!-- Header con gradiente y foto de perfil -->
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div class="profile-badge">#@Model.emp_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>@Model.emp_Nombres</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-briefcase"></i>
                            <span>@Model.cag_Descripcion</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas @estadoIcono"></i>
                                <span>@estado</span>
                            </div>
                            <div class="profile-meta-item">
                                <i class="fas fa-id-card"></i>
                                <span>@Model.emp_Codigo</span>
                            </div>
                            <div class="profile-meta-item">
                                <i class="fas fa-home"></i>
                                <span>@Model.refg_Nombre</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("Find", new { id = Model.emp_Id })" class="btn-detail btn-detail-white">
                        <i class="fas fa-edit"></i>
                        <span>Editar</span>
                    </a>
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                    <button type="button" class="btn-detail btn-detail-danger" onclick="confirmDelete(@Model.emp_Id)">
                        <i class="fas fa-trash"></i>
                        <span>Eliminar</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información General -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información General</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-user"></i>
                                    <span>Nombre Completo</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.emp_Nombres</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-id-card"></i>
                                    <span>Código Empleado</span>
                                </div>
                                <div class="detail-value">@Model.emp_Codigo</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.per_Identidad))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-address-card"></i>
                                        <span>Identidad</span>
                                    </div>
                                    <div class="detail-value">@Model.per_Identidad</div>
                                </div>
                            }

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-toggle-on"></i>
                                    <span>Estado</span>
                                </div>
                                <div class="detail-value">
                                    <span class="status-badge @estadoColor">@estado</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información Laboral -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-briefcase"></i>
                        <h3>Información Laboral</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-user-tag"></i>
                                    <span>Cargo</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.cag_Descripcion</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-building"></i>
                                    <span>Refugio Asignado</span>
                                </div>
                                <div class="detail-value">@Model.refg_Nombre</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.per_Telefono) || !string.IsNullOrEmpty(Model.per_Correo) || !string.IsNullOrEmpty(Model.per_Domicilio))
                {
                    <!-- Datos de Contacto -->
                    <div class="detail-card detail-card-full">
                        <div class="detail-card-header">
                            <i class="fas fa-address-book"></i>
                            <h3>Datos de Contacto</h3>
                        </div>
                        <div class="detail-card-body">
                            <div class="detail-list">
                                <div class="row">
                                    @if (!string.IsNullOrEmpty(Model.per_Telefono))
                                    {
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <div class="detail-label">
                                                    <i class="fas fa-phone"></i>
                                                    <span>Teléfono</span>
                                                </div>
                                                <div class="detail-value">@Model.per_Telefono</div>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.per_Correo))
                                    {
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <div class="detail-label">
                                                    <i class="fas fa-envelope"></i>
                                                    <span>Correo Electrónico</span>
                                                </div>
                                                <div class="detail-value">@Model.per_Correo</div>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.per_Domicilio))
                                    {
                                        <div class="col-md-12 mt-3">
                                            <div class="detail-item">
                                                <div class="detail-label">
                                                    <i class="fas fa-map-marker-alt"></i>
                                                    <span>Dirección</span>
                                                </div>
                                                <div class="detail-value">@Model.per_Domicilio</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Información de Auditoría -->
                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Creado por</span>
                                        </div>
                                        <div class="detail-value">Usuario ID: @Model.emp_UsuarioCrea</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-calendar-plus"></i>
                                            <span>Fecha de creación</span>
                                        </div>
                                        <div class="detail-value">@Model.emp_FechaCrea.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                                @if (Model.emp_UsuarioModifica.HasValue)
                                {
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-user-edit"></i>
                                                <span>Modificado por</span>
                                            </div>
                                            <div class="detail-value">Usuario ID: @Model.emp_UsuarioModifica</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-calendar-check"></i>
                                                <span>Última modificación</span>
                                            </div>
                                            <div class="detail-value">@(Model.emp_FechaModifica?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="delete-confirm-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Remove" method="post">
                <input type="hidden" name="Empleado_Id" id="delete-emp-id">
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h5>¿Está seguro de eliminar a @Model.emp_Nombres?</h5>
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                        <i class="fas fa-times mr-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            $('#delete-emp-id').val(id);
            $('#delete-confirm-modal').modal('show');
        }
    </script>
}

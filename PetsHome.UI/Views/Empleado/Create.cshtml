@model EmpleadoViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" id="formulario">
    <form asp-action="Add" method="post" autocomplete="ON" enctype="multipart/form-data">
        <input class="form-control" asp-for="emp_Id" type="hidden" />
        <input class="form-control" asp-for="per.per_Id" type="hidden" />

        <!-- Datos Personales -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-info text-white d-flex align-items-center">
                <i class="fas fa-user fa-lg"></i>
                <h3 class="h5 mb-0 text-white ml-2">Datos Personales</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_PrimerNombre">Primer Nombre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input class="form-control" asp-for="per.per_PrimerNombre" type="text" placeholder="Primer nombre" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_PrimerNombre"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_SegundoNombre">Segundo Nombre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input class="form-control" asp-for="per.per_SegundoNombre" type="text" placeholder="Segundo nombre (opcional)" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_SegundoNombre"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_ApellidoPaterno">Apellido Paterno</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-friends"></i></span>
                                <input class="form-control" asp-for="per.per_ApellidoPaterno" type="text" placeholder="Apellido paterno" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_ApellidoPaterno"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_ApellidoMaterno">Apellido Materno</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-friends"></i></span>
                                <input class="form-control" asp-for="per.per_ApellidoMaterno" type="text" placeholder="Apellido materno" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_ApellidoMaterno"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_Identidad">Identidad</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                <input class="form-control" asp-for="per.per_Identidad" type="number" placeholder="Número de identidad" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_Identidad"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_FechaNacimiento">Fecha de Nacimiento</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-birthday-cake"></i></span>
                                <input class="form-control" asp-for="per.per_FechaNacimiento" type="date" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_FechaNacimiento"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Contacto -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-vitals text-white d-flex align-items-center">
                <i class="fas fa-address-book fa-lg me-2"></i>
                <h3 class="h5 mb-0 text-white ml-2">Información de Contacto</h3>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_Correo">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input class="form-control" asp-for="per.per_Correo" type="email" placeholder="correo@ejemplo.com" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_Correo"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_Telefono">Teléfono</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input class="form-control" asp-for="per.per_Telefono" type="number" placeholder="Número de teléfono" />
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_Telefono"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="per.per_Domicilio">Domicilio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-home"></i></span>
                                <textarea class="form-control" asp-for="per.per_Domicilio" rows="3" placeholder="Dirección completa del domicilio"></textarea>
                            </div>
                            <span class="text-danger" asp-validation-for="per.per_Domicilio"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Datos de Empleado -->
        <div class="card shadow-sm mb-4">
            <div class="card-header header-treatment text-white d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="fas fa-briefcase fa-lg me-2"></i>
                    <h3 class="h5 mb-0 text-white ml-2">Datos de Empleado</h3>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="emp_EsActivo" id="estadoSwitch">
                    <label class="form-check-label text-white" for="estadoSwitch">
                        <i class="fas fa-toggle-on me-1"></i>Activo
                    </label>
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="emp_Codigo">Código</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                <input class="form-control" asp-for="emp_Codigo" type="number" placeholder="Código del empleado" />
                            </div>
                            <span class="text-danger" asp-validation-for="emp_Codigo"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label" asp-for="refg_Id">Refugio</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-building"></i></span>
                                <select class="form-control" asp-for="refg_Id" asp-items="Model.refugioList">
                                    <option value="">-- Seleccionar Refugio --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="refg_Id"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label" asp-for="cag_Id">Cargo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-tie"></i></span>
                                <select class="form-control" asp-for="cag_Id" asp-items="Model.empleadoCargoList">
                                    <option value="">-- Seleccionar Cargo --</option>
                                </select>
                            </div>
                            <span class="text-danger" asp-validation-for="cag_Id"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones -->
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary btn-lg me-3">
                <i class="fas fa-save"></i> Guardar
            </button>
            <a class="btn btn-secondary btn-lg" asp-action="Index">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>
@section Scripts{
<script src="~/js/load-dropdownlist.js"></script>
<script src="~/js/Extensions/image-Extension.js"></script>
}
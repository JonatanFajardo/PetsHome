@{
    ViewData["Title"] = "Presupuesto";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CurrentPantalla"] = "Presupuestos";
    var estId = ViewData["estId"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/estimados.css" asp-append-version="true" />
}

<div class="col-12">
    <div class="pets-container">

        <div class="est-composer-bar">
            <a href="@Url.Action("Index", "Estimados")" class="est-back-btn">
                <i class="fas fa-arrow-left mr-1"></i>Volver a presupuestos
            </a>
            <span class="est-composer-title">
                <i class="fas fa-file-invoice mr-1"></i>Presupuesto #<span id="est-id-lbl"></span>
                <span class="est-badge" id="est-estado-badge"></span>
            </span>
        </div>

        <div class="est-detail-grid">

            <!-- Encabezado + líneas -->
            <div>
                <div class="est-card">
                    <div class="est-card-header"><i class="fas fa-info-circle"></i><h3>Datos</h3></div>
                    <div class="est-card-body" id="est-header-body">
                        <div class="est-empty">Cargando…</div>
                    </div>
                </div>

                <div class="est-card">
                    <div class="est-card-header"><i class="fas fa-list-ul"></i><h3>Líneas</h3></div>
                    <div style="overflow-x:auto;">
                        <table class="est-lines-table">
                            <thead>
                                <tr>
                                    <th style="width:110px;">Tipo</th>
                                    <th>Descripción</th>
                                    <th style="width:90px;" class="text-center">Cant.</th>
                                    <th style="width:120px;" class="text-right">Precio unit.</th>
                                    <th style="width:130px;" class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="est-detail-lines"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Acciones + total -->
            <div class="est-card">
                <div class="est-card-header"><i class="fas fa-bolt"></i><h3>Acciones</h3></div>
                <div class="est-card-body">
                    <div class="est-totals-row est-totals-total">
                        <span>Total</span>
                        <span class="est-dinero" id="est-detail-total">L. 0.00</span>
                    </div>
                    <div id="est-actions" style="margin-top:18px;display:flex;flex-direction:column;gap:10px;"></div>
                    <div id="est-factura-link" style="margin-top:14px;"></div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window._urls = {
            detalle:       '@Url.Action("Detalle", "Estimados")',
            cambiarEstado: '@Url.Action("CambiarEstado", "Estimados")',
            convertir:     '@Url.Action("Convertir", "Estimados")',
            facturaUrl:    '@Url.Action("Index", "Facturacion")'
        };
        window._estId = @estId;
    </script>
    <script src="~/js/pages/estimados.js" asp-append-version="true"></script>
    <script>
        $(function () { Estimados.initDetail(window._urls, window._estId); });
    </script>
}

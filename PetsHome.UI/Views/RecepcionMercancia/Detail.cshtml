@model RecepcionMercanciaViewModel
@{
    ViewData["Title"] = "Detalle de Recepción";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    <div class="card">
        <div class="card-header">
            <h3>Detalle de Recepción de Mercancía</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">ID:</label>
                        <p class="form-control-static">@Model.recep_Id</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Fecha:</label>
                        <p class="form-control-static">@Model.recep_Fecha?.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Tipo de Recepción:</label>
                        <p class="form-control-static">@Model.recep_TipoRecepcion</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Número de Documento:</label>
                        <p class="form-control-static">@(string.IsNullOrEmpty(Model.recep_NumeroDocumento) ? "N/A" : Model.recep_NumeroDocumento)</p>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Refugio:</label>
                        <p class="form-control-static">@Model.refg_Nombre</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">ID Origen:</label>
                        <p class="form-control-static">@(Model.recep_OrigenId?.ToString() ?? "N/A")</p>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Descripción:</label>
                        <p class="form-control-static">@Model.recep_Descripcion</p>
                    </div>
                </div>
            </div>
            
            <hr>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Usuario Creación:</label>
                        <p class="form-control-static">@Model.recep_NombreUsuarioCrea</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="control-label font-weight-bold">Fecha Creación:</label>
                        <p class="form-control-static">@Model.recep_FechaCrea.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
            
            @if (Model.recep_FechaModifica.HasValue)
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label font-weight-bold">Usuario Modificación:</label>
                            <p class="form-control-static">@Model.recep_NombreUsuarioModifica</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label font-weight-bold">Fecha Modificación:</label>
                            <p class="form-control-static">@Model.recep_FechaModifica?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            }
            
            <!-- Sección de Detalles de la Recepción -->
            <hr>
            <div class="row mt-4">
                <div class="col-12">
                    <h4 class="mb-3">Detalles de la Recepción</h4>
                    <div class="table-responsive">
                        <table id="tablaDetalles" class="table table-striped table-bordered" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Ítem</th>
                                    <th>Cantidad</th>
                                    <th>Precio Unitario</th>
                                    <th>Valor Total</th>
                                    <th>Fecha Vencimiento</th>
                                    <th>No. Lote</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            
            <div class="form-group mt-4">
                <a asp-action="EditRecepciones" asp-route-id="@Model.recep_Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver al listado
                </a>
                <button type="button" class="btn btn-info" onclick="window.print()">
                    <i class="fas fa-print"></i> Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-control-static {
            padding-top: 7px;
            padding-bottom: 7px;
            margin-bottom: 0;
            min-height: 34px;
        }
        
        .font-weight-bold {
            font-weight: 600;
        }
        
        .badge-success { background-color: #28a745; }
        .badge-warning { background-color: #ffc107; color: #212529; }
        .badge-danger { background-color: #dc3545; }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var recepcionId = @Model.recep_Id;
            
            $('#tablaDetalles').DataTable({
                "processing": true,
                "serverSide": false,
                "ajax": {
                    "url": "/RecepcionDetalle/ListByRecepcion",
                    "type": "GET",
                    "data": { recepcionId: recepcionId },
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "itm_Codigo" },
                    { "data": "itm_Descripcion" },
                    { 
                        "data": "recdet_Cantidad",
                        "className": "text-right"
                    },
                    { 
                        "data": "recdet_PrecioUnitario",
                        "className": "text-right",
                        "render": function(data) {
                            return '$' + parseFloat(data).toFixed(2);
                        }
                    },
                    { 
                        "data": "valorTotal",
                        "className": "text-right",
                        "render": function(data) {
                            return '$' + parseFloat(data).toFixed(2);
                        }
                    },
                    { 
                        "data": "recdet_FechaVencimiento",
                        "render": function(data) {
                            return data ? new Date(data).toLocaleDateString('es-ES') : 'N/A';
                        }
                    },
                    { "data": "recdet_NumeroLote" },
                    { 
                        "data": null,
                        "render": function(data, type, row) {
                            if (row.vencido) {
                                return '<span class="badge badge-danger">Vencido</span>';
                            } else if (row.vencimientoProximo) {
                                return '<span class="badge badge-warning">Próx. Vencimiento</span>';
                            } else {
                                return '<span class="badge badge-success">Normal</span>';
                            }
                        }
                    }
                ],
                "language": {
                    "lengthMenu": "Mostrar _MENU_ registros por página",
                    "zeroRecords": "No se encontraron resultados",
                    "info": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "infoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                    "infoFiltered": "(filtrado de un total de _MAX_ registros)",
                    "search": "Buscar:",
                    "loadingRecords": "Cargando...",
                    "processing": "Procesando...",
                    "paginate": {
                        "first": "Primero",
                        "last": "Último",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                }
            });
        });
    </script>
}
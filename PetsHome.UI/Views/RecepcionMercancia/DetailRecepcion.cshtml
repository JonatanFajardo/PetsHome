@model RecepcionMercanciaDetailsViewModel
@{
    ViewData["Title"] = "Detalle de Recepción de Mercancía";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <!-- Header con gradiente y información principal -->
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-boxes"></i>
                        </div>
                        <div class="profile-badge">#@Model.recep_Id.ToString().PadLeft(4, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>@Model.recep_Descripcion</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-dolly"></i>
                            <span>Recepción de Mercancía</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas fa-calendar-alt"></i>
                                <span>@Model.recep_Fecha</span>
                            </div>
                            <div class="profile-meta-item">
                                <i class="fas fa-home"></i>
                                <span>@Model.refg_Nombre</span>
                            </div>
                            <div class="profile-meta-item">
                                <i class="fas fa-tag"></i>
                                @{
                                    var tipoIcono = Model.recep_TipoRecepcion == "C" ? "shopping-cart" :
                                                   Model.recep_TipoRecepcion == "D" ? "hand-holding-heart" : "exchange-alt";
                                    var tipoNombre = Model.recep_TipoRecepcion == "C" ? "Compra" :
                                                    Model.recep_TipoRecepcion == "D" ? "Donación" : "Transferencia";
                                }
                                <span>@tipoNombre</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("FormPartialRecepcion", new { id = Model.recep_Id })" class="btn-detail btn-detail-white">
                        <i class="fas fa-edit"></i>
                        <span>Editar</span>
                    </a>
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información General -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información General</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-hashtag"></i>
                                    <span>ID Recepción</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.recep_Id</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-calendar-alt"></i>
                                    <span>Fecha de Recepción</span>
                                </div>
                                <div class="detail-value">@Model.recep_Fecha</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-align-left"></i>
                                    <span>Descripción</span>
                                </div>
                                <div class="detail-value">@Model.recep_Descripcion</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-home"></i>
                                    <span>Refugio</span>
                                </div>
                                <div class="detail-value">@Model.refg_Nombre</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-tag"></i>
                                    <span>Tipo de Recepción</span>
                                </div>
                                <div class="detail-value">@tipoNombre</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información Adicional -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-file-alt"></i>
                        <h3>Información Adicional</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            @if (!string.IsNullOrEmpty(Model.proc_Descripcion))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>Procedencia</span>
                                    </div>
                                    <div class="detail-value">@Model.proc_Descripcion</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.recep_NumeroDocumento))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-file-invoice"></i>
                                        <span>Número de Documento</span>
                                    </div>
                                    <div class="detail-value">@Model.recep_NumeroDocumento</div>
                                </div>
                            }

                            @if (string.IsNullOrEmpty(Model.proc_Descripcion) && string.IsNullOrEmpty(Model.recep_NumeroDocumento))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-info-circle"></i>
                                        <span>Información</span>
                                    </div>
                                    <div class="detail-value">No hay información adicional disponible</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Detalles de Items -->
                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-box-open"></i>
                        <h3>Items Recibidos</h3>
                    </div>
                    <div class="">
                        @{
                            ViewData["recep_Id"] = Model.recep_Id;
                        }
                        <partial name="PartialRecepcionDetalle" />
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/recepciondetalle.js"></script>
    <script>
        $(document).ready(function() {
            RecepcionDetalle.datatablePartials({
                listUrl: "@Url.Action("ListDetalles")",
                id: @Model.recep_Id
            });
        });
    </script>
    <script>
        $(document).ready(function() {
            Catalogs.configure({
                displayName: "detalle de recepción",
                getUrl: "@Url.Action("FindDetalle")",  // Para editar
                detailGetUrl: "@Url.Action("FindDetalleDetail")"  // Para ver detalles
            });
        });
    </script>
}

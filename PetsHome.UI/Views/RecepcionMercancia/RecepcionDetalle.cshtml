@model RecepcionMercanciaFormViewModel
<div class="card-header">
    <h3>Detalle de la Recepción</h3>
</div>
<div class="card-body">
    <!-- Formulario para agregar/editar detalle -->
    <form asp-controller="RecepcionMercancia" asp-action="AddDetalle" autocomplete="off">
        <input type="hidden" asp-for="Detalle.recdet_Id" id="detalle-id" />
        <input type="hidden" asp-for="Detalle.recep_Id" value="@Model.recep_Id" />

        <div class="row">
            <div class="col-md-3">
                <label class="control-label required">Item</label>
                <select class="form-control" asp-for="Detalle.itm_Id" id="detalle-item">
                    <option value="">Seleccione un item...</option>
                    @foreach (var item in ViewBag.Items)
                    {
                        <option value="@item.itm_Id">@item.itm_Descripcion</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="Detalle.itm_Id"></span>
            </div>
            <div class="col-md-2">
                <label class="control-label required">Cantidad</label>
                <input class="form-control" asp-for="Detalle.recdet_Cantidad" type="number" step="0.01" id="detalle-cantidad" />
                <span class="text-danger" asp-validation-for="Detalle.recdet_Cantidad"></span>
            </div>
            <div class="col-md-2">
                <label class="control-label">Precio Unitario</label>
                <input class="form-control" asp-for="Detalle.recdet_PrecioUnitario" type="number" step="0.01" id="detalle-precio" />
                <span class="text-danger" asp-validation-for="Detalle.recdet_PrecioUnitario"></span>
            </div>
            <div class="col-md-2">
                <label class="control-label">Fecha Vencimiento</label>
                <input class="form-control" asp-for="Detalle.recdet_FechaVencimiento" type="date" id="detalle-vencimiento" />
                <span class="text-danger" asp-validation-for="Detalle.recdet_FechaVencimiento"></span>
            </div>
            <div class="col-md-2">
                <label class="control-label">Número de Lote</label>
                <input class="form-control" asp-for="Detalle.recdet_NumeroLote" type="text" maxlength="50" id="detalle-lote" />
                <span class="text-danger" asp-validation-for="Detalle.recdet_NumeroLote"></span>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-success btn-block" id="btn-agregar-detalle">
                    <i class="mdi mdi-plus"></i> Agregar
                </button>
            </div>
        </div>
    </form>

    <hr />

    <!-- Tabla de detalles -->
    <div class="table-responsive mt-3">
        <table class="table table-striped" id="datatable-detalles">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th>Item</th>
                    <th width="100">Cantidad</th>
                    <th width="120">Precio Unit.</th>
                    <th width="120">Vencimiento</th>
                    <th width="120">Lote</th>
                    <th width="120" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargara los datos aqui -->
            </tbody>
        </table>
    </div>

    <!-- Modal Delete Detalle -->
    <div class="modal fade" id="delete-detalle-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="RemoveDetalle" method="post" autocomplete="off">
                    <input type="hidden" name="recdet_Id" id="delete-detalle-id">
                    <input type="hidden" name="recep_Id" value="@Model.recep_Id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>¿Está seguro de eliminar este detalle?</h5>
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

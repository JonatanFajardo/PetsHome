@model AdopcionViewModel
@{
    ViewData["Title"] = "Adopciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header púrpura con todos los controles -->
    <div class="pets-header-full">
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fa-heart mr-2 text-white"></i>Gestión de Adopciones</h2>
                <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Create")'">
                    <i class="fas fa-plus mr-2"></i>Nuevo Adopción
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por mascota o adoptante...">
                </div>
                <div class="action-buttons">
                    <div class="view-toggle">
                        <button class="btn-control active" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                    </div>
                    <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Vista de Tabla -->
    <div id="tableView" class="pets-table-container">
    <!-- Tabs de estados con iconos y contadores -->
    <ul class="nav nav-tabs pets-status-tabs mb-0" id="adopcionStatusTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-status="pending" role="tab" aria-selected="true" href="#">
                <i class="fas fa-clock"></i>
                <span class="text">Pendientes</span>
                <span class="badge" id="badge-pending">0</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-status="adopted" role="tab" aria-selected="false" href="#">
                <i class="fas fa-check-circle"></i>
                <span class="text">Adoptados</span>
                <span class="badge" id="badge-adopted">0</span>
            </a>
        </li>
    </ul>
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th>Mascota</th>
                    <th>Raza</th>
                    <th>Tipo</th>
                    <th width="100">Edad</th>
                    <th width="100">Sexo</th>
                    <th width="120">Adopción</th>
                    <th width="150">Solicitantes</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargará los datos aquí -->
            </tbody>
        </table>
    </div>


    <!-- Vista de Cards (oculta por defecto) -->
    <div id="gridView" style="display: none;">
        <div class="row" id="adopcionesGrid">
            <!-- Las tarjetas se generaran dinamicamente -->
        </div>
    </div>

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminación
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="adop_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>¿Está seguro de eliminar esta adopción?</h5>
                        <p class="text-muted">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/components/datatable/datatable.init.js"></script>
<script>
    // Inicializar tooltips
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
<script src="~/js/pages/adopcion.js"></script>
<script>
    // Configuración del DataTable
    Adopcion.datatable({
        urlList: "@Url.Action("List")",
        urlDetail: "@Url.Action("DetailByMascota")",
        urlDetailParam: "masc_Id",
        urlInsert: "@Url.Action("Create")",
        urlUpdate: "@Url.Action("Find")"
    });

    // Búsqueda global
    $('#globalSearch').on('keyup', function() {
        $('#datatable').DataTable().search(this.value).draw();
    });

    var $statusTabs = $('#adopcionStatusTabs');

    $statusTabs.on('click', '.nav-link', function (e) {
        e.preventDefault();

        var $link = $(this);
        var status = $link.data('status');

        $statusTabs.find('.nav-link').removeClass('active').attr('aria-selected', 'false');
        $link.addClass('active').attr('aria-selected', 'true');

        Adopcion.filterByStatus(status);

        if ($('#gridView').is(':visible')) {
            loadCardsView();
        }
    });

    Adopcion.filterByStatus($statusTabs.find('.nav-link.active').data('status'));

    $('#datatable').on('draw.dt', function () {
        updateTabCounters();
        if ($('#gridView').is(':visible')) {
            loadCardsView();
        }
    });

    // Actualizar contadores de badges en tabs
    function updateTabCounters() {
        var table = $('#datatable').DataTable();
        var allData = table.rows({ search: 'applied' }).data();

        var pendingCount = 0;
        var adoptedCount = 0;

        allData.each(function(row) {
            if (row.masc_EsAdoptado === true || row.masc_EsAdoptado === 1 || row.masc_EsAdoptado === "true") {
                adoptedCount++;
            } else {
                pendingCount++;
            }
        });

        $('#badge-pending').text(pendingCount);
        $('#badge-adopted').text(adoptedCount);
    }


    // Alternar entre vista tabla y cards
    function toggleView(view) {
        if (view === 'table') {
            $('#tableView').show();
            $('#gridView').hide();
            $('#tableViewBtn').addClass('active');
            $('#gridViewBtn').removeClass('active');
        } else {
            $('#tableView').hide();
            $('#gridView').show();
            $('#tableViewBtn').removeClass('active');
            $('#gridViewBtn').addClass('active');
            loadCardsView();
        }
    }

    // Cargar vista de tarjetas
    function loadCardsView() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();
        var html = '';

        if (data.length === 0) {
            html = '<div class="col-12 text-center py-5"><p class="text-muted">No se encontraron registros</p></div>';
        } else {
            data.each(function(row) {
                var estadoBadge = getReservadoBadge(row.masc_EsAdoptado);
                html += `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card-item">
                            <div style="position: relative;">
                                <div class="card-item-img">
                                    <i class="fas fa-paw"></i>
                                </div>
                                <span class="card-badge">#${String(row.masc_Id).padStart(3, '0')}</span>
                            </div>
                            <div class="p-3">
                                <h5 class="mb-1">${row.masc_Nombre}</h5>
                                <p class="text-muted small mb-2"><i class="fas fa-dna mr-2"></i>${row.raza_Descripcion} • ${row.raza_TipoAnimal}</p>
                                <p class="text-muted mb-2"><i class="fas fa-user mr-2"></i>${row.masc_Sexo} • ${row.masc_Edad} años</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    ${estadoBadge}
                                    <div>
                                        <button class="action-btn btn-view" onclick="viewItem(${row.masc_Id})" title="Ver">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button class="action-btn btn-edit" onclick="editItem(${row.masc_Id})" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn btn-delete" onclick="deleteItem(${row.masc_Id})" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        $('#adopcionesGrid').html(html);
    }

    // Funciones para acciones
    function viewItem(id) {
        datatable.viewDetail(id);
    }

    function editItem(id) {
        window.location.href = '@Url.Action("Find")' + '/' + id;
    }

    function deleteItem(id) {
        $('#delete-item-id').val(id);
        $('#delete-modal').modal('show');
    }

    // Badge de reservado/adoptado
    function getReservadoBadge(esAdoptado) {
        return esAdoptado
            ? '<span class="status-badge status-adoptado">Adoptado</span>'
            : '<span class="status-badge status-pendiente">Pendiente</span>';
    }


    // Exportar a PDF
    function exportPDF() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-pdf').trigger();
    }

    // Exportar a Excel
    function exportExcel() {
        var table = $('#datatable').DataTable();
        table.button('.buttons-excel').trigger();
    }

    // Exportar a CSV (mejorado)
    function exportCSV() {
        var table = $('#datatable').DataTable();
        var data = table.rows({ search: 'applied' }).data();

        var csv = 'ID,Mascota,Adoptante,Fecha,Estado\n';
        data.each(function(row) {
            // Implementar según estructura de datos
            console.log('Exportar CSV - Implementar según datos');
        });

        var blob = new Blob([csv], { type: 'text/csv' });
        var url = window.URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'adopcion_' + new Date().toISOString().slice(0,10) + '.csv';
        a.click();
    }

    // Override para mantener compatibilidad si otros scripts invocan viewDetail
    function viewDetail(id) {
           window.location.href = '@Url.Action("DetailByMascota")' + '?masc_Id=' + id;
    }
</script>
}

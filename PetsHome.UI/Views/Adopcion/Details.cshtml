@model AdopcionViewModel
@{
    ViewData["Title"] = "Detalles de Adopción";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var estado = Model.adop_Estado ?? "Pendiente";
    var estadoColor = estado == "Aprobado" ? "status-aprobado" : (estado == "Rechazado" ? "status-inactivo" : "status-pendiente");
    var estadoIcono = estado == "Aprobado" ? "fa-check-circle" : (estado == "Rechazado" ? "fa-times-circle" : "fa-clock");
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="profile-badge">#@Model.adop_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>Adopción #@Model.adop_Id</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-calendar"></i>
                            <span>@Model.adop_FechaRegistro.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas @estadoIcono"></i>
                                <span>@estado</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.masc_Nombre))
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-paw"></i>
                                    <span>@Model.masc_Nombre</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.per_Nombre))
                            {
                                <div class="profile-meta-item">
                                    <i class="fas fa-user"></i>
                                    <span>@Model.per_Nombre</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="detail-content">
            <div class="detail-grid">
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información de la Adopción</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-hashtag"></i>
                                    <span>ID Adopción</span>
                                </div>
                                <div class="detail-value detail-value-large">#@Model.adop_Id</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-file-alt"></i>
                                    <span>ID Solicitud</span>
                                </div>
                                <div class="detail-value">#@Model.sol_Id</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-calendar-check"></i>
                                    <span>Fecha de Registro</span>
                                </div>
                                <div class="detail-value">@Model.adop_FechaRegistro.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-flag"></i>
                                    <span>Estado</span>
                                </div>
                                <div class="detail-value">
                                    <span class="status-badge @estadoColor">@estado</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-users"></i>
                        <h3>Participantes</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            @if (!string.IsNullOrEmpty(Model.masc_Nombre))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-paw"></i>
                                        <span>Mascota</span>
                                    </div>
                                    <div class="detail-value detail-value-large">@Model.masc_Nombre</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.per_Nombre))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-user-check"></i>
                                        <span>Adoptante</span>
                                    </div>
                                    <div class="detail-value detail-value-large">@Model.per_Nombre</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Creado por</span>
                                        </div>
                                        <div class="detail-value">@(Model.adop_NombreUsuarioCrea ?? "Sistema")</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <div class="detail-label">
                                            <i class="fas fa-calendar-plus"></i>
                                            <span>Fecha de creación</span>
                                        </div>
                                        <div class="detail-value">@Model.adop_FechaCrea.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                                @if (Model.adop_UsuarioModifica.HasValue)
                                {
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-user-edit"></i>
                                                <span>Modificado por</span>
                                            </div>
                                            <div class="detail-value">@(Model.adop_NombreUsuarioModifica ?? "Sistema")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mt-3">
                                        <div class="detail-item">
                                            <div class="detail-label">
                                                <i class="fas fa-calendar-check"></i>
                                                <span>Última modificación</span>
                                            </div>
                                            <div class="detail-value">@(Model.adop_FechaModifica?.ToString("dd/MM/yyyy hh:mm tt") ?? "N/A")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

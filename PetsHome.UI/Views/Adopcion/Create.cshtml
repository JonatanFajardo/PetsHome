@model AdopcionViewModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">
        <!-- Header con gradiente igual al Index -->
        <div class="pets-header-full">
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white">
                        <i class="fas fa-heart mr-2 text-white"></i>Registro de Adopción
                    </h2>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Index")'">
                        <i class="fas fa-arrow-left mr-2"></i>Volver al Listado
                    </button>
                </div>
                <p class="text-white mb-0 mt-2" style="opacity: 0.9;">Complete la información de la adopción</p>
            </div>
        </div>

        <!-- Contenedor del formulario -->
        <div class="pets-body-full">
            <div class="container-fluid">

    <form asp-action="Add" method="post" autocomplete="ON" enctype="multipart/form-data">
        <input class="form-control" asp-for="adop_Id" type="hidden" />

        <!-- Datos de la Adopción -->
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Información de la adopción</h2>
                <p class="card-description">Datos de la solicitud y aprobación</p>
            </div>
            <div class="card-content">
                <div class="form-grid">
                    <!-- Campo Solicitud -->
                    <div class="form-group">
                        <label asp-for="sol_Id">Solicitud</label>
                        <input class="form-control" asp-for="sol_Id" type="text" placeholder="Ingrese el ID de la solicitud" />
                        <span class="text-danger" asp-validation-for="sol_Id"></span>
                    </div>

                    <!-- Campo Estado -->
                    <div class="form-group">
                        <label asp-for="adop_Estado">Estado de Aprobación</label>
                        <select class="form-control" asp-for="adop_Estado">
                            <option value="">Seleccione un estado</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Rechazado">Rechazado</option>
                        </select>
                        <span class="text-danger" asp-validation-for="adop_Estado"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="form-actions">
            <a class="btn btn-outline" asp-action="Index">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="mdi mdi-content-save"></i> Guardar</button>
        </div>
    </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/load-dropdownlist.js"></script>
    <script src="~/js/Extensions/image-Extension.js"></script>
}

<!-- BEGIN SIDEBAR -->
<div class="sidebar-wrapper sidebar-theme">
    <nav id="sidebar">
        <!-- Sección Principal con Menú Dinámico -->
        <div class="nav-section">
            <div class="nav-section-title">SISTEMA PETSHOME</div>
            @if (User.Identity.IsAuthenticated)
            {
                <!-- Menú dinámico basado en permisos del usuario -->
                <div class="dynamic-menu-container">
                    @await Component.InvokeAsync("MenuDinamico")
                </div>
            }
            else
            {
                <!-- Menú para usuarios no autenticados -->
                <ul class="list-unstyled menu-categories">
                    <li class="menu">
                        <div class="dropdown-toggle">
                            <i class="fas fa-sign-in-alt"></i>
                            @Html.ActionLink("Iniciar Sesión", "Login", "Account")
                        </div>
                    </li>
                </ul>
            }
        </div>
    </nav>

    @if (User.Identity.IsAuthenticated)
    {
        <!-- Footer del Sidebar con Info del Usuario -->
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">
                    <div class="avatar-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
                <div class="user-details">
                    <span class="user-name">@User.Identity.Name</span>
                    <span class="user-role">@User.FindFirst("RolDescripcion")?.Value</span>
                </div>
            </div>
        </div>
    }
</div>
<!-- END SIDEBAR -->

<style>
/* Estilos para adaptar el menú dinámico al tema existente */
.dynamic-menu-container .nav {
    padding: 0;
}

.dynamic-menu-container .nav-link {
    color: #a1a2b5;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    text-decoration: none;
    border-radius: 4px;
    margin-bottom: 2px;
    transition: all 0.3s ease;
}

.dynamic-menu-container .nav-link:hover {
    background-color: #1b2e4b;
    color: #ffffff;
    text-decoration: none;
}

.dynamic-menu-container .nav-link.active {
    background-color: #4361ee;
    color: #ffffff;
}

.dynamic-menu-container .nav-icon {
    width: 20px;
    margin-right: 10px;
    text-align: center;
}

.dynamic-menu-container .nav-treeview {
    padding-left: 0;
    margin-left: 30px;
}

.dynamic-menu-container .nav-treeview .nav-link {
    padding: 8px 15px;
    font-size: 0.9em;
}

.dynamic-menu-container .badge {
    margin-left: auto;
}

.nav-header {
    color: #888ea8;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 15px 20px 5px;
    margin-top: 15px;
}

.sidebar-footer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 15px;
    background-color: #0e1726;
    border-top: 1px solid #1b2e4b;
}

.user-info {
    display: flex;
    align-items: center;
}

.user-avatar {
    width: 40px;
    height: 40px;
    margin-right: 10px;
}

.avatar-placeholder {
    width: 100%;
    height: 100%;
    background-color: #4361ee;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.user-details {
    display: flex;
    flex-direction: column;
}

.user-name {
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 500;
}

.user-role {
    color: #888ea8;
    font-size: 0.75rem;
}
</style>
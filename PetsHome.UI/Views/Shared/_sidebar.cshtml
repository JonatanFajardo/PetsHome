@using System.Security.Claims
@using PetsHome.UI.Filters

@{
    var pantallas = User.FindFirst("Pantallas")?.Value ?? "";
    var listaPantallas = pantallas.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                  .Select(p => p.Trim())
                                  .ToList();
    Func<string, bool> tiene = (nombre) => listaPantallas
        .Any(p => p.Equals(nombre, StringComparison.OrdinalIgnoreCase));
}


                            @Html.ActionLink("Procedencia", "Index", "Procedencia")
                        </li>
                        <li>
                            
                            @Html.ActionLink("Razas", "Index", "Raza")
                        </li>
                    </ul>
                </li>

                <!-- Reportes -->
                <li class="menu">
                    <a href="#Reportes" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle">
                        <div class="">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reportes</span>
                        </div>
                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-right">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </a>
                    <ul class="collapse submenu list-unstyled" id="Reportes" data-parent="#accordionExample">
                        <li>
                            <i class="fas fa-tachometer-alt text-primary"></i>
                            @Html.ActionLink("Dashboard General", "Index", "Reportes")
                        </li>
                        <li>
                            <i class="fas fa-dog text-brown"></i>
                            @Html.ActionLink("Mascotas por Raza", "MascotasPorRaza", "Reportes")
                        </li>
                        <li>
                            <i class="fas fa-hands-helping text-info"></i>
                            @Html.ActionLink("Voluntarios", "Voluntarios", "Reportes")
                        </li>
                        <li>
                            <i class="fas fa-chart-bar text-success"></i>
                            @Html.ActionLink("Analytics de Inventario", "Reportes", "Existencia")
                        </li>
                        <li>
                            <i class="fas fa-heart text-danger"></i>
                            @Html.ActionLink("Salud Mascotas", "SaludMascotas", "Reportes")
                        </li>
                        <li>
                            <i class="fas fa-calendar-alt text-warning"></i>
                            @Html.ActionLink("Eventos", "Eventos", "Reportes")
                        </li>
                    </ul>
                </li>

               
                <!-- Donaciones -->
                <li class="menu">
                    <div class="dropdown-toggle">
                        <i class="fas fa-home"></i>
                        @Html.ActionLink("Donaciones", "Index", "Donacion")
                        <span class="badge badge-primary">5</span>

                    </div>
                </li>
            </ul>
        </div>

        <!-- Sección Configuración -->
        <div class="nav-section">
            <div class="nav-section-title">CONFIGURACIÓN</div>
            <ul class="list-unstyled menu-categories">
                <!-- Perfil -->
                <li class="menu">
                    <div class="dropdown-toggle">
                        <i class="fas fa-user-circle"></i>
                        @Html.ActionLink("Mi Perfil", "Profile", "Account")
                    </div>
                </li>

                <!-- Configuración -->
                <li class="menu">
                    <div class="dropdown-toggle">
                        <i class="fas fa-sliders-h"></i>
                        @Html.ActionLink("Configuración", "Settings", "Account")
                    </div>
                </li>

                <!-- Cerrar Sesión -->
                <li class="menu">
                    <div class="dropdown-toggle">
                        <i class="fas fa-sign-out-alt"></i>
                        @Html.ActionLink("Cerrar Sesión", "Logout", "Account")
                    </div>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Footer del Sidebar con Info del Usuario -->
    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.UserAvatar))
                {
                    <img src="@ViewBag.UserAvatar" alt="Avatar">
                }
                else
                {
                    <div class="avatar-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                }
            </div>
            <div class="user-details">
                <span class="user-name">@ViewBag.UserName</span>
                <span class="user-role">@ViewBag.UserRole</span>
            </div>
        </div>
    </div>
</div>
<!-- END SIDEBAR -->
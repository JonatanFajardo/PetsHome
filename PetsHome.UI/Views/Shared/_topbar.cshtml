 <!--  BEGIN NAVBAR  -->
    <div class="header-container fixed-top">
        <header class="header navbar navbar-expand-sm">
            
            <ul class="navbar-nav theme-brand flex-row text-center text-white">
                <li class="nav-item theme-logo text-white">
                   <i class="fa-solid fa-paw fa-xl"></i>
                </li>
                <li class="nav-item theme-text ">
                    @Html.ActionLink("Petshome", "Index", "Home")
                </li>
                <li class="nav-item toggle-sidebar fa-xl">
                    <a href="javascript:void(0);" class="sidebarCollapse" data-placement="bottom"><i class="fa-solid fa-bars"></i></a>
                </li>
            </ul>

            @if (User.Identity.IsAuthenticated)
            {
                string nombreUsuario = Context.Session.GetString("usu_NombreUsuario") ?? User.Identity.Name;
                string imagenPerfil = Context.Session.GetString("usu_ImagenPerfil") ?? "/images/users/avatar-default.jpg";
                string rolDescripcion = Context.Session.GetString("RolDescripcion") ?? User.FindFirst("RolDescripcion")?.Value;

                <!-- Información de usuario estilo AHM -->
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown user-profile-dropdown order-lg-0 order-1">
                        <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <img src="@imagenPerfil" alt="usuario" class="rounded-circle" style="width: 32px; height: 32px;">
                            <span class="ml-2 text-white">@nombreUsuario</span>
                            <i class="fas fa-chevron-down ml-1"></i>
                        </a>
                        <div class="dropdown-menu position-absolute e-animated e-fadeInUp" aria-labelledby="userProfileDropdown">
                            <div class="dropdown-item">
                                <div class="d-flex">
                                    <img src="@imagenPerfil" alt="usuario" class="rounded-circle mr-2" style="width: 40px; height: 40px;">
                                    <div>
                                        <div class="font-weight-bold">@nombreUsuario</div>
                                        <div class="text-muted small">@rolDescripcion</div>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                                <i class="fas fa-user mr-2"></i>Mi Perfil
                            </a>
                            <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                <i class="fas fa-key mr-2"></i>Cambiar Contraseña
                            </a>
                            <div class="dropdown-divider"></div>
                            <form method="post" action="@Url.Action("Logout", "Account")">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt mr-2"></i>Cerrar Sesión
                                </button>
                            </form>
                        </div>
                    </li>
                </ul>
            }

        </header>
    </div>
    <!--  END NAVBAR  -->

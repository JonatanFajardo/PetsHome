@model PetsHome.Business.Models.MenuViewModel

<ul class="list-unstyled menu-categories" id="accordionExample">
    <!-- Dashboard siempre visible para usuarios autenticados -->
    <li class="menu">
        <div class="dropdown-toggle">
            <i class="fas fa-tachometer-alt"></i>
            @Html.ActionLink("Dashboard", "Index", "Home")
        </div>
    </li>

    @if (Model != null && Model.MenuItems != null && Model.MenuItems.Any())
    {
        @foreach (var modulo in Model.MenuItems.Where(m => m.TieneAcceso).OrderBy(m => m.Mod_Orden))
        {
            var tieneSubmodulos = modulo.SubModulos.Any() || modulo.PuedeCrear || modulo.PuedeEditar || modulo.PuedeEliminar;
            
            @if (tieneSubmodulos)
            {
                <!-- Módulo con submenú -->
                <li class="menu">
                    <a href="#modulo_@modulo.Mod_Id" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle">
                        <div class="">
                            <i class="@modulo.Mod_Icono"></i>
                            <span>@modulo.Mod_Nombre</span>
                        </div>
                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-right">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </a>
                    <ul class="collapse submenu list-unstyled" id="modulo_@modulo.Mod_Id" data-parent="#accordionExample">
                        @* Mostrar URL principal del módulo si existe *@
                        @if (!string.IsNullOrEmpty(modulo.Mod_Url))
                        {
                            <li>
                                <i class="@modulo.Mod_Icono text-info"></i>
                                <a href="@modulo.Mod_Url">@modulo.Mod_Descripcion</a>
                            </li>
                        }
                        
                        @* Mostrar submódulos reales de la base de datos *@
                        @foreach (var submodulo in modulo.SubModulos.OrderBy(s => s.Mod_Orden))
                        {
                            <li>
                                <i class="@submodulo.Mod_Icono"></i>
                                <a href="@submodulo.Mod_Url">@submodulo.Mod_Nombre</a>
                            </li>
                        }
                        
                        @* Opciones estándar basadas en permisos *@
                        @if (modulo.PuedeCrear)
                        {
                            <li>
                                <i class="fas fa-plus text-success"></i>
                                @Html.ActionLink("Crear Nuevo", "Create", modulo.Mod_Nombre.ToLower())
                            </li>
                        }
                        @if (modulo.Permisos.Contains("EXPORT"))
                        {
                            <li>
                                <i class="fas fa-download text-warning"></i>
                                @Html.ActionLink("Exportar", "Export", modulo.Mod_Nombre.ToLower())
                            </li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <!-- Módulo simple sin submenú -->
                <li class="menu">
                    <div class="dropdown-toggle">
                        <i class="@modulo.Mod_Icono"></i>
                        @if (!string.IsNullOrEmpty(modulo.Mod_Url))
                        {
                            <a href="@modulo.Mod_Url">@modulo.Mod_Descripcion</a>
                        }
                        else
                        {
                            @Html.ActionLink(modulo.Mod_Descripcion, "Index", modulo.Mod_Nombre.ToLower())
                        }
                    </div>
                </li>
            }
        }
    }
    else
    {
        <li class="menu">
            <div class="dropdown-toggle">
                <i class="fas fa-exclamation-triangle text-warning"></i>
                <span>Sin permisos asignados</span>
            </div>
        </li>
    }

    <!-- Información del Usuario -->
    <li class="menu">
        <div class="dropdown-toggle">
            <i class="fas fa-user-circle"></i>
            @Html.ActionLink("Mi Perfil", "Profile", "Account")
        </div>
    </li>
    
    <li class="menu">
        <div class="dropdown-toggle">
            <i class="fas fa-sliders-h"></i>
            @Html.ActionLink("Configuración", "Settings", "Account")
        </div>
    </li>
    
    <li class="menu">
        <div class="dropdown-toggle">
            <i class="fas fa-sign-out-alt"></i>
            @Html.ActionLink("Cerrar Sesión", "Logout", "Account")
        </div>
    </li>
</ul>

<script>
$(document).ready(function() {
    console.log('🔧 Inicializando menú dinámico con Bootstrap collapse');
    
    // Marcar como activo el elemento del menú actual
    var currentPath = window.location.pathname.toLowerCase();
    console.log('📍 Ruta actual:', currentPath);
    
    // Marcar enlaces activos
    $('.submenu a, .dropdown-toggle a').each(function() {
        var href = $(this).attr('href');
        if (href && href !== '#' && href !== '/' && href.toLowerCase() === currentPath) {
            $(this).addClass('active');
            // Si es un submenú, también expandir el padre
            var parentCollapse = $(this).closest('.submenu');
            if (parentCollapse.length) {
                parentCollapse.addClass('show');
                parentCollapse.siblings('a').addClass('active');
                console.log('🎯 Menú expandido:', parentCollapse.attr('id'));
            }
        }
    });
    
    // Manejar clicks en dropdown-toggle para Bootstrap collapse
    $('.dropdown-toggle[data-toggle="collapse"]').on('click', function(e) {
        e.preventDefault();
        var target = $(this).attr('href');
        console.log('🖱️ Click en dropdown:', target);
        
        // Toggle del collapse
        $(target).collapse('toggle');
        
        // Rotar ícono
        $(this).find('.feather-chevron-right').toggleClass('rotate-90');
    });
    
    // Eventos de Bootstrap collapse
    $('.collapse').on('show.bs.collapse', function () {
        console.log('📂 Expandiendo:', $(this).attr('id'));
        $(this).siblings('a').find('.feather-chevron-right').addClass('rotate-90');
    });
    
    $('.collapse').on('hide.bs.collapse', function () {
        console.log('📁 Colapsando:', $(this).attr('id'));
        $(this).siblings('a').find('.feather-chevron-right').removeClass('rotate-90');
    });
    
    console.log('✅ Menú dinámico inicializado');
});
</script>

<style>
/* Estilos adicionales para el menú dinámico */
.feather-chevron-right {
    transition: transform 0.3s ease;
}

.feather-chevron-right.rotate-90 {
    transform: rotate(90deg);
}

.submenu {
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    margin-top: 5px;
}

.submenu li {
    padding: 5px 0;
}

.submenu li a {
    color: #a1a2b5;
    padding: 8px 15px;
    display: block;
    text-decoration: none;
    border-radius: 3px;
    transition: all 0.3s ease;
}

.submenu li a:hover,
.submenu li a.active {
    background-color: #4361ee;
    color: #ffffff;
    text-decoration: none;
}

.dropdown-toggle.active {
    background-color: #1b2e4b;
    color: #ffffff;
    border-radius: 4px;
}
</style>
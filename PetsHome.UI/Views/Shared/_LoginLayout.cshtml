<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PetsHome</title>
    <meta content="Sistema de Gestión de Refugio de Mascotas" name="description" />
    <meta name="author" content="PetsHome" />
    <meta name="theme-color" content="#667eea" />

    <!-- Bootstrap CSS -->
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" type="text/css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Custom Fonts - Inter for modern look -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Toastr for alerts -->
    <link href="~/plugins/toastr/toastr.css" rel="stylesheet" />

    <!-- Custom Login Styles -->
    <link href="~/css/login.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            position: relative;
            overflow-x: hidden;
        }

        /* Enhanced background pattern */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image:
                radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
            pointer-events: none;
        }

        /* Improved Toastr styling for login page */
        .toast-success {
            background-color: #48bb78 !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(72, 187, 120, 0.3) !important;
        }

        .toast-error {
            background-color: #e53e3e !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(229, 62, 62, 0.3) !important;
        }

        .toast-info {
            background-color: #4299e1 !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(66, 153, 225, 0.3) !important;
        }

        .toast-warning {
            background-color: #ed8936 !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(237, 137, 54, 0.3) !important;
        }

        /* Smooth scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }
    </style>
</head>
<body>
    @RenderBody()

    <!-- jQuery -->
    <script src="~/assets/js/libs/jquery-3.1.1.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="~/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr -->
    <script src="~/plugins/toastr/toastr.min.js"></script>

    <!-- Alert Messages -->
    @Html.Partial("_AlertMessagesPartial")

    <!-- Toastr Configuration -->
    <script>
        // Configure toastr for better UX on login page
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": true,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

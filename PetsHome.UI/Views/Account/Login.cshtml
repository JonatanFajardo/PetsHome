@model PetsHome.Business.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="login-container">
    <!-- Animated Background Elements -->
    <div class="background-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="login-card">
                    <!-- Logo y Título -->
                    <div class="text-center mb-4">
                        <div class="login-logo-wrapper">
                            <div class="login-logo">
                                <i class="fas fa-paw"></i>
                            </div>
                            <div class="logo-shine"></div>
                        </div>
                        <h1 class="login-title">PetsHome</h1>
                        <p class="login-subtitle">Sistema de Gestión de Refugio</p>
                    </div>

                    <!-- Formulario de Login -->
                    <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" autocomplete="on">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-alert" role="alert"></div>

                        <!-- Campo Usuario -->
                        <div class="form-group mb-3">
                            <label asp-for="Username" class="form-label">
                                <i class="fas fa-user"></i>Usuario
                            </label>
                            <div class="input-wrapper">
                                <input asp-for="Username"
                                       class="form-control modern-input"
                                       placeholder="Ingrese su usuario"
                                       autocomplete="username"
                                       autofocus />
                                <div class="input-focus-border"></div>
                            </div>
                            <span asp-validation-for="Username" class="text-danger validation-message"></span>
                        </div>

                        <!-- Campo Contraseña -->
                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-lock"></i>Contraseña
                            </label>
                            <div class="input-wrapper">
                                <div class="password-input-group">
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control modern-input password-field"
                                           id="passwordInput"
                                           placeholder="Ingrese su contraseña"
                                           autocomplete="current-password" />
                                    <button class="password-toggle"
                                            type="button"
                                            id="togglePassword"
                                            tabindex="-1">
                                        <i class="fas fa-eye" id="toggleIcon"></i>
                                    </button>
                                </div>
                                <div class="input-focus-border"></div>
                            </div>
                            <span asp-validation-for="Password" class="text-danger validation-message"></span>
                        </div>

                        <!-- Recordarme -->
                        <div class="form-check-wrapper mb-4">
                            <label class="custom-checkbox">
                                <input asp-for="RememberMe"
                                       type="checkbox"
                                       id="rememberMe" />
                                <span class="checkmark"></span>
                                <span class="checkbox-label">Recordarme por 7 días</span>
                            </label>
                        </div>

                        <!-- Botón Iniciar Sesión -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-login" id="loginButton">
                                <span class="button-text">
                                    <i class="fas fa-sign-in-alt"></i>Iniciar Sesión
                                </span>
                                <span class="button-loader">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        </div>
                    </form>

                    <!-- Separador -->
                    <div class="divider">
                        <span>Gestión de Mascotas</span>
                    </div>

                    <!-- Footer del Login -->
                    <div class="login-footer">
                        <div class="footer-icons">
                            <i class="fas fa-shield-alt"></i>
                            <i class="fas fa-heart"></i>
                            <i class="fas fa-dog"></i>
                        </div>
                        <p class="footer-text">
                            &copy; @DateTime.Now.Year PetsHome. Todos los derechos reservados.
                        </p>
                    </div>
                </div>

                <!-- Version Info -->
                <div class="version-info text-center mt-3">
                    <small>v1.0.0</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Toggle password visibility with smooth transition
            $('#togglePassword').on('click', function() {
                const passwordInput = $('#passwordInput');
                const toggleIcon = $('#toggleIcon');
                const button = $(this);

                button.addClass('toggling');

                setTimeout(() => {
                    if (passwordInput.attr('type') === 'password') {
                        passwordInput.attr('type', 'text');
                        toggleIcon.removeClass('fa-eye').addClass('fa-eye-slash');
                    } else {
                        passwordInput.attr('type', 'password');
                        toggleIcon.removeClass('fa-eye-slash').addClass('fa-eye');
                    }
                    button.removeClass('toggling');
                }, 150);
            });

            // Form submission with loading state
            $('#loginForm').on('submit', function() {
                const button = $('#loginButton');
                button.addClass('loading').prop('disabled', true);
            });

            // Input focus effects
            $('.modern-input').on('focus', function() {
                $(this).closest('.input-wrapper').addClass('focused');
            }).on('blur', function() {
                $(this).closest('.input-wrapper').removeClass('focused');
            });

            // Auto-focus en usuario al cargar con delay para animación
            setTimeout(() => {
                $('#Username').focus();
            }, 500);

            // Add floating label effect
            $('.modern-input').each(function() {
                if ($(this).val()) {
                    $(this).addClass('has-value');
                }
            }).on('input', function() {
                if ($(this).val()) {
                    $(this).addClass('has-value');
                } else {
                    $(this).removeClass('has-value');
                }
            });

            // Keyboard accessibility for checkbox
            $('#rememberMe').on('keypress', function(e) {
                if (e.which === 13 || e.which === 32) {
                    e.preventDefault();
                    $(this).prop('checked', !$(this).prop('checked'));
                }
            });

            // Shake animation on validation error
            @if (!ViewData.ModelState.IsValid)
            {
                <text>
                $('.login-card').addClass('shake');
                setTimeout(() => {
                    $('.login-card').removeClass('shake');
                }, 500);
                </text>
            }
        });
    </script>
}

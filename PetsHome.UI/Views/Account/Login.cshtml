@model PetsHome.Business.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Iniciar Sesión";
    ViewData["UseFormValidation"] = true;
}

@* Estilos del panel de acceso rápido (demo/portafolio) — locales a esta vista *@
<style>
    .demo-access {
        margin-top: .25rem;
        margin-bottom: 1.25rem;
    }

    .demo-access-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        font-weight: 600;
        font-size: .85rem;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: #6d28d9;
    }

    .demo-access-header i {
        color: #a855f7;
    }

    .demo-access-hint {
        text-align: center;
        font-size: .75rem;
        color: #8b8b9e;
        margin: .3rem 0 .9rem;
    }

    .demo-roles-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .55rem;
    }

    .demo-role-btn {
        display: flex;
        align-items: center;
        gap: .55rem;
        padding: .6rem .7rem;
        border: 1px solid rgba(124, 58, 237, .25);
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(124, 58, 237, .06), rgba(124, 58, 237, .02));
        color: #4c1d95;
        font-size: .82rem;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        transition: all .2s ease;
    }

        .demo-role-btn i {
            flex-shrink: 0;
            width: 1.2rem;
            font-size: 1rem;
            text-align: center;
            color: #7c3aed;
        }

        .demo-role-btn:hover {
            border-color: #7c3aed;
            background: linear-gradient(135deg, rgba(124, 58, 237, .16), rgba(124, 58, 237, .08));
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(124, 58, 237, .2);
        }

        .demo-role-btn:active {
            transform: translateY(0);
        }

        /* El 5º botón (impar) ocupa toda la fila y se centra */
        .demo-role-btn:last-child:nth-child(odd) {
            grid-column: 1 / -1;
            justify-content: center;
        }
</style>



<!-- ===================== PANEL IZQUIERDO (NUEVO) ===================== -->
<div class="left-panel">
    <div class="left-content">
        <div class="left-logo">
            <i class="fas fa-paw"></i>
            <div class="logo-shine"></div>
        </div>
        <div class="left-title">PetsHome</div>
        <div class="left-subtitle">Sistema de Gestión de Refugio</div>
        <div class="stats-row">
            <div class="stat"><div class="stat-num">248</div><div class="stat-lbl">Mascotas</div></div>
            <div class="stat"><div class="stat-num">84</div><div class="stat-lbl">Adoptadas</div></div>
            <div class="stat"><div class="stat-num">31</div><div class="stat-lbl">Voluntarios</div></div>
        </div>
    </div>
    <span class="left-version">v1.0.0</span>
</div>

<!-- ===================== TU HTML EXACTO (sin tocar) ===================== -->
<div class="login-container">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="login-card">

                    <!-- Logo y Título -->
                    <div class="text-center mb-4">
                        <div class="login-logo-wrapper">
                            <div class="login-logo">
                                <i class="fas fa-paw"></i>
                            </div>
                            <div class="logo-shine"></div>
                        </div>
                        <h1 class="login-title">PetsHome</h1>
                        <p class="login-subtitle">Sistema de Gestión de Refugio</p>
                    </div>

                    <!-- Formulario -->
                    <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" autocomplete="on">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-alert" role="alert"></div>

                        <!-- Campo Usuario -->
                        <div class="form-group mb-3">
                            <label asp-for="Username" class="form-label">
                                <i class="fas fa-user"></i> Usuario
                            </label>
                            <div class="input-wrapper" id="wrapUser">
                                <input asp-for="Username"
                                       class="form-control modern-input"
                                       placeholder="Ingrese su usuario"
                                       autocomplete="username"
                                       autofocus />
                                <div class="input-focus-border"></div>
                            </div>
                            <span asp-validation-for="Username" class="text-danger validation-message"></span>
                        </div>

                        <!-- Campo Contraseña -->
                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-lock"></i> Contraseña
                            </label>
                            <div class="input-wrapper" id="wrapPass">
                                <div class="password-input-group">
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control modern-input password-field"
                                           id="passwordInput"
                                           placeholder="Ingrese su contraseña"
                                           autocomplete="current-password" />
                                    <button class="password-toggle" type="button" id="togglePassword" tabindex="-1">
                                        <i class="fas fa-eye" id="toggleIcon"></i>
                                    </button>
                                </div>
                                <div class="input-focus-border"></div>
                            </div>
                            <span asp-validation-for="Password" class="text-danger validation-message"></span>
                        </div>

                        <!-- Recordarme -->
                        <div class="form-check-wrapper mb-4">
                            <label class="custom-checkbox">
                                <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                                <span class="checkmark"></span>
                                <span class="checkbox-label">Recordarme por 7 días</span>
                            </label>
                        </div>

                        <!-- Botón -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-login" id="loginButton">
                                <span class="button-text">
                                    <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                                </span>
                                <span class="button-loader">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                            </button>
                        </div>
                    </form>

                    <!-- Separador -->
                    <div class="divider"><span>Gestión de Mascotas</span></div>

                    @* Panel de acceso rápido solo para demo/portafolio *@
                    <div class="demo-access">
                        <div class="demo-access-header">
                            <i class="fas fa-bolt"></i>
                            <span>Acceso rápido (demo)</span>
                        </div>
                        <p class="demo-access-hint">Inicia sesión con un clic como cada rol</p>
                        <div class="demo-roles-grid">
                            <button type="button" class="demo-role-btn" data-user="admin" data-pass="admin123">
                                <i class="fas fa-shield-halved"></i>
                                <span>Administrador</span>
                            </button>
                            <button type="button" class="demo-role-btn" data-user="supervisor" data-pass="petshome123">
                                <i class="fas fa-user-tie"></i>
                                <span>Supervisor</span>
                            </button>
                            <button type="button" class="demo-role-btn" data-user="veterinario" data-pass="petshome123">
                                <i class="fas fa-user-doctor"></i>
                                <span>Veterinario</span>
                            </button>
                            <button type="button" class="demo-role-btn" data-user="cuidador" data-pass="petshome123">
                                <i class="fas fa-hand-holding-heart"></i>
                                <span>Cuidador</span>
                            </button>
                            <button type="button" class="demo-role-btn" data-user="recepcion" data-pass="petshome123">
                                <i class="fas fa-user"></i>
                                <span>Usuario Básico</span>
                            </button>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="login-footer">
                        <div class="footer-icons">
                            <i class="fas fa-shield-alt"></i>
                            <i class="fas fa-heart"></i>
                            <i class="fas fa-dog"></i>
                        </div>
                        <p class="footer-text">© 2026 PetsHome. Todos los derechos reservados.</p>
                    </div>
                </div>

                <!-- Version -->
                <div class="version-info text-center mt-3"><small>v1.0.0</small></div>
            </div>
        </div>
    </div>
</div>

<script>
    // Toggle password
    document.getElementById('togglePassword').addEventListener('click', function() {
        const inp = document.getElementById('passwordInput');
        const ico = document.getElementById('toggleIcon');
        this.classList.add('toggling');
        setTimeout(() => {
            inp.type = inp.type === 'password' ? 'text' : 'password';
            ico.className = inp.type === 'text' ? 'fas fa-eye-slash' : 'fas fa-eye';
            this.classList.remove('toggling');
        }, 150);
    });

    // Focus border
    document.querySelectorAll('.modern-input').forEach(inp => {
        const wrap = inp.closest('.input-wrapper');
        if (!wrap) return;
        inp.addEventListener('focus', () => wrap.classList.add('focused'));
        inp.addEventListener('blur',  () => wrap.classList.remove('focused'));
    });

    // Acceso rápido (demo/portafolio): rellena credenciales y envía el formulario,
    // reutilizando el POST de login y el antiforgery token existente del form.
    document.querySelectorAll('.demo-role-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const userInput = document.getElementById('Username')
                || document.querySelector('input[name="Username"]');
            const passInput = document.getElementById('passwordInput');
            if (userInput) userInput.value = this.dataset.user;
            if (passInput) passInput.value = this.dataset.pass;
            document.getElementById('loginForm').submit();
        });
    });
</script>
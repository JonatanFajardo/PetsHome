@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Acceso Denegado";
}

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Acceso Denegado</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/mi-slug.css" />
</head>
<body>

<div class="bg"></div>
<div class="orb orb1"></div>
<div class="orb orb2"></div>
<div class="orb orb3"></div>
<div class="grid-overlay"></div>

<!-- Floating paws -->
<div class="paws-bg" id="pawsBg"></div>

<div class="card">

  <!-- Lock icon with paw -->
  <div class="icon-wrap">
    <svg class="lock-svg" width="38" height="38" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Lock body -->
      <rect x="7" y="17" width="24" height="17" rx="4" fill="rgba(255,255,255,0.90)"/>
      <!-- Lock shackle -->
      <path d="M12 17V13C12 9.686 14.686 7 18 7h2C23.314 7 26 9.686 26 13v4" stroke="rgba(255,255,255,0.90)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
      <!-- Paw on lock -->
      <ellipse cx="19" cy="26" rx="3.5" ry="2.8" fill="rgba(107,127,212,0.9)"/>
      <ellipse cx="14.5" cy="23.5" rx="1.6" ry="1.9" fill="rgba(107,127,212,0.9)"/>
      <ellipse cx="19" cy="22" rx="1.6" ry="1.9" fill="rgba(107,127,212,0.9)"/>
      <ellipse cx="23.5" cy="23.5" rx="1.6" ry="1.9" fill="rgba(107,127,212,0.9)"/>
    </svg>
  </div>

  <div class="chip">
    <span class="chip-dot"></span>
    Acceso Denegado
  </div>

  <h1>Zona<br>Restringida</h1>

  <p class="subtitle">
    No cuentas con los permisos necesarios<br>para acceder a esta sección.<br>
    Si crees que es un error, <em>contacta al administrador.</em>
  </p>

  <div class="sep"></div>

  <div class="btn-group">
    <a href="/" class="btn btn-primary">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12L12 3l9 9"/><path d="M9 21V12h6v9"/>
      </svg>
      Volver al Inicio
    </a>
    <a href="/login" class="btn btn-secondary">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 3h6v18h-6"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
      </svg>
      Iniciar Sesión con otra cuenta
    </a>
  </div>

  <p class="hint">¿Necesitas ayuda? <a href="mailto:soporte@mascotas.com">Contáctanos</a></p>
</div>

<script>
  const bg = document.getElementById('pawsBg');
  for (let i = 0; i < 14; i++) {
    const el = document.createElement('div');
    el.className = 'fp';
    const size = 18 + Math.random() * 28;
    const dur  = 18 + Math.random() * 16;
    const del  = Math.random() * 20;
    const rot  = Math.random() * 360;
    const x    = Math.random() * 100;
    el.style.cssText = `left:${x}%;--r:${rot}deg;animation-duration:${dur}s;animation-delay:-${del}s;`;
    el.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 40 40" fill="none">
      <ellipse cx="20" cy="28" rx="10" ry="8" fill="rgba(255,255,255,0.25)"/>
      <ellipse cx="9"  cy="18" rx="4.5" ry="5.5" fill="rgba(255,255,255,0.25)"/>
      <ellipse cx="20" cy="13" rx="4.5" ry="5.5" fill="rgba(255,255,255,0.25)"/>
      <ellipse cx="31" cy="18" rx="4.5" ry="5.5" fill="rgba(255,255,255,0.25)"/>
    </svg>`;
    bg.appendChild(el);
  }
</script>
</body>
</html>
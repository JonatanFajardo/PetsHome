@model PetsHome.Business.Models.CambiarContrasenaViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-12 layout-spacing">
        <div class="statbox widget box box-shadow">
            <div class="widget-header">
                <div class="row">
                    <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                        <h4>Cambiar Contraseña</h4>
                    </div>
                </div>
            </div>
            <div class="widget-content widget-content-area-normal">
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="form-group">
                        <label asp-for="ContrasenaActual" class="form-label"></label>
                        <input asp-for="ContrasenaActual" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="ContrasenaActual" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="NuevaContrasena" class="form-label"></label>
                        <input asp-for="NuevaContrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
                        <small class="form-text text-muted">
                            La contraseña debe tener al menos 6 caracteres.
                        </small>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmarNuevaContrasena" class="form-label"></label>
                        <input asp-for="ConfirmarNuevaContrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarNuevaContrasena" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-2"></i>
                            Cambiar Contraseña
                        </button>
                        <a asp-action="Profile" class="btn btn-secondary ml-2">
                            <i class="fas fa-times mr-2"></i>
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-12">
        <div class="alert alert-warning">
            <h6><i class="fas fa-exclamation-triangle mr-2"></i>Importante</h6>
            <ul class="mb-0">
                <li>Después de cambiar tu contraseña, deberás iniciar sesión nuevamente</li>
                <li>Asegúrate de recordar tu nueva contraseña</li>
                <li>Usa una combinación de letras, números y símbolos</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
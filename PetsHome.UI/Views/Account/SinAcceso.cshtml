@{
    ViewData["Title"] = "Sin Acceso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card">
            <div class="card-body p-4">
                <div class="text-center w-75 m-auto">
                    <div class="mb-4">
                        <i class="fe fe-lock text-danger" style="font-size: 48px;"></i>
                    </div>
                    <h4 class="text-dark-50 text-center">Sin Acceso</h4>
                    <p class="text-muted mb-4">
                        No tienes permisos suficientes para acceder a esta pantalla.
                        Contacta al administrador del sistema si necesitas acceso.
                    </p>
                </div>

                <div class="text-center">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary waves-effect waves-light">
                        <i class="fe fe-home mr-1"></i>
                        Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .content-page {
        margin-left: 0 !important;
    }
    
    .topbar {
        display: none;
    }
    
    .left.side-menu {
        display: none;
    }
    
    body {
        background-color: #f8f9fa;
    }
</style>
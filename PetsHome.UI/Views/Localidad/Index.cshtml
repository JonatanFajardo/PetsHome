@{
    ViewData["Title"] = "Departamentos de Honduras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/departamento-cards.css" />
}

<div class="col-12">
    <div class="pets-container">
    <!-- Header purpura con todos los controles -->
    <div class="pets-header-full">
        <div class="pets-header-content">
            <div class="pets-title-section">
                <h2 class="text-white"><i class="fas fa-map-marked-alt mr-2 text-white"></i>Departamentos de Colombia</h2>
                <p class="text-white-50 mb-0">Explora la informacion de <span id="departamentosCount">0</span> departamentos</p>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("FormPartialDepartamento")'">
                    <i class="fas fa-plus mr-2"></i>Nuevo Departamento
                </button>
            </div>

            <div class="pets-controls">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="globalSearch" placeholder="Buscar por nombre, codigo o capital...">
                </div>
                <div class="action-buttons">
                    <button class="btn-control" id="filterBtn" onclick="toggleFilters()">
                        <i class="fas fa-filter"></i><span>Filtros</span>
                    </button>
                    <div class="dropdown d-inline-block">
                        <button class="btn-control dropdown-toggle" type="button" id="sortDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-sort"></i><span id="sortLabel">Nombre (A-Z)</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="sortDropdown">
                            <a class="dropdown-item" href="#" onclick="sortData('name-asc')">Nombre (A-Z)</a>
                            <a class="dropdown-item" href="#" onclick="sortData('name-desc')">Nombre (Z-A)</a>
                            <a class="dropdown-item" href="#" onclick="sortData('population-desc')">Poblacion (Mayor a menor)</a>
                            <a class="dropdown-item" href="#" onclick="sortData('population-asc')">Poblacion (Menor a mayor)</a>
                            <a class="dropdown-item" href="#" onclick="sortData('area-desc')">Area (Mayor a menor)</a>
                            <a class="dropdown-item" href="#" onclick="sortData('area-asc')">Area (Menor a mayor)</a>
                        </div>
                    </div>
                    <div class="view-toggle">
                        <button class="btn-control" id="tableViewBtn" onclick="toggleView('table')">
                            <i class="fas fa-table"></i><span>Tabla</span>
                        </button>
                        <button class="btn-control active" id="gridViewBtn" onclick="toggleView('grid')">
                            <i class="fas fa-th"></i><span>Tarjetas</span>
                        </button>
                    </div>
                   
                    <button class="btn-export-datatable" onclick="location.reload()">
                        Recargar
                    </button>
                    <div id="export-buttons-container" class="export-buttons-container">
                        <!-- Los botones de DataTable se moveran aqui -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Vista de Tarjetas (Grid View - por defecto) -->
        <div  class="pets-card-container">
        <div class="row" id="departamentosGrid">
            <!-- Las tarjetas se generaran dinamicamente -->
        </div>
    </div>

    <!-- Template para las cards de departamento -->
    <template id="department-card-template">
        <div class="col-sm-6 col-md-4 col-lg-4 mb-4">
            <div class="department-card">
                    <div class="card-header bg-white">
                    <div class="card-title-wrapper">
                        <div class="card-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                <line x1="9" y1="10" x2="15" y2="10"></line>
                            </svg>
                        </div>
                        <div>
                            <h3 class="card-title" data-field="name"></h3>
                            <div class="card-code" data-field="code"></div>
                        </div>
                    </div>
                    <svg class="card-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>

                <div class="card-info ">
                    <div class="card-info-item">
                        <svg class="card-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <div class="card-info-content">
                            <p class="card-info-label">Capital</p>
                            <p class="card-info-value" data-field="capital"></p>
                        </div>
                    </div>

                    <div class="card-info-item">
                        <svg class="card-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <div class="card-info-content">
                            <p class="card-info-label">Población</p>
                            <p class="card-info-value" data-field="population"></p>
                        </div>
                    </div>

                        <div class="card-footer bg-white">
                        <span data-field="municipalities"></span>
                        <span data-field="area"></span>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Vista de Tabla (oculta por defecto) -->
    <div id="tableView" class="pets-table-container" style="display: none;">
        <table class="pets-table" id="datatable">
            <thead>
                <tr>
                    <th width="80">ID</th>
                    <th width="100">Codigo</th>
                    <th>Departamento</th>
                    <th>Capital</th>
                    <th width="120">Poblacion</th>
                    <th width="120">Area (km²)</th>
                    <th width="100">Municipios</th>
                    <th width="150" class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTable cargara los datos aqui -->
            </tbody>
        </table>
    </div>

    <!-- Modal Delete -->
    <div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Confirmar Eliminacion
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Remove" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" name="depto_Id" id="delete-item-id">
                    <div class="modal-body text-center py-4">
                        <div class="mb-3">
                            <i class="fas fa-trash-alt text-danger" style="font-size: 48px;"></i>
                        </div>
                        <h5>Esta seguro de eliminar este registro?</h5>
                        <p class="text-muted">Esta accion no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">
                            <i class="fas fa-times mr-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash mr-2"></i>Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="~/js/pages/localidad.js"></script>
    <script>
        $(document).ready(function() {
            Localidad.init({
                urlList: "@Url.Action("List")",
                urlDetail: "@Url.Action("DetailDepartamento")",
                urlInsert: "@Url.Action("FormDepartamentos")",
                urlUpdate: "@Url.Action("FormPartialDepartamento")"
            });
        });

        // Funciones globales para los onclick en el HTML
        function viewDepartamento(id) {
            Localidad.viewDepartamento(id);
        }

        function editDepartamento(id) {
            Localidad.editDepartamento(id);
        }

        function deleteDepartamento(id) {
            Localidad.deleteDepartamento(id);
        }

        function toggleView(view) {
            Localidad.toggleView(view);
        }

        function sortData(sortType) {
            Localidad.sortData(sortType);
        }

        function toggleFilters() {
            Localidad.toggleFilters();
        }
    </script>
}
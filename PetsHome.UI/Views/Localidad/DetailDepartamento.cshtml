@model DepartamentoDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Departamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
    <link rel="stylesheet" href="~/css/detail-styles.css" />
}

<div class="col-12">
    <div class="detail-container">
        <!-- Header con gradiente y información principal -->
        <div class="detail-header">
            <div class="detail-header-content">
                <div class="profile-section">
                    <div class="profile-photo-container">
                        <div class="profile-photo-placeholder">
                            <i class="fas fa-map-marked-alt"></i>
                        </div>
                        <div class="profile-badge">#@Model.depto_Id.ToString().PadLeft(3, '0')</div>
                    </div>

                    <div class="profile-info">
                        <h1>@Model.depto_Descripcion</h1>
                        <div class="profile-subtitle">
                            <i class="fas fa-map"></i>
                            <span>Departamento</span>
                        </div>
                        <div class="profile-meta">
                            <div class="profile-meta-item">
                                <i class="fas fa-code"></i>
                                <span>Código: @Model.depto_Codigo</span>
                            </div>
                            <div class="profile-meta-item">
                                <i class="fas fa-city"></i>
                                <span>Capital: @(Model.depto_Capital ?? "N/A")</span>
                            </div>
                            <div class="profile-meta-item">
                                <i class="fas fa-building"></i>
                                @{
                                    var municipiosCount = Model.ListadoMunicipios?.Count() ?? 0;
                                }
                                <span>@municipiosCount municipio@(municipiosCount != 1 ? "s" : "")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="detail-actions">
                    <a href="@Url.Action("FormDepartamentos", new { id = Model.depto_Id })" class="btn-detail btn-detail-white">
                        <i class="fas fa-edit"></i>
                        <span>Editar</span>
                    </a>
                    <a href="@Url.Action("Index")" class="btn-detail btn-detail-outline">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Contenido principal -->
        <div class="detail-content">
            <div class="detail-grid">

                <!-- Información General -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-info-circle"></i>
                        <h3>Información General</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-code"></i>
                                    <span>Código</span>
                                </div>
                                <div class="detail-value detail-value-large">@Model.depto_Codigo</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-map-marked-alt"></i>
                                    <span>Descripción</span>
                                </div>
                                <div class="detail-value">@Model.depto_Descripcion</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-city"></i>
                                    <span>Capital</span>
                                </div>
                                <div class="detail-value">@(Model.depto_Capital ?? "N/A")</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-users"></i>
                                    <span>Población</span>
                                </div>
                                <div class="detail-value">@(Model.depto_Poblacion != null ? Model.depto_Poblacion.Value.ToString("N0") : "N/A")</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-expand-arrows-alt"></i>
                                    <span>Área (km²)</span>
                                </div>
                                <div class="detail-value">@(Model.depto_AreaKm2 != null ? Model.depto_AreaKm2.Value.ToString("N2") + " km²" : "N/A")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información de Auditoría -->
                <div class="detail-card detail-card-half">
                    <div class="detail-card-header">
                        <i class="fas fa-clock"></i>
                        <h3>Información de Registro</h3>
                    </div>
                    <div class="detail-card-body">
                        <div class="detail-list">
                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-user-plus"></i>
                                    <span>Creado por</span>
                                </div>
                                <div class="detail-value">@(Model.UsuarioCreacion ?? "Sistema")</div>
                            </div>

                            <div class="detail-item">
                                <div class="detail-label">
                                    <i class="fas fa-calendar-plus"></i>
                                    <span>Fecha de creación</span>
                                </div>
                                <div class="detail-value">@(Model.depto_FechaCrea != null ? ((DateTime)Model.depto_FechaCrea).ToString("dd/MM/yyyy hh:mm tt") : "N/A")</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.UsuarioModificacion))
                            {
                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-user-edit"></i>
                                        <span>Modificado por</span>
                                    </div>
                                    <div class="detail-value">@Model.UsuarioModificacion</div>
                                </div>

                                <div class="detail-item">
                                    <div class="detail-label">
                                        <i class="fas fa-calendar-check"></i>
                                        <span>Última modificación</span>
                                    </div>
                                    <div class="detail-value">@(Model.depto_FechaModifica != null ? ((DateTime)Model.depto_FechaModifica).ToString("dd/MM/yyyy hh:mm tt") : "N/A")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Municipios Asociados -->
                <div class="detail-card detail-card-full">
                    <div class="detail-card-header">
                        <i class="fas fa-building"></i>
                        <h3>Municipios Asociados</h3>
                    </div>
                    <div class="detail-card-body">
                        @if (Model.ListadoMunicipios != null && Model.ListadoMunicipios.Any())
                        {
                            <div class="table-responsive">
                                <table class="detail-table dt-responsive nowrap" id="municipio-detalle">
                                    <thead class="text-center">
                                        <tr>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th>Usuario Creación</th>
                                            <th>Fecha Creación</th>
                                            <th>Usuario Modificación</th>
                                            <th>Fecha Modificación</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ListadoMunicipios)
                                        {
                                            <tr>
                                                <td>@item.mpio_Codigo</td>
                                                <td>@item.mpio_Descripcion</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.UsuarioCreacion) ? "N/A" : item.UsuarioCreacion)</td>
                                                <td>@(item.mpio_FechaCrea != null ? ((DateTime)item.mpio_FechaCrea).ToString("dd/MM/yyyy") : "N/A")</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.UsuarioModificacion) ? "N/A" : item.UsuarioModificacion)</td>
                                                <td>@(item.mpio_FechaModifica != null ? ((DateTime)item.mpio_FechaModifica).ToString("dd/MM/yyyy") : "N/A")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-detail">
                                <i class="fas fa-building"></i>
                                <h4>No hay municipios registrados</h4>
                                <p>Este departamento no tiene municipios asociados</p>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/pages/list-municipiosdetails.js"></script>
}

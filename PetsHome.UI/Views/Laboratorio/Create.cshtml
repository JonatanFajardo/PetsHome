@model LaboratorioFormViewModel
@{
    ViewData["Title"] = Model.isEdit ? "Editar examen" : "Nuevo examen";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["UseFormValidation"] = true;
    ViewData["CurrentPantalla"] = "Listado de laboratorio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modern-form-styles.css" />
    <link rel="stylesheet" href="~/css/modern-table-styles.css" />
}

<div class="col-12">
    <div class="pets-container">

        <div class="pets-header-full">
            <breadcrumb></breadcrumb>
            <div class="pets-header-content">
                <div class="pets-title-section">
                    <h2 class="text-white">
                        <i class="fas fa-flask mr-2 text-white"></i>@(Model.isEdit ? "Editar examen de laboratorio" : "Solicitud de examen de laboratorio")
                    </h2>
                    <button class="btn-nueva-mascota" onclick="window.location.href='@Url.Action("Index")'">
                        <i class="fas fa-arrow-left mr-2"></i>Volver al Listado
                    </button>
                </div>
                <p class="text-white mb-0 mt-2" style="opacity:0.9;">
                    @(Model.isEdit ? "Actualice los datos del examen" : "Registre el examen; los resultados se cargan después desde el detalle")
                </p>
            </div>
        </div>

        <div class="pets-body-full">
            <div class="container-fluid">
                <form asp-action="Add" asp-controller="Laboratorio" method="post" autocomplete="off" id="labForm">
                    <input asp-for="lab_Id" type="hidden" />
                    <input asp-for="cita_Id" type="hidden" />
                    <input asp-for="lab_Veterinario" type="hidden" />

                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title">Datos del examen</h2>
                            <p class="card-description">Mascota, tipo y nombre del examen solicitado</p>
                        </div>
                        <div class="card-content">
                            <div class="form-grid">

                                <div class="form-group">
                                    <label asp-for="masc_Id">Mascota <span class="required">*</span></label>
                                    <select class="form-control" asp-for="masc_Id">
                                        <option value="">-- Seleccione --</option>
                                        @foreach (var m in Model.MascotaList)
                                        {
                                            <option value="@m.masc_Id">@m.masc_Nombre</option>
                                        }
                                    </select>
                                    <span class="text-danger" asp-validation-for="masc_Id"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="lab_Tipo">Tipo de examen <span class="required">*</span></label>
                                    <select class="form-control" asp-for="lab_Tipo" asp-items="Model.TipoList">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                    <span class="text-danger" asp-validation-for="lab_Tipo"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="lab_Examen">Examen <span class="required">*</span></label>
                                    <input class="form-control" asp-for="lab_Examen" type="text" placeholder="Ej: Hemograma completo" />
                                    <span class="text-danger" asp-validation-for="lab_Examen"></span>
                                </div>

                                <div class="form-group" style="grid-column:1 / -1;">
                                    <label asp-for="lab_Observaciones">Observaciones</label>
                                    <textarea class="form-control" asp-for="lab_Observaciones" rows="3" placeholder="Notas, motivo del examen, etc."></textarea>
                                    <span class="text-danger" asp-validation-for="lab_Observaciones"></span>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a class="btn btn-outline" asp-action="Index">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="mdi mdi-content-save"></i> @(Model.isEdit ? "Actualizar" : "Guardar")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(function () {
            $("#labForm").validate({
                rules: {
                    masc_Id: { required: true },
                    lab_Tipo: { required: true },
                    lab_Examen: { required: true }
                }
            });
        });
    </script>
}

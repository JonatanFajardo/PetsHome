@model SalidaViewModel
@{
    ViewData["Title"] = "Salidas de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container">
    @* Listado *@
    <div class="card">
        <div class="card-header">
            <h3>Listado de Salidas de Inventario</h3>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped dt-responsive nowrap" id="datatable">
                    <thead class="text-center bg-danger text-white">
                        <tr>
                            <th>Id</th>
                            <th>Fecha</th>
                            <th>Tipo Salida</th>
                            <th>Número Documento</th>
                            <th>Refugio</th>
                            <th>Usuario Creación</th>
                            <th>Fecha Creación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Delete-->
    <div class="modal" id="delete-modal" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Eliminar Salida</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" hidden>
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-action="Delete" method="post" autocomplete="off"
                      data-ajax-begin="Catalogs.begin"
                      data-ajax-success="Catalogs.success"
                      data-ajax-failure="Catalogs.failure"
                      data-ajax-complete="Catalogs.complete">
                    <input type="hidden" asp-for="sal_Id" id="delete-item-id">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <p>¿Está seguro de que desea eliminar esta salida de inventario?</p>
                                    <div class="alert alert-warning">
                                        <strong>Advertencia:</strong> Esta acción no revertirá automáticamente el stock. 
                                        Deberá realizar los ajustes de inventario correspondientes.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <input type="submit" class="btn btn-danger" value="Eliminar" />
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Fin Modal -->
</div>
@section Scripts {
<script src="~/js/pages/salida.js"></script>
<script>
    Salida.datatable({
        urlList: "@Url.Action("List")",
        urlDetail: "@Url.Action("Detail")",
        urlInsert: "@Url.Action("Create")",
        urlUpdate: "@Url.Action("Create")"
    });
</script>
}
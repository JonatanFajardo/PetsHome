@model SalidaViewModel
<!-- Card-->
<div class="card">
    <div class="card-header">
        @if (Model.sal_Id == 0)
        {
            <h3>Agregar salida de inventario</h3>
        }
        else
        {
            <h3>Editar salida de inventario</h3>
        }
    </div>

    <div class="card-body">
        <form asp-controller="Salida" asp-action="Add" class="col-md-10" autocomplete="off">
            <input class="form-control" asp-for="sal_Id" type="hidden" />
            <input type="hidden" asp-for="isEdit" value="@(Model.sal_Id > 0)" />
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="sal_Fecha" class="control-label required">Fecha</label>
                        <input asp-for="sal_Fecha" class="form-control" type="date" required />
                        <span asp-validation-for="sal_Fecha" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="sal_TipoSalida" class="control-label required">Tipo de Salida</label>
                        <select asp-for="sal_TipoSalida" asp-items="Model.tipoSalidaList" class="form-control" required>
                            <option value="">-- Seleccionar Tipo --</option>
                        </select>
                        <span asp-validation-for="sal_TipoSalida" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="sal_NumeroDocumento" class="control-label">Número de Documento</label>
                        <input asp-for="sal_NumeroDocumento" class="form-control" placeholder="Ej: Vale #001234" />
                        <span asp-validation-for="sal_NumeroDocumento" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="refg_Id" class="control-label required">Refugio</label>
                        <select asp-for="refg_Id" asp-items="Model.refugioList" class="form-control" required>
                            <option value="">-- Seleccionar Refugio --</option>
                        </select>
                        <span asp-validation-for="refg_Id" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="sal_DestinoId" class="control-label">ID Destino</label>
                        <input asp-for="sal_DestinoId" class="form-control" type="number" placeholder="ID del área o destino" />
                        <span asp-validation-for="sal_DestinoId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="sal_Descripcion" class="control-label required">Descripción</label>
                        <textarea asp-for="sal_Descripcion" class="form-control" rows="3" placeholder="Descripción detallada de la salida" required></textarea>
                        <span asp-validation-for="sal_Descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <br />
            <div class="row">
                <div class="col-md-12">
                    @if (Model.sal_Id == 0)
                    {
                        <button type="submit" class="btn btn-danger"><i class="mdi mdi-content-save"></i> Guardar</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger"><i class="mdi mdi-content-save"></i> Guardar cambios</button>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                    @if (Model.sal_Id > 0)
                    {
                        <a asp-action="Detail" asp-route-id="@Model.sal_Id" class="btn btn-info">Ver Detalle</a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/salida.js"></script>
}